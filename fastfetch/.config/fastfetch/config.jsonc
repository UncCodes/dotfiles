// fui // FASTFETCH: the portfolio terminal's `whoami`, on the CRT palette
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "endeavouros_small",
    "color": { "1": "magenta", "2": "blue", "3": "red" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "green", "title": "green" },
    "key": { "width": 9 }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}", "color": { "user": "green", "at": "white", "host": "green" } },
    { "type": "custom", "format": "\u001b[90m[0x00] whoami ─────────────────" },
    { "type": "os",       "key": "os" },
    { "type": "kernel",   "key": "kernel" },
    { "type": "wm",       "key": "wm" },
    { "type": "shell",    "key": "shell" },
    { "type": "terminal", "key": "term" },
    { "type": "cpu",      "key": "cpu", "showPeCoreCount": false },
    { "type": "gpu",      "key": "gpu" },
    { "type": "memory",   "key": "memory" },
    { "type": "disk",     "key": "disk", "folders": "/" },
    { "type": "uptime",   "key": "uptime" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
