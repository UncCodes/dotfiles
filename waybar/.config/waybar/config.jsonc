// fui // WAYBAR: the desktop menubar strip
// After aljulandani.dev's menubar: the @user wordmark and white nav buttons on the left,
// the window's path in the middle, a system tray of plain readouts and an LCD clock on
// the right. Colours come from style.css (through fui-colors.css, one file per theme);
// labels only dim with alpha, so they suit every theme. `fui bar` starts this file, or
// config-compact.jsonc on screens narrower than 1400 px.
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 0,

  "modules-left":   ["custom/wordmark", "hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right":  ["custom/rec", "mpris", "custom/updates", "cpu", "memory", "network", "pulseaudio",
                     "hyprland/language", "custom/sound", "custom/mode", "custom/notify", "tray", "clock", "custom/power"],

  // @user in Michroma, the accent colour: the site's wordmark
  "custom/wordmark": {
    "exec": "echo \"@$USER\"",
    "interval": "once",
    "tooltip": false,
    "on-click": "~/.local/bin/fui palette"
  },

  // the white nav buttons: lowercase paths, the current one filled and blinking
  "hyprland/workspaces": {
    "format": "/{name}",
    "persistent-workspaces": { "*": 4 },
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },

  // the breadcrumb path: /app / window title
  "hyprland/window": {
    "format": "/{class} <span alpha='55%'>/</span> {title}",
    "max-length": 64,
    "separate-outputs": true,
    "rewrite": { "^/ <span alpha='55%'>/</span> $": "/desktop" }
  },

  "custom/rec": {
    "exec": "~/.local/bin/fui record status",
    "interval": 2,
    "return-type": "json",
    "on-click": "~/.local/bin/fui record stop"
  },

  "mpris": {
    "format": "<span alpha='55%' size='small' letter_spacing='2048'>PLAY</span> {title}",
    "format-paused": "<span alpha='55%' size='small' letter_spacing='2048'>PAUSE</span> {title}",
    "max-length": 32,
    "on-click": "playerctl play-pause"
  },

  "custom/updates": {
    "exec": "~/.local/bin/fui updates --bar",
    "interval": 3600,
    "return-type": "json",
    "on-click": "~/.local/bin/fui tui fui update"
  },

  "cpu": {
    "format": "<span alpha='55%' size='small' letter_spacing='2048'>CPU</span> {usage:02}%",
    "interval": 2,
    "states": { "warning": 70, "critical": 90 },
    "on-click": "~/.local/bin/fui tui btop"
  },

  "memory": {
    "format": "<span alpha='55%' size='small' letter_spacing='2048'>MEM</span> {percentage:02}%",
    "interval": 4,
    "states": { "warning": 75, "critical": 90 },
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
    "on-click": "~/.local/bin/fui tui btop"
  },

  "network": {
    "format-ethernet": "<span alpha='55%' size='small' letter_spacing='2048'>NET</span> eth",
    "format-wifi": "<span alpha='55%' size='small' letter_spacing='2048'>NET</span> {signalStrength}%",
    "format-disconnected": "<span alpha='55%' size='small' letter_spacing='2048'>NET</span> offline",
    "tooltip-format": "{essid} {ifname}  {ipaddr}/{cidr}\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}",
    "interval": 5,
    "on-click": "~/.local/bin/fui tui nmtui",
    "on-click-right": "nm-connection-editor"
  },

  "pulseaudio": {
    "format": "<span alpha='55%' size='small' letter_spacing='2048'>VOL</span> {volume:02}%",
    "format-muted": "<span alpha='55%' size='small' letter_spacing='2048'>VOL</span> mute",
    "on-click": "~/.local/bin/fui tui wiremix",
    "on-click-middle": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },

  "hyprland/language": {
    "format": "<span alpha='55%' size='small' letter_spacing='2048'>KBD</span> {short}"
  },

  // interface sounds on / off (the site's speaker button)
  "custom/sound": {
    "exec": "~/.local/bin/fui sound status --bar",
    "interval": "once",
    "signal": 9,
    "on-click": "~/.local/bin/fui sound toggle",
    "tooltip": false
  },

  // the theme: sun / sunset / moon and its name; click cycles dark → mid → light
  "custom/mode": {
    "exec": "~/.local/bin/fui mode status --bar",
    "interval": "once",
    "signal": 8,
    "on-click": "~/.local/bin/fui mode toggle",
    "tooltip": false
  },

  // notification centre: the count, or a struck bell when do-not-disturb is on
  "custom/notify": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon} {}",
    "format-icons": { "notification": "󰂚", "none": "󰂜", "dnd-notification": "󰂛", "dnd-none": "󰂛",
                      "inhibited-notification": "󰂚", "inhibited-none": "󰂜", "dnd-inhibited-notification": "󰂛", "dnd-inhibited-none": "󰂛" },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "tray": {
    "icon-size": 14,
    "spacing": 8
  },

  // the LCD clock: seven-segment digits on grey-green glass
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%d.%m.%y  %H:%M:%S}",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<b>{}</b>",
        "weekdays": "<span alpha='55%'>{}</span>",
        "today": "<span underline='single'><b>{}</b></span>"
      }
    }
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.local/bin/fui power"
  }
}
