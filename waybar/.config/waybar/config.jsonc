// HUD // WAYBAR
// Every reading carries a word, so state is never colour alone.
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-top": 8,
  "margin-left": 14,
  "margin-right": 14,
  "spacing": 0,

  "modules-left":   ["custom/tag", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right":  ["cpu", "memory", "temperature", "network", "pulseaudio", "hyprland/language", "tray"],

  "custom/tag": {
    "format": "⌖",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "01", "2": "02", "3": "03", "4": "04", "5": "05",
      "6": "06", "7": "07", "8": "08", "9": "09", "default": "{name}"
    },
    "persistent-workspaces": { "*": 5 },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  "hyprland/window": {
    "format": "// {}",
    "max-length": 48,
    "separate-outputs": true,
    "rewrite": { "": "// DESKTOP" }
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b %Y  %H:%M:%S}",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#8FD3DC'><b>{}</b></span>",
        "weekdays": "<span color='#7D8A8F'>{}</span>",
        "today": "<span color='#C99A4E'><b>{}</b></span>"
      }
    }
  },

  "cpu": {
    "format": "<span color='#7D8A8F' size='small' letter_spacing='2048'>CPU</span> {usage:02}%",
    "interval": 2,
    "states": { "warning": 70, "critical": 90 }
  },

  "memory": {
    "format": "<span color='#7D8A8F' size='small' letter_spacing='2048'>MEM</span> {percentage:02}%",
    "interval": 4,
    "states": { "warning": 75, "critical": 90 },
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
  },

  "temperature": {
    // If this shows the wrong sensor, set "hwmon-path" to your CPU's
    // /sys/class/hwmon/hwmonN/temp1_input (see `sensors`).
    "format": "<span color='#7D8A8F' size='small' letter_spacing='2048'>TMP</span> {temperatureC}°",
    "critical-threshold": 85
  },

  "network": {
    "format-ethernet": "<span color='#7D8A8F' size='small' letter_spacing='2048'>NET</span> ETH",
    "format-wifi": "<span color='#7D8A8F' size='small' letter_spacing='2048'>NET</span> {essid} {signalStrength}%",
    "format-disconnected": "<span color='#7D8A8F' size='small' letter_spacing='2048'>NET</span> OFFLINE",
    "tooltip-format": "{ifname}  {ipaddr}/{cidr}\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}",
    "interval": 5,
    "on-click": "nm-connection-editor"
  },

  "pulseaudio": {
    "format": "<span color='#7D8A8F' size='small' letter_spacing='2048'>VOL</span> {volume:02}%",
    "format-muted": "<span color='#7D8A8F' size='small' letter_spacing='2048'>VOL</span> MUTE",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },

  "hyprland/language": {
    "format": "<span color='#7D8A8F' size='small' letter_spacing='2048'>KBD</span> {short}"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 8
  }
}
