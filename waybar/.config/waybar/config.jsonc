// fui // WAYBAR: the status rail
// The institution's badge, index segments for the workspaces (the current one underlined in
// the signal), the focused window, labelled readouts with segment meters, and the clock.
// Colours come from style.css (roles, one file per edition); labels only dim with alpha, so
// they suit every edition. `fui bar` starts this file, or config-compact.jsonc on screens
// narrower than 1400 px, through a small file that sets the margins for the display tier.
{
  "include": ["~/.config/waybar/meters.jsonc"],
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 0,

  "modules-left":   ["custom/brand", "hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right":  ["custom/rec", "mpris", "custom/updates", "cpu", "memory", "network", "pulseaudio", "battery",
                     "hyprland/language", "custom/sound", "custom/mode", "custom/notify", "tray", "clock", "custom/power"],

  // the badge: the institution in the brand voice; click for the command palette
  "custom/brand": {
    "exec": "~/.local/bin/fui brand --bar",
    "interval": "once",
    "tooltip": false,
    "on-click": "~/.local/bin/fui palette"
  },

  // workspace index segments: 01 02 03 ..., the current one underlined in the signal
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": { "1": "01", "2": "02", "3": "03", "4": "04", "5": "05", "6": "06", "7": "07", "8": "08", "9": "09", "default": "{name}" },
    "persistent-workspaces": { "*": 4 },
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },

  // the focused window: its app in tracked capitals, then its title
  "hyprland/window": {
    "format": "<span alpha='60%' size='small' letter_spacing='1600'>{class}</span>  {title}",
    "max-length": 70,
    "separate-outputs": true
  },

  "custom/rec": {
    "exec": "~/.local/bin/fui record status",
    "interval": 2,
    "return-type": "json",
    "on-click": "~/.local/bin/fui record stop"
  },

  "mpris": {
    "format": "<span alpha='60%' size='small' letter_spacing='1600'>PLAY</span> {title}",
    "format-paused": "<span alpha='60%' size='small' letter_spacing='1600'>PAUSE</span> {title}",
    "max-length": 32,
    "on-click": "playerctl play-pause"
  },

  "custom/updates": {
    "exec": "~/.local/bin/fui updates --bar",
    "interval": 3600,
    "return-type": "json",
    "on-click": "~/.local/bin/fui tui fui update"
  },

  "cpu": {
    "format": "<span alpha='60%' size='small' letter_spacing='1600'>CPU</span> {usage:02}%",
    "interval": 2,
    "states": { "warning": 70, "critical": 90 },
    "format-warning": "<span alpha='60%' size='small' letter_spacing='1600'>CPU WARN</span> {usage:02}%",
    "format-critical": "<span alpha='60%' size='small' letter_spacing='1600'>CPU HIGH</span> {usage:02}%",
    "on-click": "~/.local/bin/fui tui btop"
  },

  "memory": {
    "format": "<span alpha='60%' size='small' letter_spacing='1600'>MEM</span> {percentage:02}%",
    "interval": 4,
    "states": { "warning": 75, "critical": 90 },
    "format-warning": "<span alpha='60%' size='small' letter_spacing='1600'>MEM WARN</span> {percentage:02}%",
    "format-critical": "<span alpha='60%' size='small' letter_spacing='1600'>MEM HIGH</span> {percentage:02}%",
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
    "on-click": "~/.local/bin/fui tui btop"
  },

  "network": {
    "format-ethernet": "<span alpha='60%' size='small' letter_spacing='1600'>NET</span> ETH",
    "format-wifi": "<span alpha='60%' size='small' letter_spacing='1600'>NET</span> {signalStrength:02}%",
    "format-disconnected": "<span alpha='60%' size='small' letter_spacing='1600'>NET</span> OFFLINE",
    "tooltip-format": "{essid} {ifname}  {ipaddr}/{cidr}\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}",
    "interval": 5,
    "on-click": "~/.local/bin/fui tui nmtui",
    "on-click-right": "nm-connection-editor"
  },

  // a segment meter (meters.jsonc: rounded down, never more than the true value) and the number
  "pulseaudio": {
    "format": "<span alpha='60%' size='small' letter_spacing='1600'>VOL</span> {icon} {volume:02}%",
    "format-muted": "<span alpha='60%' size='small' letter_spacing='1600'>VOL</span> ▯▯▯▯▯ MUTE",
    "on-click": "~/.local/bin/fui tui wiremix",
    "on-click-middle": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },

  // shown only where there is a battery; WARN and LOW are words, not just a colour
  "battery": {
    "format": "<span alpha='60%' size='small' letter_spacing='1600'>BAT</span> {icon} {capacity:02}%",
    "format-charging": "<span alpha='60%' size='small' letter_spacing='1600'>BAT</span> {icon} {capacity:02}% CHG",
    "format-warning": "<span alpha='60%' size='small' letter_spacing='1600'>BAT WARN</span> {icon} {capacity:02}%",
    "format-critical": "<span alpha='60%' size='small' letter_spacing='1600'>BAT LOW</span> {icon} {capacity:02}%",
    "states": { "warning": 20, "critical": 10 },
    "tooltip-format": "{timeTo} · {power:.1f} W",
    "interval": 30
  },

  "hyprland/language": {
    "format": "<span alpha='60%' size='small' letter_spacing='1600'>KBD</span> {short}"
  },

  // interface sounds on / off
  "custom/sound": {
    "exec": "~/.local/bin/fui sound status --bar",
    "interval": "once",
    "signal": 9,
    "on-click": "~/.local/bin/fui sound toggle",
    "tooltip": false
  },

  // the edition and the display tier; click cycles the editions
  "custom/mode": {
    "exec": "~/.local/bin/fui mode status --bar",
    "interval": "once",
    "signal": 8,
    "on-click": "~/.local/bin/fui mode toggle",
    "tooltip": false
  },

  // notification centre: the count, or a struck bell when do-not-disturb is on
  "custom/notify": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "<span alpha='60%' size='small' letter_spacing='1600'>MSG</span> {}",
    "format-icons": { "notification": "󰂚", "none": "󰂜", "dnd-notification": "󰂛", "dnd-none": "󰂛",
                      "inhibited-notification": "󰂚", "inhibited-none": "󰂜", "dnd-inhibited-notification": "󰂛", "dnd-inhibited-none": "󰂛" },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": false
  },

  "tray": {
    "icon-size": 14,
    "spacing": 8
  },

  // the clock in the brand voice, the date small beside it (24-hour; ISO in the alternate view)
  "clock": {
    "format": "{:%H:%M  <span alpha='60%%' size='small' letter_spacing='1600'>%a %d %b</span>}",
    "format-alt": "{:%H:%M:%S  <span alpha='60%%' size='small' letter_spacing='1600'>%Y-%m-%d</span>}",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<b>{}</b>",
        "weekdays": "<span alpha='55%'>{}</span>",
        "today": "<span underline='single'><b>{}</b></span>"
      }
    }
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.local/bin/fui power"
  }
}
