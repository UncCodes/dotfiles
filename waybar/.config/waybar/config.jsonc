// fui // WAYBAR: the status rail
// A company workstation's rail: the brand badge, numbered workspace segments (the current
// one underlined in the accent), the focused window, labelled telemetry and the clock.
// Colours come from style.css (through fui-colors.css, one file per theme); labels only
// dim with alpha, so they suit every theme. `fui bar` starts this file, or
// config-compact.jsonc on screens narrower than 1400 px.
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 0,

  "modules-left":   ["custom/brand", "hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right":  ["custom/rec", "mpris", "custom/updates", "cpu", "memory", "network", "pulseaudio",
                     "hyprland/language", "custom/sound", "custom/mode", "custom/notify", "tray", "clock", "custom/power"],

  // the brand badge: the company in Michroma; click for the command palette
  "custom/brand": {
    "exec": "~/.local/bin/fui brand --bar",
    "interval": "once",
    "tooltip": false,
    "on-click": "~/.local/bin/fui palette"
  },

  // workspace segments: 01 02 03 ..., the current one underlined in the accent
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": { "1": "01", "2": "02", "3": "03", "4": "04", "5": "05", "6": "06", "7": "07", "8": "08", "9": "09", "default": "{name}" },
    "persistent-workspaces": { "*": 4 },
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },

  // the focused window: its app in tracked capitals, then its title
  "hyprland/window": {
    "format": "<span alpha='60%' size='small' letter_spacing='1600'>{class}</span>  {title}",
    "max-length": 70,
    "separate-outputs": true
  },

  "custom/rec": {
    "exec": "~/.local/bin/fui record status",
    "interval": 2,
    "return-type": "json",
    "on-click": "~/.local/bin/fui record stop"
  },

  "mpris": {
    "format": "<span alpha='60%' size='small' letter_spacing='1600'>PLAY</span> {title}",
    "format-paused": "<span alpha='60%' size='small' letter_spacing='1600'>PAUSE</span> {title}",
    "max-length": 32,
    "on-click": "playerctl play-pause"
  },

  "custom/updates": {
    "exec": "~/.local/bin/fui updates --bar",
    "interval": 3600,
    "return-type": "json",
    "on-click": "~/.local/bin/fui tui fui update"
  },

  "cpu": {
    "format": "<span alpha='60%' size='small' letter_spacing='1600'>CPU</span> {usage:02}%",
    "interval": 2,
    "states": { "warning": 70, "critical": 90 },
    "on-click": "~/.local/bin/fui tui btop"
  },

  "memory": {
    "format": "<span alpha='60%' size='small' letter_spacing='1600'>MEM</span> {percentage:02}%",
    "interval": 4,
    "states": { "warning": 75, "critical": 90 },
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
    "on-click": "~/.local/bin/fui tui btop"
  },

  "network": {
    "format-ethernet": "<span alpha='60%' size='small' letter_spacing='1600'>NET</span> eth",
    "format-wifi": "<span alpha='60%' size='small' letter_spacing='1600'>NET</span> {signalStrength}%",
    "format-disconnected": "<span alpha='60%' size='small' letter_spacing='1600'>NET</span> offline",
    "tooltip-format": "{essid} {ifname}  {ipaddr}/{cidr}\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}",
    "interval": 5,
    "on-click": "~/.local/bin/fui tui nmtui",
    "on-click-right": "nm-connection-editor"
  },

  "pulseaudio": {
    "format": "<span alpha='60%' size='small' letter_spacing='1600'>VOL</span> {volume:02}%",
    "format-muted": "<span alpha='60%' size='small' letter_spacing='1600'>VOL</span> mute",
    "on-click": "~/.local/bin/fui tui wiremix",
    "on-click-middle": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },

  "hyprland/language": {
    "format": "<span alpha='60%' size='small' letter_spacing='1600'>KBD</span> {short}"
  },

  // interface sounds on / off
  "custom/sound": {
    "exec": "~/.local/bin/fui sound status --bar",
    "interval": "once",
    "signal": 9,
    "on-click": "~/.local/bin/fui sound toggle",
    "tooltip": false
  },

  // the theme and its name; click cycles night → concrete → lab
  "custom/mode": {
    "exec": "~/.local/bin/fui mode status --bar",
    "interval": "once",
    "signal": 8,
    "on-click": "~/.local/bin/fui mode toggle",
    "tooltip": false
  },

  // notification centre: the count, or a struck bell when do-not-disturb is on
  "custom/notify": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "<span alpha='60%' size='small' letter_spacing='1600'>MSG</span> {}",
    "format-icons": { "notification": "󰂚", "none": "󰂜", "dnd-notification": "󰂛", "dnd-none": "󰂛",
                      "inhibited-notification": "󰂚", "inhibited-none": "󰂜", "dnd-inhibited-notification": "󰂛", "dnd-inhibited-none": "󰂛" },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": false
  },

  "tray": {
    "icon-size": 14,
    "spacing": 8
  },

  // the clock in the brand face, the date small beside it
  "clock": {
    "format": "{:%H:%M}  <span alpha='60%' size='small' letter_spacing='1600'>%a %d %b</span>",
    "format-alt": "{:%H:%M:%S}  <span alpha='60%' size='small' letter_spacing='1600'>%Y-%m-%d</span>",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<b>{}</b>",
        "weekdays": "<span alpha='55%'>{}</span>",
        "today": "<span underline='single'><b>{}</b></span>"
      }
    }
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.local/bin/fui power"
  }
}
