// fui // WAYBAR, compact (the status rail on small screens)
// `fui bar` picks this on screens narrower than 1400 px (e.g. 1024x768). Everything not set
// here comes from config.jsonc.
{
  "include": ["~/.config/waybar/config.jsonc"],
  "margin-left": 8,
  "margin-right": 8,

  "modules-left":   ["custom/brand", "hyprland/workspaces"],
  "modules-center": [],
  "modules-right":  ["custom/rec", "cpu", "memory", "pulseaudio", "battery", "custom/mode", "custom/notify", "tray", "clock", "custom/power"],

  "hyprland/workspaces": { "persistent-workspaces": { "*": 3 } }
}
