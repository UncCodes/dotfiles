#!/usr/bin/env bash
# fui // one command for the desktop.
#
#   fui mode [toggle|pick|<edition>|apply|status]    the edition (toggle: the next in this look; pick: all of them)
#   fui look [toggle|pick|instrument|y2k|status]     the look: instrument (cyan … lab) or y2k (ice chrome slate ruby)
#   fui skin [apply|status]                          the music player's skin, drawn from the edition (Audacious)
#   fui display [auto|crt|lcd|deep|pick|status]      the display tier (SUPER+SHIFT+D)
#   fui alert [on|off|status] · watch · idle         the alert takeover · battery/heat watch · idle steps
#   fui wallpaper [start|toggle|live|still]          the survey backdrop, live or still (SUPER+SHIFT+W)
#   fui screen [toggle|on|off]                       the screen finish, a faint vignette (SUPER+SHIFT+C)
#   fui sound <event>|on|off|toggle|status           interface sounds
#   fui palette | power | keys | clipboard           launcher windows (SUPER+Space, SUPER+X, SUPER+/, SUPER+SHIFT+V)
#   fui shot [region|screen|edit|tour]               screenshots (Print, SHIFT+Print, SUPER+Print)
#   fui record [toggle|start|stop|status]            screen recording (SUPER+R)
#   fui bar | tabs | layout | tui <command>          the bar, the startup tabs and layout, a floating terminal tool
#   fui updates | brand                              count pending package updates · the machine's name and OS
#   fui update | version | rollback [version]        pull the dotfiles and install · show / go back to a version
#   fui doctor [--fix]                               check the machine, optionally fix what it can
#   fui setup [gpu|audio|bluetooth|firmware|system|firefox|boot|all] [--yes]   (boot: splash + login screen)
#   fui help
set -u
# shellcheck disable=SC2154  # the I_* icon variables come from icons.sh (generated)

DOTS="${DOTFILES_DIR:-$HOME/.dotfiles}"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/fui"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/fui"
SHARE="${XDG_DATA_HOME:-$HOME/.local/share}/fui"
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
# icons (Material Design outline, Nerd Font), generated from tokens.toml [icons]
# shellcheck source=/dev/null
. "$CFG/fui/icons.sh" 2>/dev/null || . "$DOTS/fui/.config/fui/icons.sh" 2>/dev/null || true

have()   { command -v "$1" >/dev/null 2>&1; }
upper()  { echo "$1" | tr '[:lower:]' '[:upper:]'; }
# run in the background, detached; lock files (fds 7-9) are never handed to the child, or a
# long-lived program would hold a lock and block every later call
detach() { if have setsid; then setsid -f "$@" >/dev/null 2>&1 7>&- 8>&- 9>&-; else "$@" >/dev/null 2>&1 7>&- 8>&- 9>&- & fi; }
die()    { echo "fui: $*" >&2; exit 1; }
t3()     { if have timeout; then timeout 3 "$@"; else "$@"; fi; }   # calls to services that may not be running
note()   { have notify-send && t3 notify-send -t 2200 -a fui ${3:+-i "$3"} "$1" "${2:-}"; return 0; }   # title body [icon name]
usage()  { sed -n '3,19p' "$SELF" | sed 's/^# \{0,1\}//'; }

# token lookups from ~/.config/fui/tokens.json (generated from tokens.toml)
tok() {
  python3 -c '
import json, sys
t = json.load(open(sys.argv[1]))
v = t
for k in sys.argv[2].split("."):
    v = v[k]
print(" ".join(v) if isinstance(v, list) else v)
' "$CFG/fui/tokens.json" "$1" 2>/dev/null
}

# rofi in the fui panel, with its own plate title and asset code
rofi_window() {   # rofi_window "<TITLE>" "<CODE>" [rofi args...]
  # One -theme-str per element: some rofi builds read a string with two quoted values as one
  # value, and the title showed the raw theme text.
  local title="$1" code="$2"; shift 2
  rofi -config "$CFG/rofi/config.rasi" \
    -theme-str "textbox-title { content: \"$title\"; }" \
    -theme-str "textbox-code { content: \"$code\"; }" "$@"
}


# ── mode: the edition ───────────────────────────────────────────────────
# theme/build.py writes every themed file once per edition. Each app reads a fui-colors.*
# (or fui-mode.css) link next to them; this points the links at one edition.
modes() { local m; m=$(tok meta.editions); echo "${m:-cyan amber phosphor acid hazard mono paper lab}"; }
looks() { local l; l=$(tok meta.looks); echo "${l:-instrument}"; }
look_of() { local l; l=$(tok "edition.$1.look"); echo "${l:-instrument}"; }   # an edition's look
modes_of() { local m; for m in $(modes); do [ "$(look_of "$m")" = "$1" ] && printf '%s ' "$m"; done; echo; }
current_look() { look_of "$(current_mode)"; }

current_mode() {
  local m all new
  m=$(cat "$STATE/mode" 2>/dev/null)
  new=$(tok "meta.renamed.$m"); [ -n "$new" ] && m="$new"     # night -> cyan, concrete -> paper
  all=" $(modes) "
  if [ -n "$m" ] && [[ "$all" == *" $m "* ]]; then echo "$m"; else set -- $all; echo "$1"; fi
}

mode_link() {   # <dir> <target> <link name>
  local dir="$1" target="$2" link="$3"
  [ -e "$dir/$target" ] || return 0
  [ "$(readlink "$dir/$link" 2>/dev/null)" = "$target" ] || ln -sfn "$target" "$dir/$link"
}

render_startpage() {   # the browser home page for this user, in the current edition and tier
  local src="$CFG/fui/start/start.html"
  [ -f "$src" ] || return 0
  mkdir -p "$SHARE"
  sed -e "s|__USER__|${USER:-user}|g" -e "s|__HOST__|$(host_name)|g" -e "s|__OS__|$(os_name)|g" \
      -e "s|__LOGO__|$(os_logo)|g" -e "s|__KERNEL__|$(uname -r)|g" \
      -e "s|__EDITION__|$(current_mode)|g" -e "s|__DISPLAY__|$(current_tier)|g" -e "s|__LOOK__|$(current_look)|g" \
      "$src" > "$SHARE/start.html.tmp" &&
    mv "$SHARE/start.html.tmp" "$SHARE/start.html"
}

firefox_profiles() {   # every Firefox profile folder
  local base ini p
  for base in "$HOME/.config/mozilla/firefox" "$HOME/.mozilla/firefox"; do
    ini="$base/profiles.ini"
    [ -f "$ini" ] || continue
    sed -n 's/^Path=//p' "$ini" | while read -r p; do
      case "$p" in /*) echo "$p" ;; *) echo "$base/$p" ;; esac
    done
  done
}

edition_blurb() {   # one line per edition for the picker
  case "$1" in
    cyan) echo "obsidian and signal cyan: night operations" ;;
    amber) echo "warm black and amber: an amber terminal" ;;
    phosphor) echo "green-black and phosphor green: a green screen" ;;
    acid) echo "black and acid lime" ;;
    hazard) echo "black and signal yellow: industrial plates" ;;
    mono) echo "black, white and one red: focus by inversion" ;;
    paper) echo "warm paper and oxide red: technical print (light)" ;;
    lab) echo "clinical white and cobalt (light)" ;;
    ice) echo "ice haze and electric blue: the soft club sleeve (light)" ;;
    chrome) echo "brushed aluminium and a blue LCD: the player skin (light)" ;;
    slate) echo "gunmetal and periwinkle: the skinned desktop" ;;
    ruby) echo "a ruby shell around navy: the disc suite" ;;
    *) echo "" ;;
  esac
}

in_session() { [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || [ -n "${LABWC_PID:-}" ]; }   # a desktop session is running

restart_services() {   # tell running apps about a new edition, tier or alert
  pkill -USR1 -x kitty 2>/dev/null                 # kitty re-reads kitty.conf
  in_session || return 0
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then t3 hyprctl reload >/dev/null 2>&1   # window edges, glass, background
  else kill -HUP "$LABWC_PID" 2>/dev/null; fi       # labwc re-reads rc.xml and the theme
  bar_start
  have swaync-client && pgrep -x swaync >/dev/null && t3 swaync-client -rs >/dev/null 2>&1
  if pgrep -x swayosd-server >/dev/null; then pkill -x swayosd-server; detach swayosd-server; fi
}

cmd_mode() {
  local cmd="${1:-status}" quiet=0 cur a new
  for a in "$@"; do [ "$a" = --quiet ] && quiet=1; done
  cur=$(current_mode)
  case "$cmd" in
    status)
      if [ "${2:-}" = --bar ]; then
        echo "<span alpha='70%'>${I_edition-}</span> $cur · $(current_tier)"
      elif [ "${2:-}" = --look ]; then
        current_look
      else
        echo "$cur"
      fi
      return 0 ;;
    toggle)   # the next edition in this look's cycle
      local first="" take=0 m
      new=""
      for m in $(modes_of "$(look_of "$cur")"); do
        [ -n "$first" ] || first="$m"
        if [ "$take" = 1 ]; then new="$m"; break; fi
        [ "$m" = "$cur" ] && take=1
      done
      new="${new:-$first}" ;;
    pick)   # each edition with a swatch of its signal colour and its look
      local m rows="" pick sw
      for m in $(modes); do
        sw=$(tok "edition.$m.signal")
        rows="$rows<span color='${sw:-#888888}'>■</span>  $(printf '%-9s' "$m")<span alpha='55%'>$(printf '%-11s' "$(look_of "$m")")</span><span alpha='70%'>$(edition_blurb "$m")</span>"$'\n'
      done
      pick=$(printf '%s' "$rows" | rofi_window "${I_edition-}  EDITION" "ED-06" -dmenu -i -p "SET" -no-custom -lines 12 -markup-rows -format i) || return 0
      # shellcheck disable=SC2046
      set -- $(modes); shift "$pick" 2>/dev/null || return 0; new="$1" ;;
    apply) new="$cur" ;;
    *)
      local alias; alias=$(tok "meta.renamed.$cmd"); [ -n "$alias" ] && cmd="$alias"
      [[ " $(modes) " == *" $cmd "* ]] || die "usage: fui mode [toggle|pick|$(modes | tr ' ' '|')|apply|status]"
      new="$cmd" ;;
  esac

  mkdir -p "$STATE"
  [ "$new" = "$cur" ] && [ "$(cat "$STATE/mode" 2>/dev/null)" = "$new" ] || echo "$new" > "$STATE/mode"
  local look; look=$(look_of "$new")
  echo "$new" > "$STATE/edition-$look"        # fui look comes back to this edition

  local app
  for app in waybar swaync swayosd; do
    mode_link "$CFG/$app" "colors-$new.css" fui-colors.css
    mode_link "$CFG/$app" "look-$look.css"  fui-look.css
  done
  mode_link "$CFG/rofi"    "look-$look.rasi"   fui-look.rasi
  mode_link "$CFG/hypr"    "lock-$look.conf"   fui-look-lock.conf
  mode_link "$CFG/labwc"   "rc-$look.xml"      rc.xml                 # labwc: the look's frame and the keys
  mkdir -p "$HOME/.local/share/themes"
  mode_link "$HOME/.local/share/themes" "fui-$new" fui                # labwc: the edition's title bars
  mode_link "$CFG/rofi"    "colors-$new.rasi"  fui-colors.rasi
  mode_link "$CFG/hypr"    "colors-$new.conf"  fui-colors.conf
  mode_link "$CFG/kitty"   "colors-$new.conf"  fui-colors.conf
  mode_link "$CFG/kitty"   "console-$new.conf" fui-console.conf
  mode_link "$CFG/gtk-3.0" "fui-$new.css"      fui-mode.css
  mode_link "$CFG/gtk-4.0" "fui-$new.css"      fui-mode.css
  mode_link "$CFG/btop/themes" "fui-$new.theme" fui.theme
  mode_link "$CFG/mpv"     "colors-$new.conf"  fui-colors.conf
  mode_link "$CFG/zathura" "colors-$new"       fui-colors
  mode_link "$CFG/imv"     "config-$new"       config
  mode_link "$CFG/satty"   "config-$new.toml"  config.toml
  if [ -f "$CFG/qt6ct/qt6ct.conf" ]; then
    sed -i -E "s|(colors/fui)[^/]*\.conf|\1-$new.conf|; s|(qss/fui)[^/]*\.qss|\1-$new.qss|" "$CFG/qt6ct/qt6ct.conf"
  fi
  local prof
  while IFS= read -r prof; do
    [ -L "$prof/chrome/fui-colors.css" ] && ln -sfn "$CFG/fui/firefox/colors-$new.css" "$prof/chrome/fui-colors.css"
  done < <(firefox_profiles)
  tier_links "$(current_tier)"
  alert_links "$(cat "$STATE/alert" 2>/dev/null || echo off)"
  render_startpage
  cmd_skin apply --quiet
  # links from earlier looks, which no longer exist in the repo
  rm -f "$CFG/kitty/fui-mode.conf" "$CFG/waybar/fui-mode.css" "$CFG/rofi/fui-mode.rasi" "$CFG/mako/fui-mode" \
        "$CFG/hypr/fui-mode-hyprlock.conf" "$CFG/fui/fui-mode.sh" "$CFG/fui/starship.toml" "$CFG/git/fui-mode.gitconfig" \
        "$CFG/kitty/console.conf" "$SHARE/brand/mark.png" 2>/dev/null

  [ "$cmd" = apply ] && return 0

  # the desktop's dark / light preference
  local scheme gtk icons
  scheme=$(tok "edition.$new.scheme"); scheme="${scheme:-dark}"
  gtk=$(tok "desktop.$scheme.gtk_base"); icons=$(tok "desktop.$scheme.icon_theme")
  if have gsettings; then
    t3 gsettings set org.gnome.desktop.interface color-scheme "$(tok "desktop.$scheme.scheme")"
    [ -n "$gtk" ] && t3 gsettings set org.gnome.desktop.interface gtk-theme "$gtk"
    [ -n "$icons" ] && t3 gsettings set org.gnome.desktop.interface icon-theme "$icons"
  fi
  restart_services
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    detach "$SELF" wallpaper start
    cmd_sound move
  fi
  [ "$quiet" = 1 ] || note "EDITION" "$new · $look" preferences-desktop-theme
  return 0
}


# ── look: the visual language (instrument or y2k) ───────────────────────
# Every edition belongs to one look; switching looks returns to the edition last used in it.
cmd_look() {
  local cmd="${1:-status}" cur target l rows="" pick quiet="" a
  for a in "$@"; do [ "$a" = --quiet ] && quiet=--quiet; done
  cur=$(current_look)
  case "$cmd" in
    status) echo "$cur"; return 0 ;;
    toggle)
      local first="" take=0
      target=""
      for l in $(looks); do
        [ -n "$first" ] || first="$l"
        if [ "$take" = 1 ]; then target="$l"; break; fi
        [ "$l" = "$cur" ] && take=1
      done
      target="${target:-$first}" ;;
    pick)
      for l in $(looks); do rows="$rows$(printf '%-11s' "$l")<span alpha='70%'>$(modes_of "$l")</span>"$'\n'; done
      pick=$(printf '%s' "$rows" | rofi_window "${I_edition-}  LOOK" "LK-01" -dmenu -i -p "SET" -no-custom -lines 4 -markup-rows -format i) || return 0
      # shellcheck disable=SC2046
      set -- $(looks); shift "$pick" 2>/dev/null || return 0; target="$1" ;;
    *)
      [[ " $(looks) " == *" $cmd "* ]] || die "usage: fui look [toggle|pick|$(looks | tr ' ' '|')|status]"
      target="$cmd" ;;
  esac
  local ed
  ed=$(cat "$STATE/edition-$target" 2>/dev/null)
  if [ -z "$ed" ] || [ "$(look_of "$ed")" != "$target" ]; then
    ed=$(modes_of "$target"); ed="${ed%% *}"
  fi
  [ -n "$ed" ] || die "no edition belongs to the look $target"
  cmd_mode "$ed" ${quiet:+"$quiet"}
}


# ── skin: the music player wears the edition ────────────────────────────
# theme/make-skin.py draws a classic player skin (the Winamp 2 bitmap format, read by Audacious)
# from the edition's roles: y2k editions get shells, bevels, lit readouts and a gel play button;
# instrument editions flat panels and hairlines. ~/.local/share/fui/skin always points at the
# current edition's skin, and Audacious is told to load that path once.
cmd_skin() {
  local cmd="${1:-status}" quiet=0 a ed dir link="$SHARE/skin" conf="$CFG/audacious/config"
  for a in "$@"; do [ "$a" = --quiet ] && quiet=1; done
  ed=$(current_mode); dir="$SHARE/skins/$ed"
  case "$cmd" in
    status)
      echo "edition $ed ($(look_of "$ed") look) · skin $(readlink "$link" 2>/dev/null || echo none)"
      if have audacious; then
        echo "Audacious: View → Interface → Winamp Classic Interface shows it (the Qt interface follows the edition through qt6ct)"
      else
        echo "Audacious is not installed (packages.txt lists it)"
      fi
      return 0 ;;
    apply) ;;
    *) die "usage: fui skin [apply|status]" ;;
  esac
  have audacious || [ "${FUI_SKIN_ALWAYS:-0}" = 1 ] || return 0
  # draw it when missing or older than the tokens
  if [ ! -f "$dir/main.bmp" ] || [ "$CFG/fui/tokens.json" -nt "$dir/main.bmp" ]; then
    python3 "$DOTS/theme/make-skin.py" --edition "$ed" "$dir" >/dev/null 2>&1 || {
      [ "$quiet" = 1 ] || echo "fui: the player skin needs python-pillow" >&2; return 0; }
  fi
  ln -sfn "$dir" "$link"
  # point Audacious at the link once (never while it runs: it rewrites its config on exit)
  if ! grep -qs "^skin=$link\$" "$conf" && ! pgrep -x audacious >/dev/null 2>&1; then
    mkdir -p "${conf%/*}"
    if grep -qs '^\[skins\]' "$conf"; then
      if grep -qs '^skin=' "$conf"; then sed -i "s|^skin=.*|skin=$link|" "$conf"
      else sed -i "/^\[skins\]/a skin=$link" "$conf"; fi
    else
      printf '\n[skins]\nskin=%s\n' "$link" >> "$conf"
    fi
  fi
  [ "$quiet" = 1 ] || note "PLAYER SKIN" "$ed" audio-x-generic
  return 0
}

# ── display: the tier (crt, lcd, deep) ──────────────────────────────────
# A tube, a backlit panel, or an OLED / HDR / wide-gamut panel. `auto` reads the connected
# screens: an analog input is a tube (crt), a 10-bit or HDR output is deep, anything else is
# lcd. A digital output with no EDID is an adapter to VGA, so a tube too. An LCD on a VGA
# cable reports analog as well: pin `fui display lcd` for that.
detect_tier() {   # prints "<tier>|<reason>"
  local c name st byte
  for c in /sys/class/drm/card*-*; do
    [ -r "$c/status" ] || continue
    st=$(cat "$c/status" 2>/dev/null); [ "$st" = connected ] || continue
    name="${c##*/}"; name="${name#card*-}"
    case "$name" in
      VGA-*|DVI-A-*) echo "crt|$name is an analog output"; return 0 ;;
    esac
    if [ -s "$c/edid" ]; then
      byte=$(od -An -t u1 -j 20 -N 1 "$c/edid" 2>/dev/null | tr -d ' ')
      if [ -n "$byte" ] && [ $((byte & 128)) = 0 ]; then echo "crt|$name reports an analog input"; return 0; fi
    else
      # a digital output that hears nothing back: almost always an adapter to VGA (a DP or
      # HDMI to VGA dongle doesn't pass the screen's EDID through), and so, most often, a tube
      echo "crt|$name sends no EDID (an adapter to VGA)"; return 0
    fi
  done
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    local deep
    deep=$(hyprctl -j monitors 2>/dev/null | python3 -c '
import json, sys
try:
    for m in json.load(sys.stdin):
        fmt = str(m.get("currentFormat", ""))
        cm = str(m.get("colorManagementPreset", m.get("cm", "")))
        if "2101010" in fmt or "16161616" in fmt or "hdr" in cm.lower():
            print(m["name"] + (" runs HDR" if "hdr" in cm.lower() else " runs 10-bit"))
            break
except Exception:
    pass
' 2>/dev/null)
    [ -n "$deep" ] && { echo "deep|$deep"; return 0; }
  fi
  echo "lcd|a standard panel"
}

current_tier() {   # the tier in use (resolved by fui display)
  local t
  t=$(cat "$STATE/tier" 2>/dev/null)
  case "$t" in crt|lcd|deep) echo "$t" ;; *) echo lcd ;; esac
}

tier_links() {   # point every app's fui-tier link at one tier
  local t="$1" app prof
  for app in waybar swaync swayosd; do mode_link "$CFG/$app" "tier-$t.css" fui-tier.css; done
  mode_link "$CFG/rofi"    "tier-$t.rasi"    fui-tier.rasi
  mode_link "$CFG/hypr"    "tier-$t.conf"    fui-tier.conf
  mode_link "$CFG/kitty"   "tier-$t.conf"    fui-tier.conf
  mode_link "$CFG/gtk-3.0" "fui-tier-$t.css" fui-tier.css
  mode_link "$CFG/gtk-4.0" "fui-tier-$t.css" fui-tier.css
  while IFS= read -r prof; do
    [ -d "$prof/chrome" ] && ln -sfn "$CFG/fui/firefox/tier-$t.css" "$prof/chrome/fui-tier.css"
  done < <(firefox_profiles)
}

screen_size() {   # "<width> <height>" of the largest screen, in logical pixels
  if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && have wlr-randr && wlr-randr --json >/dev/null 2>&1; then
    wlr-randr --json 2>/dev/null | python3 -c '
import json, sys
try:
    best = (0, 1920, 1080)
    for o in json.load(sys.stdin):
        if not o.get("enabled"):
            continue
        for m in o.get("modes", []):
            if m.get("current"):
                s = o.get("scale") or 1
                w, h = int(m["width"] / s), int(m["height"] / s)
                best = max(best, (w * h, w, h))
    print(best[1], best[2])
except Exception:
    print(1920, 1080)
' 2>/dev/null || echo "1920 1080"
    return 0
  fi
  hyprctl -j monitors 2>/dev/null | python3 -c '
import json, sys
try:
    m = max(json.load(sys.stdin), key=lambda x: x["width"] * x["height"])
    print(int(m["width"] / m["scale"]), int(m["height"] / m["scale"]))
except Exception:
    print(1920, 1080)
' 2>/dev/null || echo "1920 1080"
}

cmd_display() {
  mkdir -p "$STATE"
  local pref t reason found
  pref=$(cat "$STATE/display" 2>/dev/null); case "$pref" in crt|lcd|deep) ;; *) pref=auto ;; esac
  case "${1:-status}" in
    status)
      found=$(detect_tier)
      if [ "$pref" = auto ]; then echo "$(current_tier) (auto: ${found#*|})"; else echo "$(current_tier) (pinned; auto would pick ${found%%|*}: ${found#*|})"; fi
      return 0 ;;
    pick)
      local pick
      pick=$(printf '%s  auto      read the screen\n%s  crt       a tube: 2 px lines, black floor, safe inset, no effects\n%s  lcd       a backlit panel: 1 px hairlines\n%s  deep      OLED / HDR: true black, a soft halo on the focused window\n' \
          "${I_auto-}" "${I_crt-}" "${I_lcd-}" "${I_deep-}" |
        rofi_window "${I_display-}  DISPLAY TIER" "DSP-07" -dmenu -i -p "SET" -no-custom -lines 4 -format i) || return 0
      case "$pick" in 0) pref=auto ;; 1) pref=crt ;; 2) pref=lcd ;; 3) pref=deep ;; *) return 0 ;; esac ;;
    toggle) case "$pref" in auto) pref=crt ;; crt) pref=lcd ;; lcd) pref=deep ;; *) pref=auto ;; esac ;;
    auto|crt|lcd|deep) pref="$1" ;;
    apply|start) ;;
    *) die "usage: fui display [auto|crt|lcd|deep|toggle|pick|apply|status]" ;;
  esac
  echo "$pref" > "$STATE/display"
  if [ "$pref" = auto ]; then found=$(detect_tier); t="${found%%|*}"; reason="${found#*|}"; else t="$pref"; reason="pinned"; fi
  local before; before=$(current_tier)
  echo "$t" > "$STATE/tier"
  # the crt safe inset: 3% of the screen kept clear at every edge
  local inset w h
  inset=$(tok "tier.$t.inset"); inset="${inset:-0}"
  read -r w h < <(screen_size)
  python3 -c "import sys; print(round(float(sys.argv[1]) * min(int(sys.argv[2]), int(sys.argv[3]))))" "$inset" "${w:-1920}" "${h:-1080}" \
    > "$STATE/inset" 2>/dev/null || echo 0 > "$STATE/inset"
  tier_links "$t"
  render_startpage
  [ "${1:-}" = apply ] && return 0
  # at sign-in: reload only if the screen changed since the last session
  [ "${1:-}" = start ] && [ "$t" = "$before" ] && return 0
  restart_services
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && detach "$SELF" wallpaper start
  [ "${1:-}" = start ] || note "DISPLAY TIER" "$t ($reason)" video-display
  return 0
}


# ── alert: the takeover ─────────────────────────────────────────────────
# When something needs the operator now (battery nearly empty, overheating), the chrome's
# signal becomes the bad colour: the window edge, the bar, the memos. One transition in, then
# steady: nothing flashes. It reverts when the condition clears.
alert_links() {
  local s="$1" app
  for app in waybar swaync; do mode_link "$CFG/$app" "alert-$s.css" fui-alert.css; done
}

cmd_alert() {
  mkdir -p "$STATE"
  local cur; cur=$(cat "$STATE/alert" 2>/dev/null); [ "$cur" = on ] || cur=off
  case "${1:-status}" in
    status) echo "$cur"; return 0 ;;
    on)
      local word="${2:-FAULT}" msg="${3:-}"
      echo "${4:-manual}" > "$STATE/alert-source"
      [ "$cur" = on ] && return 0
      echo on > "$STATE/alert"; alert_links on
      have notify-send && t3 notify-send -u critical -a fui -i dialog-warning "$word" "$msg"
      cmd_sound alert ;;
    off)
      rm -f "$STATE/alert-source"
      [ "$cur" = off ] && return 0
      echo off > "$STATE/alert"; alert_links off ;;
    *) die "usage: fui alert [on [WORD] [message]|off|status]" ;;
  esac
  restart_services
  return 0
}

# the watch: battery and heat, once a minute, for the session (started by hyprland.lua)
cmd_watch() {
  mkdir -p "$CACHE"
  exec 7>"$CACHE/.watch.lock"
  if have flock; then flock -n 7 || return 0; fi            # already watching
  local low hot b cap st t max reason
  low=$(tok safety.battery_alert); low="${low:-5}"
  hot=$(tok safety.heat_alert); hot="${hot:-95}"
  while :; do
    reason=""
    for b in /sys/class/power_supply/BAT*; do
      [ -r "$b/capacity" ] || continue
      cap=$(cat "$b/capacity" 2>/dev/null); st=$(cat "$b/status" 2>/dev/null)
      [ "$st" = Discharging ] && [ "${cap:-100}" -le "$low" ] && reason="FAULT|BATTERY ${cap}% · CONNECT POWER NOW"
    done
    max=0
    for t in /sys/class/thermal/thermal_zone*/temp; do
      [ -r "$t" ] || continue
      t=$(( $(cat "$t" 2>/dev/null || echo 0) / 1000 ))
      [ "$t" -gt "$max" ] && [ "$t" -lt 150 ] && max=$t
    done
    [ "$max" -ge "$hot" ] && reason="WARNING|HEAT ${max} °C · CLOSE HEAVY WORK"
    if [ -n "$reason" ]; then
      [ "$(cat "$STATE/alert" 2>/dev/null)" = on ] || cmd_alert on "${reason%%|*}" "${reason#*|}" watch
    elif [ "$(cat "$STATE/alert-source" 2>/dev/null)" = watch ]; then
      cmd_alert off
    fi
    sleep 60
  done
}


# ── idle: static-content protection on crt and deep ─────────────────────
# hypridle calls these. On a tube or an OLED panel the screen dims after 2 minutes, the bar
# moves by a pixel within its box (burn-in drift) and the screen blanks after 5 minutes. On
# lcd nothing happens here.
protected() { [ "$(tok "tier.$(current_tier).protect")" = True ]; }

cmd_idle() {
  mkdir -p "$STATE"
  case "${1:-}" in
    dim)
      protected || return 0
      if have brightnessctl && brightnessctl -l -c backlight 2>/dev/null | grep -q backlight; then
        local share cur
        share=$(tok safety.dim_to); share="${share:-0.6}"
        cur=$(brightnessctl -c backlight get 2>/dev/null)
        brightnessctl -c backlight -s >/dev/null 2>&1
        [ -n "$cur" ] && brightnessctl -c backlight set "$(python3 -c "print(max(1, round($cur * $share)))")" >/dev/null 2>&1
        touch "$STATE/dimmed"
      fi
      echo $(( ( $(cat "$STATE/drift" 2>/dev/null || echo 0) + 1 ) % 4 )) > "$STATE/drift"
      [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && bar_start ;;
    blank)
      protected || return 0
      hyprctl dispatch 'hl.dsp.dpms({ action = "disable" })' >/dev/null 2>&1 ;;
    wake)
      if [ -e "$STATE/dimmed" ]; then brightnessctl -c backlight -r >/dev/null 2>&1; rm -f "$STATE/dimmed"; fi
      hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })' >/dev/null 2>&1 ;;
    *) die "usage: fui idle dim|blank|wake" ;;
  esac
  return 0
}

# the lock screen's clock: on crt and deep it moves a few pixels every minute
cmd_lockclock() {
  local now n pad="" i
  now=$(date +%H:%M)
  if protected; then
    n=$(( 10#$(date +%M) % 5 - 2 ))
    for ((i = 0; i < ${n#-}; i++)); do pad="$pad "; done
    if [ "$n" -gt 0 ]; then echo "$pad$now"; else echo "$now$pad"; fi
  else
    echo "$now"
  fi
}


# ── wallpaper: the survey field ─────────────────────────────────────────
# Every edition surveys its own terrain in its own colours. Rendered for the edition, the
# display tier (the ground: floor, or true black on deep and crt) and the screen's size by
# theme/make-wallpaper.py into ~/.cache/fui/. Live: traces run along the contours, played by
# mpvpaper. Still: swaybg with the PNG (also shown while the loop renders); before the still
# exists, the edition's ground colour.
# Stop every other `fui wallpaper` run (including ones an older version left waiting on a
# lock), but never this one, what started it (a shell, a timeout) or its own subshells.
wallpaper_takeover() {
  local pid ppid p mine=" $$ "
  p=$$
  while p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ') && [ -n "$p" ] && [ "$p" -gt 1 ] 2>/dev/null; do
    mine="$mine$p "
  done
  for pid in $(pgrep -f "fui wallpaper" 2>/dev/null); do
    [[ "$mine" == *" $pid "* ]] && continue
    ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    [ "$ppid" = "$$" ] && continue
    kill "$pid" 2>/dev/null
  done
  rm -f "$CACHE/.wallpaper.lock"
  return 0
}

cmd_wallpaper() {
  mkdir -p "$STATE" "$CACHE"
  local pref
  pref=$(cat "$STATE/wallpaper" 2>/dev/null)
  [ "$pref" = still ] || pref=live
  case "${1:-start}" in
    start) ;;
    toggle) [ "$pref" = live ] && pref=still || pref=live; echo "$pref" > "$STATE/wallpaper"; note "BACKDROP" "$pref" preferences-desktop-wallpaper ;;
    live|still) pref="$1"; echo "$pref" > "$STATE/wallpaper" ;;
    status) echo "$pref"; return 0 ;;
    *) die "usage: fui wallpaper [start|toggle|live|still|status]" ;;
  esac

  local mode tier w h key still video tmp maker="$DOTS/theme/make-wallpaper.py"
  mode=$(current_mode); tier=$(current_tier)
  read -r w h < <(hyprctl -j monitors 2>/dev/null | python3 -c '
import json, sys
try:
    m = max(json.load(sys.stdin), key=lambda x: x["width"] * x["height"])
    print(m["width"] // 2 * 2, m["height"] // 2 * 2)
except Exception:
    print(1920, 1080)
' 2>/dev/null)
  w=${w:-1920}; h=${h:-1080}
  key=$(cat "$maker" "$DOTS/theme/survey.py" "$DOTS/theme/palette.py" "$DOTS/theme/tokens.toml" 2>/dev/null | sha1sum | cut -c1-8)
  still="$CACHE/still-$mode-$tier-${w}x$h-$key.png"
  video="$CACHE/live-$mode-$tier-${w}x$h-$key.mp4"
  # until this edition's survey is drawn, its ground colour (never another edition's picture)
  local ground
  ground=$(python3 -c '
import json, sys
t = json.load(open(sys.argv[1])); e = t["edition"][sys.argv[2]]; tier = sys.argv[3]
if tier == "lcd" or e["scheme"] != "dark":
    print(e.get(tier, {}).get("floor", e["floor"]) if tier == "crt" else e["floor"])
else:
    print("#000000")
' "$CFG/fui/tokens.json" "$mode" "$tier" 2>/dev/null)
  ground="${ground:-#07090C}"

  # A newer call (an edition change) takes over from an older one: stop it, its renderer and
  # its players. (No lock: the players would inherit it and block every later call; that
  # kept the wallpaper from following the edition.)
  wallpaper_takeover
  pkill -f "make-wallpaper.py" 2>/dev/null
  pkill -x mpvpaper 2>/dev/null
  pkill -x swaybg 2>/dev/null
  if [ -s "$still" ]; then detach swaybg -i "$still" -m fill; else detach swaybg -c "$ground"; fi

  [ -f "$maker" ] || return 0
  if [ ! -s "$still" ]; then
    rm -f "$CACHE/still-$mode-$tier-${w}x$h-"*.png
    if python3 "$maker" --edition "$mode" --tier "$tier" "$still.part.png" "$w" "$h" >/dev/null 2>"$CACHE/render.log"; then
      mv "$still.part.png" "$still"
      pkill -x swaybg 2>/dev/null; detach swaybg -i "$still" -m fill
    else
      rm -f "$still.part.png"
    fi
  fi

  [ "$pref" = live ] || return 0
  have mpvpaper && have ffmpeg || return 0
  if [ ! -s "$video" ]; then
    rm -f "$CACHE/live-$mode-$tier-${w}x$h-"*.mp4
    tmp="$video.part.mp4"
    if ! python3 "$maker" --live --edition "$mode" --tier "$tier" "$tmp" "$w" "$h" >/dev/null 2>"$CACHE/render.log"; then
      rm -f "$tmp"
      return 0                        # keep the still image; see ~/.cache/fui/render.log
    fi
    mv "$tmp" "$video"
  fi

  # -p pauses the loop while a fullscreen window hides the wallpaper
  mpvpaper -f -p -o "no-audio loop-file=inf hwdec=auto-safe panscan=1.0" ALL "$video" >"$CACHE/mpvpaper.log" 2>&1 7>&- 8>&- 9>&-
  sleep 1.5
  if pgrep -x mpvpaper >/dev/null; then
    pkill -x swaybg
  else
    echo "mpvpaper exited; still image kept. See $CACHE/mpvpaper.log" >> "$CACHE/render.log"
  fi
  return 0
}


# ── screen: the optional finish (lcd and deep only) ─────────────────────
cmd_screen() {
  mkdir -p "$STATE"
  local cur
  cur=$(cat "$STATE/screen" 2>/dev/null); [ "$cur" = off ] || cur=on
  case "${1:-status}" in
    status) echo "$cur"; return 0 ;;
    toggle) [ "$cur" = on ] && cur=off || cur=on ;;
    on|off) cur="$1" ;;
    *) die "usage: fui screen [toggle|on|off|status]" ;;
  esac
  echo "$cur" > "$STATE/screen"
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && t3 hyprctl reload >/dev/null 2>&1
  if [ "$(current_tier)" = crt ]; then note "SCREEN FINISH" "$cur (not drawn on a tube)" preferences-desktop-display
  else note "SCREEN FINISH" "$cur" preferences-desktop-display; fi
}


# ── sound: the portfolio's synthesised interface sounds ─────────────────
# Theme: [desktop] sound_theme in tokens.toml ("fui", made by theme/make-sounds.py),
# freedesktop as the fallback.
cmd_sound() {
  local ev="${1:-}" names theme file n t d f cur
  cur=$(cat "$STATE/sound" 2>/dev/null); [ "$cur" = off ] || cur=on
  case "$ev" in
    on|off|toggle)
      [ "$ev" = toggle ] && { [ "$cur" = on ] && ev=off || ev=on; }
      mkdir -p "$STATE"; echo "$ev" > "$STATE/sound"
      pkill -RTMIN+9 waybar 2>/dev/null
      [ "$ev" = on ] && cmd_sound tick
      return 0 ;;
    status)
      if [ "${2:-}" = --bar ]; then
        if [ "$cur" = on ]; then echo "<span alpha='70%'>${I_sounds-}</span> on"; else echo "<span alpha='70%'>${I_sounds_off-}</span> off"; fi
      else echo "$cur"; fi
      return 0 ;;
    "") die "usage: fui sound <event>|on|off|toggle|status" ;;
  esac
  [ "$cur" = off ] && return 0

  case "$ev" in
    login)      names="desktop-login service-login" ;;
    logout)     names="desktop-logout service-logout" ;;
    message)    names="message-new-instant message" ;;
    alert)      names="dialog-warning dialog-error" ;;
    volume)     names="audio-volume-change" ;;
    screenshot) names="screen-capture camera-shutter" ;;
    mode|move)  names="theme-change button-pressed" ;;
    tick)       names="button-pressed bell" ;;
    open)       names="window-new" ;;
    error)      names="dialog-error" ;;
    *)          names="$ev" ;;
  esac

  theme=$(tok desktop.sound_theme); theme="${theme:-fui}"
  file=""
  for n in $names; do
    for t in "$theme" freedesktop; do
      for d in "$HOME/.local/share/sounds" /usr/share/sounds; do
        for f in "$d/$t/stereo/$n".oga "$d/$t/stereo/$n".ogg "$d/$t/$n".oga "$d/$t/$n".ogg; do
          [ -f "$f" ] && { file="$f"; break 4; }
        done
      done
    done
  done
  [ -n "$file" ] || return 0

  # at login the audio server may not have an output yet: wait up to 15 s for one
  if [ "$ev" = login ] && have wpctl; then
    for _ in $(seq 30); do
      wpctl inspect @DEFAULT_AUDIO_SINK@ >/dev/null 2>&1 && break
      sleep 0.5
    done
  fi
  # volume key repeats: cut the previous tick instead of stacking them
  [ "$ev" = volume ] && pkill -f "pw-play .*audio-volume-change" 2>/dev/null

  if have pw-play; then detach pw-play --volume 0.8 "$file"
  elif have paplay; then detach paplay "$file"
  fi
  return 0
}


# ── bar / tabs / layout / tui ───────────────────────────────────────────
# The bar starts from a small file in ~/.cache/fui that includes the real config and sets
# its margins: the crt safe inset, plus the burn-in drift step on crt and deep. Every
# start goes through one lock and waits for the old bar to exit, so two can never run.
bar_start() {
  local dir="$CFG/waybar" w h config inset drift dx=0 dy=0 cfg="$CACHE/bar.jsonc"
  mkdir -p "$CACHE"
  (
    if have flock; then flock 8; fi
    read -r w h < <(screen_size)
    config="$dir/config.jsonc"
    [ "${w:-1920}" -lt 1400 ] && [ -e "$dir/config-compact.jsonc" ] && config="$dir/config-compact.jsonc"
    inset=$(cat "$STATE/inset" 2>/dev/null); inset="${inset:-0}"
    if protected; then
      drift=$(cat "$STATE/drift" 2>/dev/null || echo 0)
      case "$drift" in 1) dx=1 ;; 2) dx=1; dy=1 ;; 3) dy=1 ;; esac
    fi
    local mt=$(( (inset > 8 ? inset : 8) + dy )) ms=$(( (inset > 12 ? inset : 12) ))
    [ "$config" = "$dir/config-compact.jsonc" ] && [ "$inset" -lt 8 ] && ms=8
    printf '{\n  "include": ["%s"],\n  "margin-top": %d,\n  "margin-left": %d,\n  "margin-right": %d\n}\n' \
      "$config" "$mt" "$(( ms + dx ))" "$(( ms - dx ))" > "$cfg"
    # labwc: no Hyprland modules there; its windows are listed as a taskbar instead (the
    # stacking desktop's own idiom), where Hyprland shows the workspaces and the window title
    [ -n "${LABWC_PID:-}" ] && python3 - "$config" "$cfg" <<'PY'
import json, re, sys
src, out = sys.argv[1], sys.argv[2]
conf = json.loads(re.sub(r"^\s*//.*$", "", open(src).read(), flags=re.M))
cfg = json.load(open(out))
swap = {"hyprland/workspaces": None, "hyprland/window": "wlr/taskbar", "hyprland/language": None}
for side in ("modules-left", "modules-center", "modules-right"):
    mods = [swap.get(m, m) for m in conf.get(side, [])]
    cfg[side] = [m for m in mods if m]
if not any("wlr/taskbar" in cfg[s] for s in ("modules-left", "modules-center", "modules-right")):
    cfg["modules-center"] = ["wlr/taskbar"] + cfg["modules-center"]      # the compact bar has no title slot
json.dump(cfg, open(out, "w"), indent=2)
PY
    pkill -x waybar 2>/dev/null
    for _ in $(seq 40); do pgrep -x waybar >/dev/null || break; sleep 0.05; done
    pkill -9 -x waybar 2>/dev/null
    if have setsid; then
      setsid -f waybar -c "$cfg" -s "$dir/style.css" >"$CACHE/waybar.log" 2>&1 7>&- 8>&- 9>&-
    else
      waybar -c "$cfg" -s "$dir/style.css" >"$CACHE/waybar.log" 2>&1 7>&- 8>&- 9>&- &
    fi
  ) 8>"$CACHE/.bar.lock"
}

cmd_bar() {
  cmd_mode apply --quiet
  bar_start
}

cmd_tabs() {
  local session="$CFG/kitty/startup.session.local"
  [ -e "$session" ] || session="$CFG/kitty/startup.session"
  [ -s "$session" ] || return 0          # an empty startup.session.local turns them off
  exec kitty --class fui-main --session "$session"
}

cmd_layout() {   # the startup layout: one app per line, "workspace  command"
  local file="$CFG/fui/layout.conf.local"
  [ -e "$file" ] || file="$CFG/fui/layout.conf"
  [ -s "$file" ] || return 0
  have hyprctl || return 0
  local ws cmd first=""
  while read -r ws cmd; do
    case "$ws" in ''|'#'*) continue ;; esac
    [ -n "$cmd" ] || continue
    [ -n "$first" ] || first="$ws"
    cmd="${cmd//\$HOME/$HOME}"; cmd="${cmd/#fui /$SELF }"
    hyprctl dispatch "hl.dsp.exec_cmd(\"${cmd//\"/\\\"}\", { workspace = \"$ws silent\" })" >/dev/null 2>&1
    sleep 0.4
  done < "$file"
  [ -n "$first" ] && hyprctl dispatch "hl.dsp.focus({ workspace = '$first' })" >/dev/null 2>&1
  return 0
}

cmd_tui() {
  [ $# -gt 0 ] || die "usage: fui tui <command> [args]"
  exec kitty --class fui-tui --title "$1" "$@"
}


# ── launcher windows: palette, power, keys, clipboard ───────────────────
cmd_palette() {   # every action in one window; each row is "icon|label|command"
  local -a rows=(
    "${I_apps-}|Applications|rofi -config $CFG/rofi/config.rasi -show drun"
    "${I_windows-}|Windows|rofi -config $CFG/rofi/config.rasi -show window"
    "${I_run-}|Run a command|rofi -config $CFG/rofi/config.rasi -show run"
    "${I_edition-}|Edition: pick one|$SELF mode pick"
    "${I_next-}|Edition: the next one|$SELF mode toggle"
    "${I_look-}|Look: instrument or y2k|$SELF look toggle"
    "${I_audio-}|Player skin: draw it for this edition|$SELF skin apply"
    "${I_display-}|Display tier: auto, crt, lcd, deep|$SELF display pick"
    "${I_backdrop-}|Backdrop: live or still|$SELF wallpaper toggle"
    "${I_finish-}|Screen finish (lcd, deep)|$SELF screen toggle"
    "${I_alert_clear-}|Clear the alert|$SELF alert off"
    "${I_sounds-}|Interface sounds|$SELF sound toggle"
    "${I_region-}|Capture a region|$SELF shot region"
    "${I_screen-}|Capture the screen|$SELF shot screen"
    "${I_annotate-}|Capture and annotate|$SELF shot edit"
    "${I_record-}|Record the screen|$SELF record toggle"
    "${I_clipboard-}|Clipboard|$SELF clipboard"
    "${I_emoji-}|Emoji|rofi -config $CFG/rofi/config.rasi -modi emoji -show emoji"
    "${I_calculator-}|Calculator|rofi -config $CFG/rofi/config.rasi -modi calc -show calc -no-show-match -no-sort"
    "${I_files-}|Files|$SELF tui yazi"
    "${I_network-}|Network|$SELF tui nmtui"
    "${I_audio-}|Audio|$SELF tui wiremix"
    "${I_monitor-}|System monitor|$SELF tui btop"
    "${I_notices-}|Notices|swaync-client -t -sw"
    "${I_keys-}|Key reference|$SELF keys"
    "${I_update-}|Update the workstation|$SELF tui sh -c '$SELF update; echo; read -r -p \"done: press enter\" _'"
    "${I_doctor-}|Diagnostics|$SELF tui sh -c '$SELF doctor; echo; read -r -p \"press enter\" _'"
    "${I_session-}|Session|$SELF power"
  )
  local row pick
  pick=$(for row in "${rows[@]}"; do r="${row#*|}"; printf '%s  %s\n' "${row%%|*}" "${r%%|*}"; done |
    rofi_window "${I_run-}  COMMAND PALETTE" "CMD-02" -dmenu -i -p "RUN" -no-custom -format i) || return 0
  [ -n "$pick" ] && [ "$pick" -ge 0 ] 2>/dev/null || return 0
  row="${rows[$pick]}"; row="${row#*|}"
  cmd_sound tick; eval "detach ${row#*|}"
}

cmd_power() {
  local pick="${1:-}"
  if [ -z "$pick" ]; then
    local choice names=(lock logout suspend reboot shutdown) labels=(Lock "Sign out" Suspend Restart "Shut down")
    choice=$(printf '%s  Lock\n%s  Sign out\n%s  Suspend\n%s  Restart\n%s  Shut down\n' \
        "${I_lock-}" "${I_logout-}" "${I_suspend-}" "${I_reboot-}" "${I_shutdown-}" |
      rofi_window "${I_session-}  SESSION" "PWR-05" -dmenu -i -p "ACTION" -no-custom -lines 5 -format i) || return 0
    [ -n "$choice" ] && [ "$choice" -ge 0 ] 2>/dev/null && [ "$choice" -lt 5 ] || return 0
    pick="${names[$choice]}"
    case "$pick" in
      reboot|shutdown|logout)
        local sure
        sure=$(printf '%s  Confirm: %s\n%s  Cancel\n' "${I_confirm-}" "${labels[$choice]}" "${I_cancel-}" |
          rofi_window "${I_alert-}  CONFIRM" "PWR-05" -dmenu -i -p "ACTION" -no-custom -lines 2 -format i) || return 0
        [ "$sure" = 0 ] || return 0 ;;
    esac
  fi
  case "$pick" in
    lock) hyprlock ;;
    logout) cmd_sound logout; sleep 0.6
            if [ -n "${LABWC_PID:-}" ]; then labwc --exit 2>/dev/null || kill "$LABWC_PID"; else hyprctl dispatch 'hl.dsp.exit()'; fi ;;
    suspend) systemctl suspend ;;
    reboot) cmd_sound logout; sleep 0.6; systemctl reboot ;;
    shutdown) cmd_sound logout; sleep 0.6; systemctl poweroff ;;
    *) die "usage: fui power [lock|logout|suspend|reboot|shutdown]" ;;
  esac
}

keys_list() {   # "KEYS | does" for every binding in hyprland.lua that carries a comment
  python3 - "$CFG/hypr/hyprland.lua" "$CFG/fui/icons.sh" <<'PY'
import re, sys
mod = "SUPER"
out = []
for line in open(sys.argv[1], encoding="utf-8"):
    s = line.strip()
    m = re.match(r'--@\s*(.+?)\s*\|\s*(.+)$', s)
    if m:
        out.append((m.group(1), m.group(2)))
        continue
    m = re.match(r'hl\.bind\((?:k\("([^"]+)"\)|"([^"]+)")\s*,.*--\s*(.+)$', s)
    if m:
        keys = f"{mod}+{m.group(1)}" if m.group(1) else m.group(2)
        keys = keys.replace(" + ", "+").replace("grave", "`").replace("slash", "/").replace("period", ".").replace("space", "Space")
        out.append((keys, m.group(3)))
width = max(len(k) for k, _ in out) if out else 10
icons = {}
try:
    for line in open(sys.argv[2], encoding="utf-8"):
        if line.startswith("I_"):
            name, _, rest = line.partition("=")
            icons[name[2:]] = rest.split("'")[1]
except OSError:
    pass
rules = [("terminal", "terminal"), ("palette", "run"), ("keys", "keys"), ("browser", "browser"), ("file", "files"),
         ("audio", "audio"), ("network", "network"), ("notification", "notices"), ("emoji", "emoji"), ("clipboard", "clipboard"),
         ("close", "cancel"), ("fullscreen", "window"), ("float", "window"), ("pseudo", "window"), ("split", "window"),
         ("group", "tab"), ("tab", "tab"), ("lock", "lock"), ("power", "session"), ("quit", "logout"), ("edition", "edition"),
         ("display", "display"), ("backdrop", "backdrop"), ("finish", "finish"), ("record", "record"), ("annotate", "annotate"),
         ("screenshot", "screen"), ("workspace", "workspace"), ("focus", "move"), ("move", "move"), ("volume", "media_keys"),
         ("apps", "apps")]
for k, d in out:
    i = next((icons.get(v, "") for w, v in rules if w in d.lower()), icons.get("keys", ""))
    print(f"{i}  {k:<{width}}   {d}")
PY
}

cmd_keys() {
  if [ "${1:-}" = --text ] || [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then keys_list; return 0; fi
  keys_list | rofi_window "${I_keys-}  KEY REFERENCE" "KEY-03" -dmenu -i -p "FIND" -no-custom >/dev/null
  return 0
}

cmd_clipboard() {
  have cliphist || die "cliphist is not installed"
  cliphist list | rofi_window "${I_clipboard-}  CLIPBOARD" "CLP-04" -dmenu -i -p "PASTE" -display-columns 2 | cliphist decode | wl-copy
}


# ── shot and record ─────────────────────────────────────────────────────
dispatch() { hyprctl dispatch "$1" >/dev/null 2>&1; }

cmd_shot() {
  have grim || die "grim is not installed"
  local dir="$HOME/Pictures/Screenshots" f region
  mkdir -p "$dir"
  f="$dir/$(date +%Y%m%d-%H%M%S).png"
  case "${1:-region}" in
    region)
      region=$(slurp) || return 0
      grim -g "$region" "$f" && wl-copy < "$f" ;;
    screen)
      grim "$f" && wl-copy < "$f" ;;
    edit)
      region=$(slurp) || return 0
      grim -g "$region" - | satty --filename - --output-filename "$f" --copy-command wl-copy --early-exit
      return 0 ;;
    tour) shot_tour; return 0 ;;
    *) die "usage: fui shot [region|screen|edit|tour]" ;;
  esac
  cmd_sound screenshot
  note "SCREENSHOT" "saved and copied: ${f/#$HOME/\~}" applets-screenshooter
}

shot_tour() {   # a fixed set of screenshots for design reviews, in every edition
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || die "run the tour inside Hyprland"
  local dir ws start m i=1
  dir="$HOME/Pictures/fui/$(date +%Y%m%d-%H%M%S)"; mkdir -p "$dir"
  ws=$(hyprctl -j activeworkspace 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' 2>/dev/null || echo 1)
  start=$(current_mode)
  echo "Taking the tour shots; hands off for about a minute."
  snap() { sleep "${2:-1}"; grim "$dir/$(printf '%02d' "$i")-$1.png" && echo "  $1"; i=$((i + 1)); }
  for m in $(modes); do
    cmd_mode "$m" --quiet >/dev/null; sleep 2.5
    dispatch "hl.dsp.focus({ workspace = '$ws' })"; snap "$m-desktop" 1
    dispatch "hl.dsp.focus({ workspace = 'empty' })"; snap "$m-empty" 1.5
    detach rofi -config "$CFG/rofi/config.rasi" -show drun; snap "$m-launcher" 1.2; pkill -x rofi
    notify-send -a fui "NOTE · Scheduled maintenance" "A sample notice for the screenshot tour."; snap "$m-notification" 1
    swaync-client -op >/dev/null 2>&1; snap "$m-control-centre" 1.2; swaync-client -cp >/dev/null 2>&1
  done
  cmd_mode "$start" --quiet >/dev/null
  dispatch "hl.dsp.focus({ workspace = '$ws' })"
  echo "Saved in $dir"
}

cmd_record() {
  mkdir -p "$STATE"
  local running=0
  pgrep -x wf-recorder >/dev/null && running=1
  case "${1:-toggle}" in
    toggle) [ "$running" = 1 ] && cmd_record stop || cmd_record start ;;
    start)
      [ "$running" = 1 ] && return 0
      have wf-recorder || die "wf-recorder is not installed"
      local dir="$HOME/Videos/Recordings"; mkdir -p "$dir"
      local f; f="$dir/$(date +%Y%m%d-%H%M%S).mp4"
      date +%s > "$STATE/record-start"; echo "$f" > "$STATE/record-file"
      detach wf-recorder -f "$f"
      cmd_sound tick; note "RECORDING" "started (SUPER+R stops)" media-record ;;
    stop)
      [ "$running" = 1 ] || return 0
      pkill -INT -x wf-recorder
      cmd_sound tick; note "RECORDING" "saved: $(sed "s|$HOME|~|" "$STATE/record-file" 2>/dev/null)" media-playback-stop
      rm -f "$STATE/record-start" ;;
    status)   # JSON for the bar: shown only while recording
      if [ "$running" = 1 ]; then
        local now began s
        now=$(date +%s); began=$(cat "$STATE/record-start" 2>/dev/null || echo "$now"); s=$((now - began))
        printf '{"text": "%s REC %02d:%02d", "class": "recording", "tooltip": "click to stop"}\n' "${I_rec-}" $((s / 60)) $((s % 60))
      else
        echo '{"text": ""}'
      fi ;;
    *) die "usage: fui record [toggle|start|stop|status]" ;;
  esac
}


# ── brand ───────────────────────────────────────────────────────────────
os_logo() {   # the distribution's logo glyph (Nerd Font)
  local id=""
  [ -r /etc/os-release ] && id=$(. /etc/os-release && echo "${ID:-}")
  case "$id" in
    endeavouros) printf '\uf322' ;;
    arch) printf '\uf303' ;;
    manjaro) printf '\uf312' ;;
    fedora) printf '\uf30a' ;;
    debian) printf '\uf306' ;;
    ubuntu) printf '\uf31b' ;;
    *) printf '\uf17c' ;;
  esac
}

os_name() {   # the distribution's name, e.g. EndeavourOS
  local n=""
  [ -r /etc/os-release ] && n=$(. /etc/os-release && echo "${NAME:-${PRETTY_NAME:-}}")
  echo "${n:-Linux}"
}

host_name() { cat /etc/hostname 2>/dev/null || hostname 2>/dev/null || uname -n; }

# The workstation names itself by its machine: the distribution's logo, the host, the OS and
# the operator. (No company name or mark anywhere.)
cmd_brand() {
  case "${1:-}" in
    --badge)   # the bar's badge: the distribution's logo and the operator
      printf "<span font_family='JetBrainsMono Nerd Font' size='large'>%s</span>  %s\n" "$(os_logo)" "${USER:-$(id -un)}" ;;
    --logo) os_logo; echo ;;
    --host) host_name | tr '[:lower:]' '[:upper:]' ;;
    --os) os_name | tr '[:lower:]' '[:upper:]' ;;
    *) printf '%s · %s · %s\n' "$(host_name)" "$(os_name)" "${USER:-$(id -un)}" ;;
  esac
}


# ── version / rollback ──────────────────────────────────────────────────
cmd_version() {
  [ -d "$DOTS/.git" ] || { echo "unknown (no git checkout at $DOTS)"; return 0; }
  git -C "$DOTS" describe --tags --always 2>/dev/null
}

cmd_rollback() {   # go back to a tagged version; `fui update` returns to the newest
  [ -d "$DOTS/.git" ] || die "no git checkout at $DOTS"
  git -C "$DOTS" fetch -q --tags 2>/dev/null
  local tag="${1:-}"
  if [ -z "$tag" ]; then
    echo "Versions (newest first):"
    git -C "$DOTS" tag --sort=-creatordate | head -10 | sed 's/^/  /'
    echo "Now: $(cmd_version)"
    echo "Go back with: fui rollback <version>    Return to the newest with: fui update"
    return 0
  fi
  git -C "$DOTS" rev-parse -q --verify "refs/tags/$tag" >/dev/null || die "no version called $tag (fui rollback lists them)"
  if [ -n "$(git -C "$DOTS" status --porcelain)" ]; then
    die "files in $DOTS were changed on this machine; drop them first: git -C $DOTS checkout -- ."
  fi
  git -C "$DOTS" reset -q --hard "refs/tags/$tag" || return 1
  echo "Now at $tag. Re-linking..."
  bash "$DOTS/install.sh" --no-packages --no-hardware --no-chsh
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && hyprctl reload >/dev/null 2>&1
  return 0
}


# ── updates / update ────────────────────────────────────────────────────
cmd_updates() {
  local repo=0 aur=0
  have checkupdates && repo=$(checkupdates 2>/dev/null | wc -l | tr -d ' ')
  have yay && aur=$(yay -Qua 2>/dev/null | wc -l | tr -d ' ')
  local n=$((repo + aur))
  if [ "${1:-}" = --bar ]; then
    if [ "$n" -gt 0 ]; then
      printf '{"text": "<span alpha=\\"70%%\\">%s</span> %s", "class": "pending", "tooltip": "%s repo + %s AUR updates: click to update"}\n' "${I_updates-}" "$n" "$repo" "$aur"
    else
      echo '{"text": ""}'
    fi
  else
    echo "$n updates ($repo repo, $aur AUR)"
  fi
}

cmd_update() {
  [ -d "$DOTS/.git" ] || die "no git checkout at $DOTS"
  local before
  before=$(git -C "$DOTS" rev-parse HEAD)
  if ! git -C "$DOTS" pull --ff-only; then
    echo
    echo "The update stopped: files in $DOTS were changed on this machine."
    echo "See them:      git -C $DOTS status"
    echo "Drop them:     git -C $DOTS checkout -- . && fui update"
    return 1
  fi
  if [ "$before" = "$(git -C "$DOTS" rev-parse HEAD)" ]; then
    echo "Already up to date; re-running the installer to repair anything missing."
  else
    echo "New:"; git -C "$DOTS" log --oneline "$before..HEAD" | sed 's/^/  /'
  fi
  bash "$DOTS/install.sh" "$@"
  local rc=$?
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hyprctl reload >/dev/null 2>&1
    bar_start
    have swaync-client && swaync-client -R >/dev/null 2>&1 && swaync-client -rs >/dev/null 2>&1
    echo "Reloaded. Log out and back in (SUPER+SHIFT+E) for anything that still looks old."
  fi
  return $rc
}


# ── doctor ──────────────────────────────────────────────────────────────
D_OK=0; D_WARN=0; D_FAIL=0
FIXES=()
ok()   { D_OK=$((D_OK + 1));     printf '  %s [ OK ] %s\n' "${I_ok-}" "$*"; }
warn() { D_WARN=$((D_WARN + 1)); printf '  %s [WARN] %s\n' "${I_warn-}" "$*"; }
bad()  { D_FAIL=$((D_FAIL + 1)); printf '  %s [FAIL] %s\n' "${I_fail-}" "$*"; }
info() { printf '    %s      %s\n' "${I_info-}" "$*"; }
fix()  { FIXES+=("$1|$2"); printf '         fix: %s\n' "$2"; }   # <function> <description>
section() {   # a heading with its icon
  local i=""
  case "$1" in
    session) i="${I_desktop-}" ;; graphics) i="${I_gpu-}" ;; audio) i="${I_audio-}" ;; network) i="${I_network-}" ;;
    packages) i="${I_packages-}" ;; dotfiles) i="${I_dotfiles-}" ;; look) i="${I_look-}" ;; wallpaper) i="${I_backdrop-}" ;;
    disk) i="${I_storage-}" ;;
  esac
  printf '\n%s  %s\n' "$i" "$(upper "$1")"
}

stow_packages() { sed -e 's/#.*//' -e 's/[[:space:]]//g' "$DOTS/stow.txt" 2>/dev/null | grep -v '^$'; }

listed_packages() { sed -e 's/#.*//' -e 's/[[:space:]]//g' "$1" 2>/dev/null | grep -v '^$'; }

conflict_installed() {   # prints the installed package that conflicts with $1, if any
  local c
  for c in $(pacman -Si "$1" 2>/dev/null | sed -n 's/^Conflicts With *: *//p' | head -1); do
    c="${c%%[<>=]*}"
    [ "$c" != None ] && pacman -Qq "$c" >/dev/null 2>&1 && { echo "$c"; return 0; }
  done
  return 1
}

# one line per graphics device: "<lspci description>|<driver in use or none>"
gpu_lines() {
  lspci -nnk 2>/dev/null | awk '
    /^[^\t]/ { if (dev) print dev "|" (drv ? drv : "none"); dev = ""; drv = "" }
    /^[^\t]/ && /VGA|3D controller|Display controller/ { dev = $0 }
    /^\tKernel driver in use:/ { if (dev) drv = $NF }
    END { if (dev) print dev "|" (drv ? drv : "none") }'
}

fix_audio_output() { cmd_setup audio --yes; }
fix_audio_services() { systemctl --user enable --now pipewire pipewire-pulse wireplumber; }
fix_sound_on() { cmd_sound on; }
fix_links() { bash "$DOTS/install.sh" --no-packages --no-hardware --no-chsh; }
fix_mode_links() { cmd_display apply; cmd_mode apply --quiet; }
fix_packages() { bash "$DOTS/install.sh" --no-hardware --no-chsh; }
fix_gpu() { cmd_setup gpu; }
fix_bar() { bar_start; }
fix_mako() { pkill -x mako; sudo pacman -Rns --noconfirm mako; pgrep -x swaync >/dev/null || detach swaync; }
stale_links() {   # links into the dotfiles whose target no longer exists
  local l repo
  repo="$(basename "$DOTS")/"
  find "$CFG" "$HOME/.local/bin" -xtype l 2>/dev/null | while read -r l; do
    if [[ "$(readlink "$l")" == *"$repo"* ]]; then echo "$l"; fi
  done
}
fix_broken_links() {
  local l
  stale_links | while read -r l; do rm -f "$l" && echo "removed $l"; done
}

cmd_doctor() {
  local do_fix=0 a
  for a in "$@"; do [ "$a" = --fix ] && do_fix=1; done
  echo "fui doctor  $(date '+%Y-%m-%d %H:%M')  version $(cmd_version)"
  [ -r /etc/os-release ] && . /etc/os-release && echo "${PRETTY_NAME:-Linux}  kernel $(uname -r)"

  section "session"
  if have Hyprland; then
    local out
    if out=$(Hyprland --verify-config 2>&1); then
      ok "Hyprland config has no errors ($(Hyprland --version 2>/dev/null | head -1 | cut -c1-40))"
    else
      bad "Hyprland config has errors:"
      echo "$out" | grep -iE 'error|unknown|fail' | head -5 | sed 's/^/           /'
    fi
  else
    bad "Hyprland is not installed"
  fi
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && ok "running inside Hyprland" || info "not inside a Hyprland session: some checks skipped"

  section "graphics"
  local line dev drv any=0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    any=1; dev="${line%|*}"; drv="${line##*|}"
    dev=$(echo "$dev" | sed -E 's/^[0-9a-f:.]+ //; s/ \[[0-9a-f]{4}(:[0-9a-f]{4})?\]//g; s/ \(rev [0-9a-f]+\)//' | cut -c1-80)
    case "$drv" in
      none) bad "$dev: no driver loaded"; info "the screen runs in basic mode (low resolution, no acceleration)"; fix fix_gpu "fui setup gpu (then reboot)" ;;
      nouveau) warn "$dev: open-source nouveau driver (slow for Hyprland)"; fix fix_gpu "fui setup gpu: install the NVIDIA driver (then reboot)" ;;
      *) ok "$dev: driver $drv" ;;
    esac
  done < <(gpu_lines)
  [ "$any" = 1 ] || warn "no graphics card found by lspci (is pciutils installed?)"
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hyprctl -j monitors all 2>/dev/null | python3 -c '
import json, sys
for m in json.load(sys.stdin):
    modes = m.get("availableModes", [])
    print(f"{m[\"name\"]}|{m[\"width\"]}x{m[\"height\"]}@{round(m[\"refreshRate\"])}|{len(modes)}|{modes[0] if modes else \"\"}")
' 2>/dev/null | while IFS='|' read -r name cur n best; do
      if [ "${n:-0}" -le 1 ]; then
        warn "$name at $cur offers only one mode: usually means no proper graphics driver"
      else
        ok "$name at $cur ($n modes, best $best)"
      fi
    done
  fi

  section "audio"
  local svc
  for svc in pipewire wireplumber pipewire-pulse; do
    if systemctl --user is-active --quiet "$svc" 2>/dev/null; then ok "$svc running"
    else bad "$svc not running"; fix fix_audio_services "systemctl --user enable --now pipewire pipewire-pulse wireplumber"; break
    fi
  done
  if have pactl && pactl info >/dev/null 2>&1; then
    local sink vol others
    sink=$(pactl get-default-sink 2>/dev/null)
    vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -oE '[0-9]+%' | head -1)
    others=$(pactl list short sinks 2>/dev/null | awk '{print $2}' | grep -v -e "^$sink\$" -e hdmi | head -1)
    case "$sink" in
      *hdmi*|*HDMI*|*DisplayPort*)
        if [ -n "$others" ]; then warn "output is the monitor (HDMI/DisplayPort), which often has no speakers"; fix fix_audio_output "fui setup audio: switch to $others"
        else ok "output: $sink (the only one)"; fi ;;
      "") bad "no audio output found" ;;
      *) ok "output: $sink" ;;
    esac
    if pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -q yes; then
      warn "output is muted"; fix fix_audio_output "unmute and set 60%"
    elif [ "${vol%\%}" -lt 10 ] 2>/dev/null; then
      warn "volume is $vol"; fix fix_audio_output "set 60%"
    else
      ok "volume $vol"
    fi
  else
    info "pactl can't reach the audio server: output checks skipped"
  fi
  if [ -f "$HOME/.local/share/sounds/fui/index.theme" ]; then ok "the fui sound theme is installed"
  elif [ -d /usr/share/sounds/freedesktop ]; then warn "the fui sound theme isn't linked; freedesktop sounds are used"; fix fix_links "re-link the dotfiles"
  else bad "no sound theme installed"; fix fix_packages "install the package list"; fi
  [ "$(cmd_sound status)" = off ] && { warn "desktop sounds are turned off"; fix fix_sound_on "fui sound on"; }

  if pgrep -x mako >/dev/null; then
    warn "mako (the old notification daemon) is running; swaync shows notifications now"; fix fix_mako "stop mako and remove it"
  elif pacman -Qq mako >/dev/null 2>&1; then
    info "mako is still installed (unused): sudo pacman -Rns mako"
  fi

  section "network"
  if have nmcli; then
    case "$(nmcli networking connectivity 2>/dev/null)" in
      full) ok "online" ;;
      limited|portal) warn "limited connectivity (captive portal or no internet)" ;;
      *) bad "offline"; info "connect with: fui tui nmtui  (or SUPER+SHIFT+N)" ;;
    esac
  else
    warn "NetworkManager (nmcli) not installed"
  fi

  section "packages"
  if have pacman; then
    local p missing="" alt=""
    while IFS= read -r p; do
      pacman -Qq "$p" >/dev/null 2>&1 && continue
      local c; c=$(conflict_installed "$p") && { alt="$alt $p→$c"; continue; }
      missing="$missing $p"
    done < <(listed_packages "$DOTS/packages.txt")
    [ -z "$missing" ] && ok "all repo packages installed" || { bad "missing:$missing"; fix fix_packages "install the package list"; }
    [ -n "$alt" ] && info "using installed alternatives:$alt"
    missing=""
    while IFS= read -r p; do pacman -Qq "$p" >/dev/null 2>&1 || missing="$missing $p"; done < <(listed_packages "$DOTS/aur.txt")
    [ -z "$missing" ] && ok "AUR packages installed" || { warn "AUR packages missing:$missing"; info "install with: yay -S$missing"; }
  fi

  section "dotfiles"
  if [ -d "$DOTS" ]; then
    local pkg f rel nmiss=0 first=""
    while IFS= read -r pkg; do
      while IFS= read -r f; do
        rel="${f#"$DOTS/$pkg/"}"
        if [ "$(readlink -f "$HOME/$rel" 2>/dev/null)" != "$(readlink -f "$f")" ]; then
          nmiss=$((nmiss + 1)); [ -n "$first" ] || first="$rel"
        fi
      done < <(find "$DOTS/$pkg" -type f 2>/dev/null)
    done < <(stow_packages)
    [ "$nmiss" = 0 ] && ok "every config file is linked" || { bad "$nmiss config files not linked (e.g. ~/$first)"; fix fix_links "re-link the dotfiles"; }
    local broken
    broken=$(stale_links | wc -l | tr -d ' ')
    [ "$broken" = 0 ] && ok "no broken links" || { warn "$broken links point at files that no longer exist"; fix fix_broken_links "remove them"; }
    local l nml=0
    for l in waybar/fui-colors.css waybar/fui-tier.css waybar/fui-alert.css rofi/fui-colors.rasi rofi/fui-tier.rasi \
             swaync/fui-colors.css swaync/fui-tier.css swayosd/fui-colors.css hypr/fui-colors.conf hypr/fui-tier.conf \
             kitty/fui-colors.conf kitty/fui-console.conf kitty/fui-tier.conf gtk-3.0/fui-mode.css gtk-3.0/fui-tier.css \
             gtk-4.0/fui-mode.css gtk-4.0/fui-tier.css btop/themes/fui.theme mpv/fui-colors.conf zathura/fui-colors \
             imv/config satty/config.toml waybar/fui-look.css swaync/fui-look.css swayosd/fui-look.css \
             rofi/fui-look.rasi hypr/fui-look-lock.conf labwc/rc.xml; do
      [ -e "$CFG/$l" ] || nml=$((nml + 1))
    done
    [ "$nml" = 0 ] && ok "$(current_look) look, $(current_mode) edition and $(current_tier) tier links in place" || { bad "$nml theme links missing"; fix fix_mode_links "fui mode apply"; }
    if [ -d "$DOTS/.git" ]; then
      local dirty behind
      dirty=$(git -C "$DOTS" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
      [ "$dirty" = 0 ] && ok "no local changes in $DOTS" || warn "$dirty files changed locally in $DOTS (fui update will refuse until they're dropped or committed)"
      if timeout 8 git -C "$DOTS" fetch -q 2>/dev/null; then
        behind=$(git -C "$DOTS" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)
        [ "$behind" = 0 ] && ok "up to date with GitHub" || warn "$behind updates available: run fui update"
      else
        info "couldn't reach GitHub to check for updates"
      fi
    fi
  else
    bad "no dotfiles at $DOTS"
  fi
  local face
  for face in "JetBrainsMono Nerd Font" "Inter" "Michroma" "Noto Sans"; do
    fc-list 2>/dev/null | grep -qi "$face" && ok "font: $face" || { bad "font missing: $face"; fix fix_links "re-link the dotfiles and rebuild the font cache"; }
  done

  section "look"
  info "look: $(current_look) (SUPER+CTRL+T)   edition: $(current_mode) (SUPER+SHIFT+T)   screen finish: $(cmd_screen status) (SUPER+SHIFT+C)"
  info "display tier: $(cmd_display status) (SUPER+SHIFT+D)"
  [ "$(cmd_alert status)" = on ] && warn "the alert takeover is on ($(cat "$STATE/alert-source" 2>/dev/null || echo manual)): fui alert off clears it"
  local nbar; nbar=$(pgrep -cx waybar 2>/dev/null || echo 0)
  if [ "${nbar:-0}" -gt 1 ]; then warn "$nbar bars are running"; fix fix_bar "restart the bar (fui bar)"
  elif [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ "${nbar:-0}" = 0 ]; then warn "the bar is not running"; fix fix_bar "start it (fui bar)"
  elif [ "${nbar:-0}" = 1 ]; then ok "one bar running"; fi
  if have plymouth-set-default-theme; then
    [ "$(plymouth-set-default-theme 2>/dev/null)" = fui ] && ok "boot splash: fui" || info "boot splash not set up: fui setup boot"
  else
    info "boot splash not set up: fui setup boot"
  fi
  if systemctl is-enabled --quiet greetd.service 2>/dev/null && grep -q regreet /etc/greetd/config.toml 2>/dev/null; then
    ok "login screen: greetd + ReGreet"
  else
    info "no login screen yet (the machine boots to a text prompt): fui setup boot"
  fi
  local prof themed=0
  while IFS= read -r prof; do [ -e "$prof/chrome/userChrome.css" ] && themed=1; done < <(firefox_profiles)
  [ "$themed" = 1 ] && ok "Firefox is themed" || info "Firefox not themed yet: fui setup firefox (after opening Firefox once)"

  section "wallpaper"
  local pref; pref=$(cat "$STATE/wallpaper" 2>/dev/null || echo live)
  info "set to: $pref (SUPER+SHIFT+W switches)"
  if pgrep -x mpvpaper >/dev/null; then ok "live wallpaper playing"
  elif pgrep -x swaybg >/dev/null; then
    if [ "$pref" = live ]; then
      if pgrep -f "make-wallpaper.py --live" >/dev/null; then info "still image shown while the live loop renders"
      elif ! have mpvpaper; then warn "mpvpaper not installed: still image only"; info "install with: yay -S mpvpaper"
      else warn "live wallpaper not running"; [ -s "$CACHE/render.log" ] && tail -n 3 "$CACHE/render.log" | sed 's/^/           /'
        [ -s "$CACHE/mpvpaper.log" ] && tail -n 3 "$CACHE/mpvpaper.log" | sed 's/^/           /'
      fi
    else ok "still wallpaper shown"; fi
  else
    [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && warn "no wallpaper program running (fui wallpaper start)"
  fi

  section "disk"
  local use; use=$(df -P / 2>/dev/null | awk 'NR==2 {print $5}')
  [ "${use%\%}" -lt 90 ] 2>/dev/null && ok "root filesystem ${use} full" || warn "root filesystem ${use} full"

  printf '\n%s ok, %s warnings, %s problems\n' "$D_OK" "$D_WARN" "$D_FAIL"
  if [ ${#FIXES[@]} -gt 0 ]; then
    if [ "$do_fix" = 1 ]; then
      local item fn done_list=""
      for item in "${FIXES[@]}"; do
        fn="${item%%|*}"
        case " $done_list " in *" $fn "*) continue ;; esac
        done_list="$done_list $fn"
        echo; echo "fixing: ${item#*|}"
        "$fn"
      done
      echo; echo "Done. Run fui doctor again to check."
    else
      echo "Run fui doctor --fix to apply the fixes listed above."
    fi
  fi
  [ "$D_FAIL" = 0 ]
}



# ── setup (hardware) ────────────────────────────────────────────────────
confirm() {   # confirm "question": yes when --yes was given or the answer is y
  [ "$YES" = 1 ] && return 0
  [ -t 0 ] || return 1
  local r; read -r -p "  $1 [y/N] " r
  case "$r" in y|Y|yes) return 0 ;; *) return 1 ;; esac
}

setup_gpu() {
  echo "${I_gpu-■} graphics driver"
  local ids found=0
  ids=$(lspci -nn 2>/dev/null | grep -E 'VGA|3D controller|Display controller' | grep -oE '\[[0-9a-f]{4}:[0-9a-f]{4}\]' | cut -c2-5)
  if echo "$ids" | grep -q 10de; then
    found=1
    if lspci -nnk | grep -A3 -E 'VGA|3D' | grep -q 'Kernel driver in use: nvidia'; then
      echo "  NVIDIA driver already loaded"
    elif have nvidia-inst; then
      echo "  NVIDIA card: EndeavourOS's nvidia-inst picks the right driver for it."
      confirm "Run sudo nvidia-inst now?" && sudo nvidia-inst && echo "  Reboot to use the new driver: systemctl reboot"
    else
      echo "  NVIDIA card, but nvidia-inst isn't available: install it with sudo pacman -S nvidia-inst"
    fi
    local lc="$CFG/hypr/local.lua"
    if [ -f "$lc" ] && ! grep -q LIBVA_DRIVER_NAME "$lc"; then
      printf '\n-- NVIDIA (added by fui setup)\nhl.env("LIBVA_DRIVER_NAME", "nvidia")\nhl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")\nhl.env("NVD_BACKEND", "direct")\n' >> "$lc"
      echo "  added the NVIDIA settings to ~/.config/hypr/local.lua"
    fi
  fi
  if echo "$ids" | grep -q 1002; then
    found=1; echo "  AMD graphics: mesa + Vulkan"
    sudo pacman -S --needed --noconfirm mesa vulkan-radeon
  fi
  if echo "$ids" | grep -q 8086; then
    found=1; echo "  Intel graphics: mesa + Vulkan + video decoding"
    sudo pacman -S --needed --noconfirm mesa vulkan-intel intel-media-driver
  fi
  [ "$found" = 1 ] || echo "  no NVIDIA, AMD or Intel graphics found (virtual machine?): nothing to do"
}

setup_audio() {
  echo "${I_audio-■} audio output"
  have pactl && pactl info >/dev/null 2>&1 || { echo "  audio server not reachable (run this inside the desktop)"; return 0; }
  local sink alt
  sink=$(pactl get-default-sink 2>/dev/null)
  case "$sink" in
    *hdmi*|*HDMI*|*DisplayPort*)
      alt=$(pactl list short sinks | awk '{print $2}' | grep -v -e hdmi -e HDMI | head -1)
      if [ -n "$alt" ]; then
        pactl set-default-sink "$alt" && echo "  output: $sink -> $alt"
      else
        echo "  the monitor is the only output: plug speakers or headphones into the PC to get another"
      fi ;;
    *) echo "  output: $sink" ;;
  esac
  pactl set-sink-mute @DEFAULT_SINK@ 0
  local vol; vol=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oE '[0-9]+%' | head -1)
  [ "${vol%\%}" -lt 10 ] 2>/dev/null && pactl set-sink-volume @DEFAULT_SINK@ 60%
  echo "  unmuted, volume $(pactl get-sink-volume @DEFAULT_SINK@ | grep -oE '[0-9]+%' | head -1)"
}

setup_bluetooth() {
  echo "${I_bluetooth-■} Bluetooth"
  if [ -z "$(ls /sys/class/bluetooth 2>/dev/null)" ]; then
    echo "  no Bluetooth adapter: nothing to do"; return 0
  fi
  sudo pacman -S --needed --noconfirm bluez bluez-utils bluetui && sudo systemctl enable --now bluetooth.service
  echo "  ready: run bluetui to pair devices"
}

setup_firmware() {
  echo "${I_tools-■} firmware updates"
  sudo pacman -S --needed --noconfirm fwupd
  echo "  check for BIOS / device firmware: fwupdmgr refresh && fwupdmgr get-updates"
}


setup_system() {
  echo "${I_packages-■} system services"
  # passwords for browsers and apps: the secret service starts on demand (no PAM changes)
  sudo pacman -S --needed --noconfirm gnome-keyring libsecret >/dev/null && echo "  keyring: gnome-keyring (unlocks on first use)"
  # firewall: keep firewalld if it is already running, otherwise ufw denying incoming connections
  if systemctl is-active --quiet firewalld 2>/dev/null; then
    echo "  firewall: firewalld is already running"
  elif have ufw || sudo pacman -S --needed --noconfirm ufw >/dev/null; then
    sudo ufw default deny incoming >/dev/null && sudo ufw default allow outgoing >/dev/null &&
      sudo ufw --force enable >/dev/null && sudo systemctl enable --now ufw.service >/dev/null 2>&1 &&
      echo "  firewall: ufw (incoming blocked, outgoing allowed)"
  fi
  # the package cache: keep the last three versions, cleaned weekly
  sudo systemctl enable --now paccache.timer >/dev/null 2>&1 && echo "  package cache: cleaned weekly (paccache.timer)"
  have xdg-user-dirs-update && xdg-user-dirs-update && echo "  home folders: Documents, Downloads, Pictures, Videos, ..."
  mkdir -p "$HOME/Pictures/Screenshots" "$HOME/Videos/Recordings"
}

setup_firefox() {
  echo "${I_browser-■} Firefox"
  have firefox || { echo "  Firefox is not installed"; return 0; }
  local profs
  profs=$(firefox_profiles)
  if [ -z "$profs" ]; then
    echo "  creating a profile"
    firefox --headless -CreateProfile default-release >/dev/null 2>&1
    profs=$(firefox_profiles)
  fi
  [ -n "$profs" ] || { echo "  no profile yet: open Firefox once, then run fui setup firefox"; return 0; }
  render_startpage
  local prof src="$CFG/fui/firefox"
  while IFS= read -r prof; do
    [ -d "$prof" ] || continue
    mkdir -p "$prof/chrome"
    ln -sfn "$src/userChrome.css" "$prof/chrome/userChrome.css"
    ln -sfn "$src/userContent.css" "$prof/chrome/userContent.css"
    ln -sfn "$src/colors-$(current_mode).css" "$prof/chrome/fui-colors.css"
    ln -sfn "$src/tier-$(current_tier).css" "$prof/chrome/fui-tier.css"
    sed "s|@START@|file://$SHARE/start.html|g" "$src/user.js.in" > "$prof/user.js"
    echo "  themed: ${prof/#$HOME/\~} (restart Firefox to see it)"
  done <<< "$profs"
}

boot_modes() {   # video=<output>:<WxH@R> on the kernel command line for every screen without an EDID
  [ -f /etc/kernel/cmdline ] || return 0
  local want out mode c args
  want=$(hyprctl -j monitors 2>/dev/null | python3 -c '
import json, sys
try:
    for m in json.load(sys.stdin):
        print(m["name"], "%dx%d@%d" % (m["width"], m["height"], round(m["refreshRate"])))
except Exception:
    pass')
  [ -n "$want" ] || { echo "  screen modes: open a Hyprland session to carry its modes to boot"; return 0; }
  args=$(cat /etc/kernel/cmdline)
  while read -r out mode; do
    c=$(ls -d /sys/class/drm/card*-"$out" 2>/dev/null | head -1)
    [ -n "$c" ] && [ ! -s "$c/edid" ] || continue
    args=$(printf '%s\n' "$args" | sed -E "s/ ?video=$out:[^ ]*//g")
    args="$args video=$out:$mode"
    echo "  boot mode: $out at $mode (it sends no EDID)"
  done <<< "$want"
  if [ "$args" != "$(cat /etc/kernel/cmdline)" ]; then
    [ -f /etc/kernel/cmdline.fui-backup ] || sudo cp /etc/kernel/cmdline /etc/kernel/cmdline.fui-backup
    printf '%s\n' "$args" | sudo tee /etc/kernel/cmdline >/dev/null
  fi
}

setup_boot() {
  echo "${I_session-■} boot splash, login screen and consoles"
  have python3 || { echo "  python3 is needed"; return 1; }
  sudo pacman -S --needed --noconfirm plymouth terminus-font greetd greetd-regreet cage >/dev/null || return 1
  local tmp ed tier w h
  tmp=$(mktemp -d); ed=$(current_mode); tier=$(current_tier)
  read -r w h < <(screen_size)
  python3 "$DOTS/theme/make-boot.py" --edition "$ed" --tier "$tier" --size "${w:-1920}x${h:-1080}" "$tmp" ||
    { echo "  couldn't render the splash and login screen"; rm -rf "$tmp"; return 1; }

  # the splash: the survey field fading in, traces running along it
  sudo rm -rf /usr/share/plymouth/themes/fui
  sudo mkdir -p /usr/share/plymouth/themes/fui && sudo cp -r "$tmp/plymouth/." /usr/share/plymouth/themes/fui/ || return 1
  sudo plymouth-set-default-theme fui && echo "  splash: fui ($ed)"
  # kernel command line: quiet boot with the splash
  if [ -f /etc/kernel/cmdline ]; then
    if ! grep -qw splash /etc/kernel/cmdline; then
      sudo cp /etc/kernel/cmdline /etc/kernel/cmdline.fui-backup
      sudo sed -i 's/$/ quiet splash loglevel=3 rd.udev.log_level=3 vt.global_cursor_default=0/' /etc/kernel/cmdline
      echo "  kernel command line: quiet splash (backup: /etc/kernel/cmdline.fui-backup)"
    fi
  else
    echo "  /etc/kernel/cmdline not found: add 'quiet splash' to your boot entry by hand"
  fi
  # a screen behind an adapter to VGA sends no EDID, so the kernel only offers its fallback
  # modes (60 Hz, up to 1024x768) and the splash and the login screen take the first one.
  # Hand the kernel the mode the desktop runs at, so all three match (and a tube doesn't
  # flicker at 60 Hz when the desktop runs it faster).
  boot_modes
  # rebuild the boot images so they carry the splash
  if have reinstall-kernels; then sudo reinstall-kernels && echo "  boot images rebuilt (reinstall-kernels)"
  elif have dracut-rebuild; then sudo dracut-rebuild && echo "  boot images rebuilt (dracut-rebuild)"
  elif have mkinitcpio; then sudo mkinitcpio -P && echo "  boot images rebuilt (mkinitcpio)"
  else echo "  rebuild your initramfs to include the splash"; fi
  # boot menu hidden unless a key is held (systemd-boot)
  have bootctl && sudo bootctl set-timeout 0 >/dev/null 2>&1 && echo "  boot menu: hidden (hold Space while booting to show it)"

  # the login screen: greetd runs ReGreet (in cage) on the first console, so the machine boots
  # straight into a graphical sign-in instead of a text prompt
  [ -f /etc/greetd/config.toml ] && [ ! -f /etc/greetd/config.toml.fui-backup ] &&
    sudo cp /etc/greetd/config.toml /etc/greetd/config.toml.fui-backup
  sudo install -Dm644 "$tmp/greeter/config.toml" /etc/greetd/config.toml
  sudo install -Dm644 "$tmp/greeter/regreet.toml" /etc/greetd/regreet.toml
  sudo install -Dm644 "$tmp/greeter/regreet.css" /etc/greetd/regreet.css
  sudo install -Dm644 "$tmp/greeter/background.png" /usr/share/fui/greeter/background.png
  # the greeter runs as its own user: the brand face must be a system font
  sudo install -Dm644 "$DOTS/fui/.local/share/fonts/fui/Michroma-Regular.ttf" /usr/share/fonts/fui/Michroma-Regular.ttf 2>/dev/null &&
    sudo fc-cache -f >/dev/null 2>&1
  local dm
  dm=$(systemctl show -p Id --value display-manager.service 2>/dev/null)
  if [ -n "$dm" ] && [ "$dm" != greetd.service ] && [ "$dm" != display-manager.service ]; then
    sudo systemctl disable "$dm" >/dev/null 2>&1 && echo "  $dm turned off (greetd replaces it)"
  fi
  sudo systemctl enable greetd.service >/dev/null 2>&1 && echo "  login screen: greetd + ReGreet ($ed)"

  # text consoles: the console palette, a clean font, the sign-in banner
  sudo install -m 644 "$tmp/console/issue" /etc/issue
  sudo install -m 644 "$tmp/console/vtrgb" /etc/vtrgb
  sudo install -m 644 "$tmp/console/fui-vtrgb.service" /etc/systemd/system/fui-vtrgb.service
  sudo systemctl enable fui-vtrgb.service >/dev/null 2>&1
  if grep -q '^FONT=' /etc/vconsole.conf 2>/dev/null; then
    sudo sed -i 's/^FONT=.*/FONT=ter-v18n/' /etc/vconsole.conf
  else
    echo "FONT=ter-v18n" | sudo tee -a /etc/vconsole.conf >/dev/null
  fi
  echo "  consoles: console palette, Terminus 18, sign-in banner"
  rm -rf "$tmp"
  echo "  reboot to see it: systemctl reboot (fui setup boot again after changing the edition restyles it)"
}

cmd_setup() {
  YES=0
  local what="all" a
  for a in "$@"; do case "$a" in --yes|-y) YES=1 ;; gpu|audio|bluetooth|firmware|system|firefox|boot|all) what="$a" ;; esac; done
  case "$what" in
    gpu) setup_gpu ;;
    audio) setup_audio ;;
    bluetooth) setup_bluetooth ;;
    firmware) setup_firmware ;;
    system) setup_system ;;
    firefox) setup_firefox ;;
    boot) setup_boot ;;
    all) setup_gpu; setup_audio; setup_bluetooth; setup_firmware; setup_system; setup_firefox ;;
  esac
}


# ── main ────────────────────────────────────────────────────────────────
sub="${1:-help}"
[ $# -gt 0 ] && shift
case "$sub" in
  mode)      cmd_mode "$@" ;;
  look)      cmd_look "$@" ;;
  skin)      cmd_skin "$@" ;;
  display)   cmd_display "$@" ;;
  alert)     cmd_alert "$@" ;;
  watch)     cmd_watch "$@" ;;
  idle)      cmd_idle "$@" ;;
  lockclock) cmd_lockclock "$@" ;;
  wallpaper) cmd_wallpaper "$@" ;;
  screen)    cmd_screen "$@" ;;
  sound)     cmd_sound "$@" ;;
  bar)       cmd_bar "$@" ;;
  tabs)      cmd_tabs "$@" ;;
  layout)    cmd_layout "$@" ;;
  tui)       cmd_tui "$@" ;;
  palette)   cmd_palette "$@" ;;
  power)     cmd_power "$@" ;;
  keys)      cmd_keys "$@" ;;
  clipboard) cmd_clipboard "$@" ;;
  shot)      cmd_shot "$@" ;;
  record)    cmd_record "$@" ;;
  updates)   cmd_updates "$@" ;;
  brand)     cmd_brand "$@" ;;
  version)   cmd_version "$@" ;;
  rollback)  cmd_rollback "$@" ;;
  update)    cmd_update "$@" ;;
  doctor)    cmd_doctor "$@" ;;
  setup)     cmd_setup "$@" ;;
  help|-h|--help) usage ;;
  *) echo "fui: unknown command '$sub'" >&2; usage >&2; exit 2 ;;
esac
