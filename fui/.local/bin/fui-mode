#!/usr/bin/env bash
# HUD // fui-mode: switch the whole desktop between dark and light.
#
#   fui-mode toggle         switch (SUPER+SHIFT+T, or click MODE in the bar)
#   fui-mode dark | light   pick one
#   fui-mode apply          re-link the current mode without reloading anything
#                           (run at login and by install.sh)
#   fui-mode status         print the current mode   (--bar: formatted for waybar)
#
# How it works: theme/build.py writes every themed file twice, the dark original and
# a light copy ("-light"). Each app reads a fui-mode.* link that sits next to them;
# this script points those links at one set, then asks running apps to reload.
# The mode itself is one word in ~/.local/state/fui/mode.
set -u

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/fui"
state="$state_dir/mode"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"

current=$(cat "$state" 2>/dev/null)
[ "$current" = light ] || current=dark

cmd="${1:-status}"
quiet=0
for a in "$@"; do [ "$a" = --quiet ] && quiet=1; done

case "$cmd" in
  status)
    if [ "${2:-}" = --bar ]; then
      echo "<span alpha='55%' size='small' letter_spacing='2048'>MODE</span> $(echo "$current" | tr a-z A-Z)"
    else
      echo "$current"
    fi
    exit 0 ;;
  toggle) [ "$current" = dark ] && new=light || new=dark ;;
  dark|light) new="$cmd" ;;
  apply) new="$current" ;;
  *) echo "usage: fui-mode [toggle|dark|light|apply|status]" >&2; exit 2 ;;
esac

mkdir -p "$state_dir"
[ "$new" = "$current" ] && [ -e "$state" ] || echo "$new" > "$state"

# link <dir> <dark file> <light file> <link name>: point the link at this mode's file.
# Only touches the link when it changes, so running apply often is harmless.
link() {
  local dir="$1" target="$2"
  [ "$new" = light ] && target="$3"
  [ -e "$dir/$target" ] || return 0
  [ "$(readlink "$dir/$4" 2>/dev/null)" = "$target" ] || ln -sfn "$target" "$dir/$4"
}

link "$cfg/kitty"   colors.conf        colors-light.conf        fui-mode.conf
link "$cfg/waybar"  style.css          style-light.css          fui-mode.css
link "$cfg/rofi"    config.rasi        config-light.rasi        fui-mode.rasi
link "$cfg/mako"    config             config-light             fui-mode
link "$cfg/hypr"    hyprlock.conf      hyprlock-light.conf      fui-mode-hyprlock.conf
link "$cfg/gtk-3.0" fui.css            fui-light.css            fui-mode.css
link "$cfg/gtk-4.0" fui.css            fui-light.css            fui-mode.css
link "$cfg/fui"     term.sh            term-light.sh            fui-mode.sh
link "$cfg/fui"     ../starship.toml   ../starship-light.toml   starship.toml
link "$cfg/git"     fui-colors.gitconfig fui-colors-light.gitconfig fui-mode.gitconfig

# Qt and btop keep the theme path inside their own config file
sfx=""; [ "$new" = light ] && sfx="-light"
if [ -f "$cfg/qt6ct/qt6ct.conf" ]; then
  sed -i -E "s|(colors/fui)[^/]*\.conf|\1$sfx.conf|; s|(qss/fui)[^/]*\.qss|\1$sfx.qss|" "$cfg/qt6ct/qt6ct.conf"
fi
if [ -f "$cfg/btop/btop.conf" ]; then
  sed -i -E "s|^color_theme = .*|color_theme = \"hud$sfx\"|" "$cfg/btop/btop.conf"
fi

[ "$cmd" = apply ] && exit 0

# ── tell running apps ───────────────────────────────────────────────────
# base GTK theme and icons come from the tokens ([desktop] / [light.desktop])
gtk=$(python3 -c '
import json, sys
t = json.load(open(sys.argv[2]))
d = dict(t["desktop"])
if sys.argv[1] == "light":
    d.update(t.get("light", {}).get("desktop", {}))
print(d["gtk_base"], d["icon_theme"])
' "$new" "$cfg/fui/tokens.json" 2>/dev/null)
icons="${gtk#* }"; gtk="${gtk%% *}"
if [ -z "${gtk:-}" ]; then
  if [ "$new" = light ]; then gtk=adw-gtk3; icons=Papirus-Light; else gtk=adw-gtk3-dark; icons=Papirus-Dark; fi
fi
if command -v gsettings >/dev/null; then
  gsettings set org.gnome.desktop.interface color-scheme "prefer-$new"
  gsettings set org.gnome.desktop.interface gtk-theme "$gtk"
  gsettings set org.gnome.desktop.interface icon-theme "$icons"
fi
pkill -USR1 -x kitty 2>/dev/null           # kitty re-reads kitty.conf
pkill -USR2 -x waybar 2>/dev/null          # waybar re-reads its style
command -v makoctl >/dev/null && makoctl reload 2>/dev/null
command -v hyprctl >/dev/null && hyprctl reload >/dev/null 2>&1   # borders, glow, blur
if [ -x "$HOME/.local/bin/fui-wallpaper" ]; then
  setsid -f "$HOME/.local/bin/fui-wallpaper" start >/dev/null 2>&1
fi

[ -x "$HOME/.local/bin/fui-sound" ] && "$HOME/.local/bin/fui-sound" mode
[ "$quiet" = 1 ] || { command -v notify-send >/dev/null && notify-send -t 2000 "MODE" "$(echo "$new" | tr a-z A-Z)"; }
exit 0
