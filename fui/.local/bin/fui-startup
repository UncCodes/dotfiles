#!/usr/bin/env bash
# HUD // fui-startup: open the prepared terminal tabs (a kitty session).
#
# Runs at login and on SUPER+SHIFT+Return. The tabs are listed in
# ~/.config/kitty/startup.session; edit that file to change them.
# A machine-only version can go in ~/.config/kitty/startup.session.local (ignored by
# git, used instead when present). An empty startup.session.local turns them off.
dir="${XDG_CONFIG_HOME:-$HOME/.config}/kitty"
session="$dir/startup.session.local"
[ -e "$session" ] || session="$dir/startup.session"
[ -s "$session" ] || exit 0
exec kitty --class fui-main --session "$session"
