#!/usr/bin/env bash
# HUD // fui-sound: desktop event sounds.
#
#   fui-sound <event>     login | logout | message | alert | volume | screenshot | mode | error
#                         (or any sound name from the theme, e.g. device-added)
#   fui-sound on | off    turn the sounds on or off (remembered)
#   fui-sound status
#
# The theme is [desktop] sound_theme in tokens.toml: Ocean, the sound theme EndeavourOS's
# KDE edition uses (EndeavourOS has none of its own). Missing sounds fall back to the
# freedesktop set. Hyprland plays login, volume and screenshot sounds; mako plays the
# notification sounds; fui-mode plays the mode switch.
set -u

state="${XDG_STATE_HOME:-$HOME/.local/state}/fui/sound"
case "${1:-}" in
  on|off) mkdir -p "$(dirname "$state")"; echo "$1" > "$state"; exit 0 ;;
  status) cat "$state" 2>/dev/null || echo on; exit 0 ;;
  "") echo "usage: fui-sound <event>|on|off|status" >&2; exit 2 ;;
esac
[ "$(cat "$state" 2>/dev/null)" = off ] && exit 0

case "$1" in
  login)      names="desktop-login service-login" ;;
  logout)     names="desktop-logout service-logout" ;;
  message)    names="message-new-instant message" ;;
  alert)      names="dialog-warning dialog-error" ;;
  volume)     names="audio-volume-change" ;;
  screenshot) names="screen-capture camera-shutter" ;;
  mode)       names="button-pressed dialog-information" ;;
  error)      names="dialog-error" ;;
  *)          names="$1" ;;
esac

theme=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["desktop"].get("sound_theme","ocean"))' \
        "${XDG_CONFIG_HOME:-$HOME/.config}/fui/tokens.json" 2>/dev/null)
theme="${theme:-ocean}"

file=""
for n in $names; do
  for t in "$theme" freedesktop; do
    for d in "$HOME/.local/share/sounds" /usr/share/sounds; do
      for f in "$d/$t/stereo/$n".{oga,ogg,wav} "$d/$t/$n".{oga,ogg,wav}; do
        [ -f "$f" ] && { file="$f"; break 4; }
      done
    done
  done
done
[ -n "$file" ] || exit 0

# at login the audio server may not have an output yet: wait up to 15 s for one
if [ "$1" = login ] && command -v wpctl >/dev/null; then
  for _ in $(seq 30); do
    wpctl inspect @DEFAULT_AUDIO_SINK@ >/dev/null 2>&1 && break
    sleep 0.5
  done
fi

# volume key repeats: cut the previous blip instead of stacking them
[ "$1" = volume ] && pkill -f "pw-play .*audio-volume-change" 2>/dev/null

if command -v pw-play >/dev/null; then
  setsid -f pw-play --volume 0.7 "$file" >/dev/null 2>&1
elif command -v paplay >/dev/null; then
  setsid -f paplay "$file" >/dev/null 2>&1
fi
exit 0
