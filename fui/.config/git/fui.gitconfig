# GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file.
# Included from ~/.gitconfig by install.sh: ANSI colours, so git follows the console.
[color]
	ui = auto
[color "diff"]
	meta = 8
	frag = 6
	func = 8
	commit = 3
	old = 1
	new = 2
	whitespace = 1 reverse
[color "status"]
	header = 8
	branch = 6 bold
	added = 2
	changed = 3
	untracked = 5
[color "branch"]
	current = 6 bold
	local = 7
	remote = 4
[color "decorate"]
	HEAD = 6 bold
	branch = 6
	remoteBranch = 4
	tag = 3
