# GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file.
# Included from ~/.gitconfig by install.sh: the console palette.
[color]
	ui = auto
[color "diff"]
	meta = #7D8894
	frag = #00C2D1
	func = #7D8894
	commit = #F2A93B
	old = #FF5C6C
	new = #3DDC97
	whitespace = #FF5C6C reverse
[color "status"]
	header = #7D8894
	branch = #00C2D1 bold
	added = #3DDC97
	changed = #F2A93B
	untracked = #B78CFF
[color "branch"]
	current = #00C2D1 bold
	local = #D7DEE5
	remote = #5B8CFF
[color "decorate"]
	HEAD = #00C2D1 bold
	branch = #00C2D1
	remoteBranch = #5B8CFF
	tag = #F2A93B
