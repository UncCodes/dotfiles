# GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file.
# Included from ~/.gitconfig by install.sh: the CRT palette.
[color]
	ui = auto
[color "diff"]
	meta = #8A8A8A
	frag = #56D4DD
	func = #8A8A8A
	commit = #E5C07B
	old = #FF6B6B
	new = #5FD75F
	whitespace = #FF6B6B reverse
[color "status"]
	header = #8A8A8A
	branch = #5FD75F bold
	added = #5FD75F
	changed = #E5C07B
	untracked = #C678DD
[color "branch"]
	current = #5FD75F bold
	local = #D4D4D4
	remote = #6AB0FF
[color "decorate"]
	HEAD = #5FD75F bold
	branch = #5FD75F
	remoteBranch = #6AB0FF
	tag = #E5C07B
