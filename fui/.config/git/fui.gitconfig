# GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file.
# Included from ~/.gitconfig by install.sh ([include] path = ~/.config/git/fui.gitconfig)
[color]
	ui = auto
[color "diff"]
	meta = #7D8A8F
	frag = #6F8FB0
	func = #7D8A8F
	commit = #C99A4E
	old = #B5555A
	new = #6FAF8A
	whitespace = #B5555A reverse
[color "status"]
	header = #7D8A8F
	branch = #8FD3DC bold
	added = #6FAF8A
	changed = #C99A4E
	untracked = #9A86B8
[color "branch"]
	current = #8FD3DC bold
	local = #E6EBEC
	remote = #6F8FB0
[color "decorate"]
	HEAD = #8FD3DC bold
	branch = #8FD3DC
	remoteBranch = #6F8FB0
	tag = #C99A4E
