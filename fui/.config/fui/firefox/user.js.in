// fui // Firefox preferences, written into each profile by `fui setup firefox`.
// The stylesheets in chrome/ (userChrome.css, userContent.css) need the first one.
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
// the fui start page as the home page
user_pref("browser.startup.homepage", "@START@");
user_pref("browser.startup.page", 1);
// pages follow the desktop theme
user_pref("layout.css.prefers-color-scheme.content-override", 2);
user_pref("ui.systemUsesDarkTheme", -1);
// the system file picker (a fui-styled GTK dialog that floats, centred)
user_pref("widget.use-xdg-desktop-portal.file-picker", 1);
// fonts: reading in Noto Sans, code in JetBrains Mono
user_pref("font.name.sans-serif.x-western", "Noto Sans");
user_pref("font.name.monospace.x-western", "JetBrainsMono Nerd Font");
// a quieter new-tab page
user_pref("browser.newtabpage.activity-stream.showSponsored", false);
user_pref("browser.newtabpage.activity-stream.showSponsoredTopSites", false);
user_pref("browser.newtabpage.activity-stream.feeds.section.topstories", false);
