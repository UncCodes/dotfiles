# fui // labwc: what starts with the session (the same programs Hyprland starts; see
# hypr/.config/hypr/hyprland.lua). labwc runs this file with sh once, at login.
fui="$HOME/.local/bin/fui"
"$fui" mode apply --quiet; "$fui" display start
"$fui" wallpaper start || swaybg -i ~/.config/hypr/wallpaper.png -m fill &
"$fui" bar || waybar &
swaync &
swayosd-server &
hypridle &
"$fui" watch &
systemctl --user start hyprpolkitagent
nm-applet --indicator &
wl-paste --watch cliphist store &
"$fui" sound login &
