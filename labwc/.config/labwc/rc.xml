<?xml version="1.0"?>
<!-- fui // labwc: the window frame and the keys. GENERATED by theme/build.py.
     The theme (title bar, buttons, colours) is ~/.local/share/themes/fui, linked to the
     edition's. -->
<labwc_config>
  <core><gap>8</gap></core>
  <theme>
    <name>fui</name>
    <cornerRadius>4</cornerRadius>
    <dropShadows>yes</dropShadows>
    <titlebar><layout>icon:iconify,max,close</layout><showTitle>yes</showTitle></titlebar>
    <font place="ActiveWindow"><name>JetBrainsMono Nerd Font</name><size>9</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>JetBrainsMono Nerd Font</name><size>9</size><weight>bold</weight></font>
    <font place="MenuItem"><name>Inter</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>Inter</name><size>10</size></font>
  </theme>
  <desktops number="4"><popupTime>600</popupTime></desktops>
  <placement><policy>cascade</policy></placement>
  <windowSwitcher show="yes" preview="yes" outlines="yes"/>
  <keyboard>
    <default/>
    <keybind key="W-Return"><action name="Execute" command="kitty"/></keybind>   <!-- terminal -->
    <keybind key="W-S-Return"><action name="Execute" command="~/.local/bin/fui tabs"/></keybind>   <!-- the startup terminal tabs -->
    <keybind key="W-d"><action name="Execute" command="rofi -show drun"/></keybind>   <!-- apps -->
    <keybind key="W-space"><action name="Execute" command="~/.local/bin/fui palette"/></keybind>   <!-- command palette -->
    <keybind key="W-slash"><action name="Execute" command="~/.local/bin/fui keys"/></keybind>   <!-- this list of keys -->
    <keybind key="W-b"><action name="Execute" command="firefox"/></keybind>   <!-- browser -->
    <keybind key="W-e"><action name="Execute" command="thunar"/></keybind>   <!-- file manager -->
    <keybind key="W-a"><action name="Execute" command="pavucontrol"/></keybind>   <!-- audio mixer -->
    <keybind key="W-S-n"><action name="Execute" command="nm-connection-editor"/></keybind>   <!-- network connections -->
    <keybind key="W-n"><action name="Execute" command="swaync-client -t -sw"/></keybind>   <!-- notifications and control centre -->
    <keybind key="W-period"><action name="Execute" command="rofi -modi emoji -show emoji"/></keybind>   <!-- emoji -->
    <keybind key="W-S-v"><action name="Execute" command="~/.local/bin/fui clipboard"/></keybind>   <!-- clipboard history -->
    <keybind key="W-q"><action name="Close"/></keybind>   <!-- close window -->
    <keybind key="W-f"><action name="ToggleFullscreen"/></keybind>   <!-- fullscreen -->
    <keybind key="W-Up"><action name="ToggleMaximize"/></keybind>   <!-- maximise / restore -->
    <keybind key="W-Down"><action name="Iconify"/></keybind>   <!-- minimise -->
    <keybind key="W-Left"><action name="SnapToEdge" direction="left"/></keybind>   <!-- fill the left half -->
    <keybind key="W-Right"><action name="SnapToEdge" direction="right"/></keybind>   <!-- fill the right half -->
    <keybind key="A-Tab"><action name="NextWindow"/></keybind>   <!-- next window -->
    <keybind key="A-S-Tab"><action name="PreviousWindow"/></keybind>   <!-- previous window -->
    <keybind key="W-Escape"><action name="Execute" command="hyprlock"/></keybind>   <!-- lock -->
    <keybind key="W-x"><action name="Execute" command="~/.local/bin/fui power"/></keybind>   <!-- power menu -->
    <keybind key="W-S-e"><action name="Exit"/></keybind>   <!-- quit labwc -->
    <keybind key="W-S-t"><action name="Execute" command="~/.local/bin/fui mode toggle"/></keybind>   <!-- edition: the next one -->
    <keybind key="W-A-t"><action name="Execute" command="~/.local/bin/fui mode pick"/></keybind>   <!-- edition: pick one from a list -->
    <keybind key="W-S-d"><action name="Execute" command="~/.local/bin/fui display pick"/></keybind>   <!-- display tier -->
    <keybind key="W-S-w"><action name="Execute" command="~/.local/bin/fui wallpaper toggle"/></keybind>   <!-- live / still backdrop -->
    <keybind key="W-r"><action name="Execute" command="~/.local/bin/fui record toggle"/></keybind>   <!-- screen recording start / stop -->
    <keybind key="Print"><action name="Execute" command="~/.local/bin/fui shot region"/></keybind>   <!-- screenshot a region -->
    <keybind key="S-Print"><action name="Execute" command="~/.local/bin/fui shot screen"/></keybind>   <!-- screenshot the screen -->
    <keybind key="W-Print"><action name="Execute" command="~/.local/bin/fui shot edit"/></keybind>   <!-- screenshot a region and annotate it -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="swayosd-client --output-volume raise"/></keybind>   <!-- volume up -->
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="swayosd-client --output-volume lower"/></keybind>   <!-- volume down -->
    <keybind key="XF86AudioMute"><action name="Execute" command="swayosd-client --output-volume mute-toggle"/></keybind>   <!-- mute -->
    <keybind key="XF86AudioMicMute"><action name="Execute" command="swayosd-client --input-volume mute-toggle"/></keybind>   <!-- microphone mute -->
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="swayosd-client --brightness raise"/></keybind>   <!-- brightness up -->
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="swayosd-client --brightness lower"/></keybind>   <!-- brightness down -->
    <keybind key="XF86AudioPlay"><action name="Execute" command="playerctl play-pause"/></keybind>   <!-- play / pause -->
    <keybind key="XF86AudioNext"><action name="Execute" command="playerctl next"/></keybind>   <!-- next track -->
    <keybind key="XF86AudioPrev"><action name="Execute" command="playerctl previous"/></keybind>   <!-- previous track -->
    <keybind key="W-1"><action name="GoToDesktop" to="1"/></keybind>   <!-- go to workspace -->
    <keybind key="W-2"><action name="GoToDesktop" to="2"/></keybind>   <!-- go to workspace -->
    <keybind key="W-3"><action name="GoToDesktop" to="3"/></keybind>   <!-- go to workspace -->
    <keybind key="W-4"><action name="GoToDesktop" to="4"/></keybind>   <!-- go to workspace -->
    <keybind key="W-5"><action name="GoToDesktop" to="5"/></keybind>   <!-- go to workspace -->
    <keybind key="W-6"><action name="GoToDesktop" to="6"/></keybind>   <!-- go to workspace -->
    <keybind key="W-7"><action name="GoToDesktop" to="7"/></keybind>   <!-- go to workspace -->
    <keybind key="W-8"><action name="GoToDesktop" to="8"/></keybind>   <!-- go to workspace -->
    <keybind key="W-9"><action name="GoToDesktop" to="9"/></keybind>   <!-- go to workspace -->
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" follow="no"/></keybind>   <!-- send the window to workspace -->
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" follow="no"/></keybind>   <!-- send the window to workspace -->
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" follow="no"/></keybind>   <!-- send the window to workspace -->
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" follow="no"/></keybind>   <!-- send the window to workspace -->
    <keybind key="W-S-5"><action name="SendToDesktop" to="5" follow="no"/></keybind>   <!-- send the window to workspace -->
    <keybind key="W-S-6"><action name="SendToDesktop" to="6" follow="no"/></keybind>   <!-- send the window to workspace -->
    <keybind key="W-S-7"><action name="SendToDesktop" to="7" follow="no"/></keybind>   <!-- send the window to workspace -->
    <keybind key="W-S-8"><action name="SendToDesktop" to="8" follow="no"/></keybind>   <!-- send the window to workspace -->
    <keybind key="W-S-9"><action name="SendToDesktop" to="9" follow="no"/></keybind>   <!-- send the window to workspace -->
  </keyboard>
  <mouse><default/></mouse>
</labwc_config>
