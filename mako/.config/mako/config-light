# HUD // MAKO

font=JetBrainsMono Nerd Font 10
background-color=#F7F9F98C
text-color=#141B1E
border-color=#1F7A8799
border-size=1
border-radius=0
padding=12,14
margin=14
width=360
height=160
anchor=top-right
default-timeout=6000
icons=1
max-icon-size=32
format=<span color="#1F7A87" size="small">⌖  %a</span>\n<b>%s</b>\n%b
