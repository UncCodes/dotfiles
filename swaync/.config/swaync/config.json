{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 12,
  "control-center-margin-left": 0,
  "control-center-width": 420,
  "notification-window-width": 380,
  "notification-icon-size": 44,
  "notification-body-image-height": 120,
  "notification-body-image-width": 220,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "relative-timestamps": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 220,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "NO NOTICES",
  "script-fail-notify": false,
  "scripts": {
    "alert": {
      "exec": "sh -c '$HOME/.local/bin/fui sound alert'",
      "urgency": "Critical"
    },
    "message": {
      "exec": "sh -c '$HOME/.local/bin/fui sound message'",
      "urgency": "Normal"
    }
  },
  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "volume",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "SYSTEM CONSOLE",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "DO NOT DISTURB"
    },
    "buttons-grid": {
      "buttons-per-row": 5,
      "actions": [
        {
          "label": "EDITION",
          "command": "sh -c '$HOME/.local/bin/fui mode pick'"
        },
        {
          "label": "DISPLAY",
          "command": "sh -c '$HOME/.local/bin/fui display pick'"
        },
        {
          "label": "WALLPAPER",
          "command": "sh -c '$HOME/.local/bin/fui wallpaper toggle'"
        },
        {
          "label": "SCREEN",
          "command": "sh -c '$HOME/.local/bin/fui screen toggle'"
        },
        {
          "label": "SOUND",
          "command": "sh -c '$HOME/.local/bin/fui sound toggle'"
        },
        {
          "label": "CAPTURE",
          "command": "sh -c '$HOME/.local/bin/fui shot region'"
        },
        {
          "label": "RECORD",
          "command": "sh -c '$HOME/.local/bin/fui record toggle'"
        },
        {
          "label": "NETWORK",
          "command": "sh -c '$HOME/.local/bin/fui tui nmtui'"
        },
        {
          "label": "LOCK",
          "command": "hyprlock"
        },
        {
          "label": "POWER",
          "command": "sh -c '$HOME/.local/bin/fui power'"
        }
      ]
    },
    "volume": {
      "label": "VOL"
    },
    "mpris": {
      "show-album-art": "when-available",
      "autohide": true
    }
  }
}
