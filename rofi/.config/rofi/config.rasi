/* fui // ROFI: the launcher is a directory panel
 * A flat panel with a hairline: a header plate (the signal stripe, a tracked capital title,
 * a code on the right), a search field set into the panel with a prompt in the signal, and
 * flat rows; the selected row takes the signal stripe and tint. Colours and strokes:
 *   fui-colors.rasi  the edition (colors-<edition>.rasi)       fui mode
 *   fui-tier.rasi    the display tier (tier-<tier>.rasi)       fui display
 *   fui-look.rasi    the look (look-<instrument|y2k>.rasi), imported last so it can override
 * The palette, session menu and key list reuse this panel with their own titles and codes
 * (fui palette / power / keys pass -theme-str). */

configuration {
  modi: "drun,run,window";
  show-icons: true;
  icon-theme: "Papirus";
  terminal: "kitty";
  display-drun: "󰀻  APPS";
  display-run: "󰆍  RUN";
  display-window: "󰖲  WINDOWS";
  drun-display-format: "{name}";
}

@import "fui-colors.rasi"
@import "fui-tier.rasi"

* {
  background-color: transparent;
  text-color: @ink;
  font: @font-ui;
}

window {
  width: 620px;
  border: @frame;
  border-color: @rule-hi;
  border-radius: 4px;
  background-color: @glass;
}

mainbox {
  children: [ titlebar, well ];
  spacing: 0;
}

/* the header plate: the signal stripe at its left, the title, the code */
titlebar {
  expand: false;
  orientation: horizontal;
  children: [ textbox-title, textbox-code ];
  padding: 10px 14px 10px 12px;
  border: @stripe;
  border-color: @signal;
  background-color: @panel;
}
textbox-title {
  content: "󰀻  DIRECTORY";
  expand: true;
  font: @font-label;
  text-color: @ink;
  vertical-align: 0.5;
}
textbox-code {
  content: "DIR-01";
  expand: false;
  font: @font-mono;
  text-color: @faint;
  vertical-align: 0.5;
}

well {
  orientation: vertical;
  children: [ inputbar, message, listview ];
  padding: 12px;
  spacing: 8px;
  border: @rule-top;
  border-color: @rule;
}

/* the field: set in, a prompt in the signal */
inputbar {
  children: [ prompt, entry ];
  spacing: 12px;
  padding: 8px 12px;
  border: @field;
  border-color: @edge;
  border-radius: 2px;
  background-color: @well;
}
prompt { text-color: @signal; font: @font-label; vertical-align: 0.5; }
entry {
  placeholder: "Search";
  placeholder-color: @muted;
  cursor-color: @signal;
  vertical-align: 0.5;
}

message { padding: 4px 6px; }
textbox { text-color: @muted; }

listview {
  border: 0;
  lines: 9;
  columns: 1;
  fixed-height: true;
  scrollbar: false;
  spacing: 2px;
}

/* rows: flat; the selected one takes the stripe and the signal tint */
element {
  padding: 7px 12px;
  spacing: 12px;
  border: @stripe;
  border-color: transparent;
  border-radius: 2px;
  background-color: transparent;
  text-color: @ink;
}
element normal.normal, element alternate.normal { background-color: transparent; text-color: @ink; }
element selected.normal, element selected.active { background-color: @signal-dim; text-color: @ink; border-color: @signal; }
element normal.active, element alternate.active { text-color: @signal; }
element normal.urgent, element alternate.urgent, element selected.urgent { background-color: @bad; text-color: @on-bad; }
element-icon { size: 20px; background-color: transparent; }
element-text { vertical-align: 0.5; background-color: transparent; text-color: inherit; }

/* the look: instrument changes nothing; y2k rounds and lights the panel (fui mode links it) */
@import "fui-look.rasi"
