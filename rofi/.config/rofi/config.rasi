/* fui // ROFI: the launcher is an aero window
 * Frosted plastic frame (10px radius, 1px bevel), a glossy gel title bar with a pixel-font
 * [0xNN] title, and an inset well holding the search field and the list. The selected row
 * is a white nav button turned accent. Colours: fui-colors.rasi, a link to colors-<theme>.rasi.
 * The command palette, power menu and key list reuse this window with their own titles
 * (fui palette / power / keys pass -theme-str). */

configuration {
  modi: "drun,run,window";
  show-icons: true;
  icon-theme: "Papirus";
  terminal: "kitty";
  display-drun: "apps";
  display-run: "run";
  display-window: "windows";
  drun-display-format: "{name}";
}

@import "fui-colors.rasi"

* {
  background-color: transparent;
  text-color: @text;
  font: @font-mono;
}

window {
  width: 600px;
  padding: 4px;
  border: 1px solid;
  border-color: @edge;
  border-radius: 10px;
  background-color: @glass;
  background-image: @sheen-face;
}

mainbox {
  children: [ titlebar, well ];
  spacing: 4px;
}

/* the gel title bar: four stops, top to bottom, a highlight line along its top */
titlebar {
  expand: false;
  orientation: horizontal;
  children: [ textbox-title, textbox-grip ];
  padding: 6px 12px;
  border: 1px solid;
  border-color: @gel-edge;
  border-radius: 999px;
  background-image: @gel-face;
}
textbox-title {
  content: "[0x01] run";
  expand: false;
  font: @font-pixel;
  text-color: @gel-text;
  vertical-align: 0.5;
}
textbox-grip {
  content: "";
  expand: true;
}

/* the well: inset, translucent, holding the field and the rows */
well {
  orientation: vertical;
  children: [ inputbar, message, listview ];
  padding: 12px;
  spacing: 10px;
  border: 1px solid;
  border-color: @edge;
  border-radius: 2px 2px 6px 6px;
  background-color: @glass-well;
}

inputbar {
  children: [ prompt, entry ];
  spacing: 10px;
  padding: 6px 14px;
  border: 1px solid;
  border-color: @edge;
  border-radius: 999px;
  background-color: @well;
}
prompt { text-color: @nav-accent; }
entry {
  placeholder: "type to search";
  placeholder-color: @muted;
  cursor-color: @nav-accent;
}

message { padding: 4px 6px; }
textbox { text-color: @muted; }

listview {
  lines: 9;
  columns: 1;
  fixed-height: true;
  scrollbar: false;
  spacing: 6px;
}

/* rows: white nav buttons; the selected one turns accent */
element {
  padding: 5px 14px;
  spacing: 12px;
  background-color: @white;
  text-color: @nav-accent;
}
element normal.normal, element alternate.normal { background-color: @white; text-color: @nav-accent; }
element selected.normal, element selected.active { background-color: @nav-accent; text-color: @white; }
element normal.active, element alternate.active { background-color: @white; text-color: @link; }
element normal.urgent, element alternate.urgent, element selected.urgent { background-color: @bad; text-color: @white; }
element-icon { size: 18px; background-color: transparent; }
element-text { vertical-align: 0.5; background-color: transparent; text-color: inherit; }
