/* HUD // ROFI */

configuration {
  modi: "drun,run,window";
  show-icons: true;
  icon-theme: "Papirus-Dark";
  font: "JetBrainsMono Nerd Font 11";
  display-drun: "RUN";
  display-run: "CMD";
  display-window: "WIN";
  drun-display-format: "{name}";
  terminal: "kitty";              /* terminal apps (yazi, btop, ...) open in kitty */
}

* {
  bg0:     #080E128C;
  bg1:     #0A101466;
  bg2:     #8FD3DC22;
  line:    #1A2428;
  fg:      #E6EBEC;
  fg-dim:  #7D8A8F;
  teal:    #8FD3DC;
  resin:   #C99A4E;

  background-color: transparent;
  text-color: @fg;
}

window {
  width: 560px;
  background-color: @bg0;
  border: 1px solid;
  border-color: @teal;
  border-radius: 0;
  padding: 0;
}

mainbox {
  children: [ header, inputbar, listview, footer ];
  spacing: 0;
}

header {
  orientation: horizontal;
  children: [ textbox-tag, textbox-sys ];
  padding: 8px 14px;
  background-color: @bg1;
  border: 0 0 1px 0;
  border-color: @line;
}

textbox-tag {
  content: "⌖  L A U N C H  //  A P P S";
  expand: false;
  text-color: @teal;
}

textbox-sys {
  content: "∷∷  SYS.ONLINE";
  horizontal-align: 1;
  text-color: @fg-dim;
}

inputbar {
  children: [ prompt, entry ];
  spacing: 12px;
  padding: 12px 14px;
  border: 0 0 1px 0;
  border-color: @line;
}

prompt {
  text-color: @bg1;
  background-color: @teal;
  padding: 0 8px;
}

entry {
  placeholder: "type to search";
  placeholder-color: @fg-dim;
  cursor-color: @resin;
}

listview {
  lines: 8;
  columns: 1;
  fixed-height: true;
  scrollbar: false;
  padding: 6px 0;
}

element {
  padding: 7px 14px;
  spacing: 12px;
  border: 0 0 0 2px;
  border-color: transparent;
}

element selected {
  background-color: @bg2;
  border-color: @teal;
}

element-icon {
  size: 18px;
}

element-text {
  vertical-align: 0.5;
  text-color: inherit;
}

element selected element-text {
  text-color: @teal;
}

footer {
  orientation: horizontal;
  children: [ textbox-help ];
  padding: 6px 14px;
  border: 1px 0 0 0;
  border-color: @line;
}

textbox-help {
  content: "┌ ENTER RUN   ESC CLOSE   CTRL+TAB MODE ┘";
  text-color: @fg-dim;
}

/* textbox elements used above */
textbox-tag, textbox-sys, textbox-help {
  font: "JetBrainsMono Nerd Font 9";
}
