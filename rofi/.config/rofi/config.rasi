/* fui // ROFI: the launcher is a directory panel
 * A flat glass panel with a hairline edge: a header plate (the accent stripe, a tracked
 * capital title, an asset code on the right), a search field set into the panel, and flat
 * rows; the selected row takes the accent stripe and tint. Colours: fui-colors.rasi, a link
 * to colors-<theme>.rasi. The palette, power menu and key list reuse this panel with their
 * own titles (fui palette / power / keys pass -theme-str). */

configuration {
  modi: "drun,run,window";
  show-icons: true;
  icon-theme: "Papirus";
  terminal: "kitty";
  display-drun: "APPS";
  display-run: "RUN";
  display-window: "WINDOWS";
  drun-display-format: "{name}";
}

@import "fui-colors.rasi"

* {
  background-color: transparent;
  text-color: @text;
  font: @font-ui;
}

window {
  width: 620px;
  border: 1px solid;
  border-color: @line-hi;
  border-radius: 6px;
  background-color: @glass;
}

mainbox {
  children: [ titlebar, well ];
  spacing: 0;
}

/* the header plate: the accent stripe at its left */
titlebar {
  expand: false;
  orientation: horizontal;
  children: [ textbox-title, textbox-code ];
  padding: 10px 14px 10px 12px;
  border: 0 0 0 3px;
  border-color: @accent;
  background-color: @panel;
}
textbox-title {
  content: "DIRECTORY";
  expand: true;
  font: @font-label;
  text-color: @text;
  vertical-align: 0.5;
}
textbox-code {
  content: "DIR-01";
  expand: false;
  font: @font-mono;
  text-color: @faint;
  vertical-align: 0.5;
}

well {
  orientation: vertical;
  children: [ inputbar, message, listview ];
  padding: 14px;
  spacing: 10px;
  border: 1px 0 0 0;
  border-color: @line;
}

inputbar {
  children: [ prompt, entry ];
  spacing: 12px;
  padding: 9px 12px;
  border: 1px solid;
  border-color: @line-hi;
  border-radius: 4px;
  background-color: @well;
}
prompt { text-color: @accent; font: @font-label; vertical-align: 0.5; }
entry {
  placeholder: "Search";
  placeholder-color: @muted;
  cursor-color: @accent;
  vertical-align: 0.5;
}

message { padding: 4px 6px; }
textbox { text-color: @muted; }

listview {
  border: 0;
  lines: 9;
  columns: 1;
  fixed-height: true;
  scrollbar: false;
  spacing: 2px;
}

/* rows: flat; the selected one takes the stripe and the accent tint */
element {
  padding: 7px 12px;
  spacing: 12px;
  border: 0 0 0 3px;
  border-color: transparent;
  border-radius: 4px;
  background-color: transparent;
  text-color: @text;
}
element normal.normal, element alternate.normal { background-color: transparent; text-color: @text; }
element selected.normal, element selected.active { background-color: @accent-dim; text-color: @text; border-color: @accent; }
element normal.active, element alternate.active { text-color: @accent; }
element normal.urgent, element alternate.urgent, element selected.urgent { background-color: @bad; text-color: @white; }
element-icon { size: 20px; background-color: transparent; }
element-text { vertical-align: 0.5; background-color: transparent; text-color: inherit; }
