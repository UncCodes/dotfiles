/* GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file. */

/* FUI // Qt: applied to every Qt6 app through qt6ct */
* { font-family: "JetBrainsMono Nerd Font"; }
QWidget { background-color: #030506; color: #E6EBEC; selection-background-color: rgba(143, 211, 220, 35%); selection-color: #F4F6F6; }
QMainWindow, QDialog { background-color: #030506; }

QPushButton, QToolButton { border-image: url(@HOME@/.config/qt6ct/assets/bracket.svg) 6 6 6 6 stretch; border-width: 6px; padding: 0 6px; background: rgba(24, 36, 42, 55%); color: #E6EBEC; min-height: 18px; }
QPushButton:hover, QToolButton:hover { border-image: url(@HOME@/.config/qt6ct/assets/bracket-hover.svg) 6 6 6 6 stretch; background: rgba(143, 211, 220, 10%); color: #C8EEF2; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked { background: rgba(46, 85, 96, 70%); color: #F4F6F6; }
QPushButton:default { border-image: url(@HOME@/.config/qt6ct/assets/bracket-accent.svg) 6 6 6 6 stretch; background: rgba(46, 85, 96, 85%); }
QPushButton:disabled { color: rgba(125, 138, 143, 50%); border-image: none; border: 6px solid transparent; }
QToolButton[autoRaise="true"] { border-image: none; border: 6px solid transparent; background: transparent; }

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
  border-image: url(@HOME@/.config/qt6ct/assets/chamfer.svg) 8 8 8 8 stretch; border-width: 6px; background: rgba(2, 3, 4, 75%); color: #E6EBEC; padding: 0 2px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border-image: url(@HOME@/.config/qt6ct/assets/chamfer-focus.svg) 8 8 8 8 stretch; }
QComboBox::drop-down { border: none; width: 14px; }
QComboBox QAbstractItemView { background: #0A1014; border: 1px solid rgba(143, 211, 220, 50%); selection-background-color: rgba(143, 211, 220, 15%); }

QCheckBox::indicator, QGroupBox::indicator { width: 14px; height: 14px; image: url(@HOME@/.config/qt6ct/assets/check.svg); }
QCheckBox::indicator:checked { image: url(@HOME@/.config/qt6ct/assets/check-on.svg); }
QCheckBox::indicator:indeterminate { image: url(@HOME@/.config/qt6ct/assets/check-mixed.svg); }
QRadioButton::indicator { width: 14px; height: 14px; image: url(@HOME@/.config/qt6ct/assets/radio.svg); }
QRadioButton::indicator:checked { image: url(@HOME@/.config/qt6ct/assets/radio-on.svg); }

QSlider::groove:horizontal { height: 2px; background: #1A2428; }
QSlider::groove:vertical { width: 2px; background: #1A2428; }
QSlider::sub-page:horizontal { background: #8FD3DC; }
QSlider::handle { image: url(@HOME@/.config/qt6ct/assets/thumb.svg); width: 14px; height: 14px; margin: -6px; }

QProgressBar { border: 1px solid #1A2428; background: #020304; text-align: center; color: #E6EBEC; min-height: 8px; }
QProgressBar::chunk { background-color: #8FD3DC; width: 4px; margin: 1px 1px; }

QScrollBar:vertical { width: 6px; background: transparent; margin: 0; }
QScrollBar:horizontal { height: 6px; background: transparent; margin: 0; }
QScrollBar::handle { background: rgba(143, 211, 220, 35%); min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: rgba(143, 211, 220, 60%); }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; border: none; }

QTabWidget::pane { border: 1px solid #1A2428; top: -1px; }
QTabBar::tab { border-image: url(@HOME@/.config/qt6ct/assets/tab.svg) 8 8 0 8 stretch; border-width: 8px 8px 0 8px; padding: 2px 10px; color: #7D8A8F; background: transparent; }
QTabBar::tab:selected { border-image: url(@HOME@/.config/qt6ct/assets/tab-active.svg) 8 8 0 8 stretch; color: #C8EEF2; }

QMenuBar { background: #020304; border-bottom: 1px solid #1A2428; }
QMenuBar::item:selected { background: rgba(143, 211, 220, 12%); color: #C8EEF2; }
QMenu { border-image: url(@HOME@/.config/qt6ct/assets/chamfer-lg.svg) 12 12 12 12 stretch; border-width: 10px; background: rgba(10, 16, 20, 88%); }
QMenu::item { padding: 4px 18px 4px 10px; }
QMenu::item:selected { background: rgba(143, 211, 220, 12%); color: #C8EEF2; border-left: 2px solid #8FD3DC; }
QMenu::separator { height: 1px; background: #2A3A40; margin: 4px 6px; }

QGroupBox { border-image: url(@HOME@/.config/qt6ct/assets/chamfer.svg) 8 8 8 8 stretch; border-width: 6px; margin-top: 14px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0 4px; color: #8FD3DC; }
QHeaderView::section { background: #020304; color: #7D8A8F; border: none; border-bottom: 1px solid #1A2428; border-right: 1px solid #1A2428; padding: 4px 6px; }
QTableView, QTreeView, QListView { background: transparent; alternate-background-color: rgba(14, 21, 25, 50%); gridline-color: #1A2428; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected { background: rgba(143, 211, 220, 12%); color: #C8EEF2; }
QToolTip { background: #020304; color: #E6EBEC; border: 1px solid rgba(143, 211, 220, 50%); padding: 3px 6px; }
QStatusBar { background: #020304; color: #7D8A8F; border-top: 1px solid #1A2428; }
QSplitter::handle { background: #1A2428; }
