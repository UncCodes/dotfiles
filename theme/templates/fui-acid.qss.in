/* GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file. */

/* fui: Qt, edition acid, applied to every Qt6 app through qt6ct. (No double slashes in this file: qt6ct strips them as comments.) */
QWidget { background-color: #080908; color: #ecefe6; selection-background-color: #c6f23a; selection-color: #000000; }
QMainWindow, QDialog { background-color: #080908; }
QMenuBar { background: #101210; border-bottom: 1px solid #252924; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: #2e3812; border-radius: 2px; }
QMenu { background-color: #101210; border: 1px solid #3a4038; border-top: 2px solid #c6f23a; border-radius: 4px; padding: 4px; }
QMenu::item { padding: 5px 18px 5px 12px; border-radius: 2px; }
QMenu::item:selected { background-color: #2e3812; color: #ecefe6; border-left: 3px solid #c6f23a; }
QMenu::separator { height: 1px; background: #252924; margin: 4px 6px; }
QPushButton, QToolButton { background: transparent; border: 1px solid #666b60; border-radius: 2px; padding: 4px 14px; color: #ecefe6; min-height: 18px; }
QPushButton:hover, QToolButton:hover { background: #1a1c1a; border-color: #c6f23a; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked { background: #2e3812; border-color: #c6f23a; }
QPushButton:default { background: #c6f23a; color: #000000; border-color: #c6f23a; font-weight: 600; }
QPushButton:disabled, QToolButton:disabled { color: #666b60; border-color: #252924; }
QPushButton:focus, QToolButton:focus { outline: none; border: 2px solid #c6f23a; }
QToolButton[autoRaise="true"] { background: transparent; border-color: transparent; }
QToolButton[autoRaise="true"]:hover { background: #1a1c1a; border-color: #252924; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
  background-color: #050605; border: 1px solid #666b60; border-radius: 2px; padding: 3px 8px; color: #ecefe6; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid #c6f23a; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: #101210; border: 1px solid #3a4038; selection-background-color: #2e3812; selection-color: #ecefe6; }
QProgressBar { background: #252924; border: none; border-radius: 0; text-align: center; color: #ecefe6; max-height: 6px; }
QProgressBar::chunk { background: #c6f23a; border-radius: 0; }
QSlider::groove:horizontal { height: 4px; background: #252924; border-radius: 0; }
QSlider::sub-page:horizontal { background: #c6f23a; border-radius: 0; }
QSlider::handle:horizontal { background: #101210; border: 2px solid #c6f23a; width: 12px; margin: -6px 0; border-radius: 0; }
QScrollBar:vertical { width: 10px; background: transparent; margin: 0; }
QScrollBar:horizontal { height: 10px; background: transparent; margin: 0; }
QScrollBar::handle { background: #3a4038; border-radius: 0; margin: 2px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #9aa092; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; border: none; }
QTabWidget::pane { border: 1px solid #252924; border-radius: 4px; top: -1px; }
QTabBar::tab { background: transparent; border: none; padding: 6px 14px; color: #9aa092; }
QTabBar::tab:hover { color: #ecefe6; }
QTabBar::tab:selected { color: #ecefe6; border-bottom: 2px solid #c6f23a; }
QGroupBox { border: 1px solid #252924; border-radius: 4px; margin-top: 16px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #9aa092; font-weight: 600; }
QHeaderView::section { background: #101210; color: #9aa092; border: none; border-bottom: 1px solid #252924; padding: 5px 8px; font-weight: 600; }
QTableView, QTreeView, QListView { background: #050605; alternate-background-color: #101210; gridline-color: #252924; border: 1px solid #252924; border-radius: 4px; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected { background: #2e3812; color: #ecefe6; border-left: 3px solid #c6f23a; }
QToolTip { background: #1a1c1a; color: #ecefe6; border: 1px solid #3a4038; border-radius: 2px; padding: 4px 8px; }
QStatusBar { background: #101210; color: #9aa092; border-top: 1px solid #252924; }
QSplitter::handle { background: #252924; }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid #666b60; background: #050605; border-radius: 0; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #c6f23a; border-color: #c6f23a; }
