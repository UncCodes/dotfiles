/* GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file. */

/* fui: Qt, edition lab, applied to every Qt6 app through qt6ct. (No double slashes in this file: qt6ct strips them as comments.) */
QWidget { background-color: #f4f6f8; color: #0e141a; selection-background-color: #1f4fe0; selection-color: #ffffff; }
QMainWindow, QDialog { background-color: #f4f6f8; }
QMenuBar { background: #ffffff; border-bottom: 1px solid #d5dbe2; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: #c9d5f3; border-radius: 2px; }
QMenu { background-color: #ffffff; border: 1px solid #aeb7c2; border-top: 2px solid #1f4fe0; border-radius: 4px; padding: 4px; }
QMenu::item { padding: 5px 18px 5px 12px; border-radius: 2px; }
QMenu::item:selected { background-color: #c9d5f3; color: #0e141a; border-left: 3px solid #1f4fe0; }
QMenu::separator { height: 1px; background: #d5dbe2; margin: 4px 6px; }
QPushButton, QToolButton { background: transparent; border: 1px solid #7b8692; border-radius: 2px; padding: 4px 14px; color: #0e141a; min-height: 18px; }
QPushButton:hover, QToolButton:hover { background: #f4f4f5; border-color: #1f4fe0; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked { background: #c9d5f3; border-color: #1f4fe0; }
QPushButton:default { background: #1f4fe0; color: #ffffff; border-color: #1f4fe0; font-weight: 600; }
QPushButton:disabled, QToolButton:disabled { color: #7b8692; border-color: #d5dbe2; }
QPushButton:focus, QToolButton:focus { outline: none; border: 2px solid #1f4fe0; }
QToolButton[autoRaise="true"] { background: transparent; border-color: transparent; }
QToolButton[autoRaise="true"]:hover { background: #f4f4f5; border-color: #d5dbe2; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
  background-color: #fafbfc; border: 1px solid #7b8692; border-radius: 2px; padding: 3px 8px; color: #0e141a; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid #1f4fe0; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: #ffffff; border: 1px solid #aeb7c2; selection-background-color: #c9d5f3; selection-color: #0e141a; }
QProgressBar { background: #d5dbe2; border: none; border-radius: 0; text-align: center; color: #0e141a; max-height: 6px; }
QProgressBar::chunk { background: #1f4fe0; border-radius: 0; }
QSlider::groove:horizontal { height: 4px; background: #d5dbe2; border-radius: 0; }
QSlider::sub-page:horizontal { background: #1f4fe0; border-radius: 0; }
QSlider::handle:horizontal { background: #ffffff; border: 2px solid #1f4fe0; width: 12px; margin: -6px 0; border-radius: 0; }
QScrollBar:vertical { width: 10px; background: transparent; margin: 0; }
QScrollBar:horizontal { height: 10px; background: transparent; margin: 0; }
QScrollBar::handle { background: #aeb7c2; border-radius: 0; margin: 2px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #56616d; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; border: none; }
QTabWidget::pane { border: 1px solid #d5dbe2; border-radius: 4px; top: -1px; }
QTabBar::tab { background: transparent; border: none; padding: 6px 14px; color: #56616d; }
QTabBar::tab:hover { color: #0e141a; }
QTabBar::tab:selected { color: #0e141a; border-bottom: 2px solid #1f4fe0; }
QGroupBox { border: 1px solid #d5dbe2; border-radius: 4px; margin-top: 16px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #56616d; font-weight: 600; }
QHeaderView::section { background: #ffffff; color: #56616d; border: none; border-bottom: 1px solid #d5dbe2; padding: 5px 8px; font-weight: 600; }
QTableView, QTreeView, QListView { background: #fafbfc; alternate-background-color: #ffffff; gridline-color: #d5dbe2; border: 1px solid #d5dbe2; border-radius: 4px; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected { background: #c9d5f3; color: #0e141a; border-left: 3px solid #1f4fe0; }
QToolTip { background: #f4f4f5; color: #0e141a; border: 1px solid #aeb7c2; border-radius: 2px; padding: 4px 8px; }
QStatusBar { background: #ffffff; color: #56616d; border-top: 1px solid #d5dbe2; }
QSplitter::handle { background: #d5dbe2; }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid #7b8692; background: #fafbfc; border-radius: 0; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #1f4fe0; border-color: #1f4fe0; }
