/* GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file. */

/* fui: Qt, edition mono, applied to every Qt6 app through qt6ct. (No double slashes in this file: qt6ct strips them as comments.) */
QWidget { background-color: #08090a; color: #eceef0; selection-background-color: #f4f6f8; selection-color: #000000; }
QMainWindow, QDialog { background-color: #08090a; }
QMenuBar { background: #111214; border-bottom: 1px solid #26282b; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: #37383a; border-radius: 2px; }
QMenu { background-color: #111214; border: 1px solid #3c3f44; border-top: 2px solid #f4f6f8; border-radius: 4px; padding: 4px; }
QMenu::item { padding: 5px 18px 5px 12px; border-radius: 2px; }
QMenu::item:selected { background-color: #37383a; color: #eceef0; border-left: 3px solid #f4f6f8; }
QMenu::separator { height: 1px; background: #26282b; margin: 4px 6px; }
QPushButton, QToolButton { background: transparent; border: 1px solid #676b71; border-radius: 2px; padding: 4px 14px; color: #eceef0; min-height: 18px; }
QPushButton:hover, QToolButton:hover { background: #1b1c1e; border-color: #f4f6f8; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked { background: #37383a; border-color: #f4f6f8; }
QPushButton:default { background: #f4f6f8; color: #000000; border-color: #f4f6f8; font-weight: 600; }
QPushButton:disabled, QToolButton:disabled { color: #676b71; border-color: #26282b; }
QPushButton:focus, QToolButton:focus { outline: none; border: 2px solid #f4f6f8; }
QToolButton[autoRaise="true"] { background: transparent; border-color: transparent; }
QToolButton[autoRaise="true"]:hover { background: #1b1c1e; border-color: #26282b; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
  background-color: #050606; border: 1px solid #676b71; border-radius: 2px; padding: 3px 8px; color: #eceef0; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid #f4f6f8; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: #111214; border: 1px solid #3c3f44; selection-background-color: #37383a; selection-color: #eceef0; }
QProgressBar { background: #26282b; border: none; border-radius: 0; text-align: center; color: #eceef0; max-height: 6px; }
QProgressBar::chunk { background: #f4f6f8; border-radius: 0; }
QSlider::groove:horizontal { height: 4px; background: #26282b; border-radius: 0; }
QSlider::sub-page:horizontal { background: #f4f6f8; border-radius: 0; }
QSlider::handle:horizontal { background: #111214; border: 2px solid #f4f6f8; width: 12px; margin: -6px 0; border-radius: 0; }
QScrollBar:vertical { width: 10px; background: transparent; margin: 0; }
QScrollBar:horizontal { height: 10px; background: transparent; margin: 0; }
QScrollBar::handle { background: #3c3f44; border-radius: 0; margin: 2px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #9a9ea4; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; border: none; }
QTabWidget::pane { border: 1px solid #26282b; border-radius: 4px; top: -1px; }
QTabBar::tab { background: transparent; border: none; padding: 6px 14px; color: #9a9ea4; }
QTabBar::tab:hover { color: #eceef0; }
QTabBar::tab:selected { color: #eceef0; border-bottom: 2px solid #f4f6f8; }
QGroupBox { border: 1px solid #26282b; border-radius: 4px; margin-top: 16px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #9a9ea4; font-weight: 600; }
QHeaderView::section { background: #111214; color: #9a9ea4; border: none; border-bottom: 1px solid #26282b; padding: 5px 8px; font-weight: 600; }
QTableView, QTreeView, QListView { background: #050606; alternate-background-color: #111214; gridline-color: #26282b; border: 1px solid #26282b; border-radius: 4px; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected { background: #37383a; color: #eceef0; border-left: 3px solid #f4f6f8; }
QToolTip { background: #1b1c1e; color: #eceef0; border: 1px solid #3c3f44; border-radius: 2px; padding: 4px 8px; }
QStatusBar { background: #111214; color: #9a9ea4; border-top: 1px solid #26282b; }
QSplitter::handle { background: #26282b; }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid #676b71; background: #050606; border-radius: 0; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #f4f6f8; border-color: #f4f6f8; }
