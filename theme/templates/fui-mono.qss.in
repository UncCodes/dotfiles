QScrollBar::handle { background: #3c3f44; border-radius: 0; margin: 2px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #9a9ea4; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; border: none; }
