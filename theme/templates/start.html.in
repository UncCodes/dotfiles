<!doctype html>
<!--BANNER-->
<!-- fui // the browser start page, {{mode}} theme: the company intranet. fui setup firefox installs it. -->
<html lang="en" data-theme="{{mode}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{brand_name}}</title>
<style>
  :root {
    color-scheme: {{scheme}};
    --bg: {{bg}}; --panel: {{panel}}; --raised: {{raised}}; --well: {{well}}; --line: {{line}}; --line-hi: {{line_hi}};
    --text: {{text}}; --muted: {{muted}}; --faint: {{faint}};
    --accent: {{accent}}; --accent-hi: {{accent_hi}}; --accent-dim: {{accent_dim}}; --on-accent: {{on_accent}};
    --ok: {{ok}}; --warn: {{warn}}; --glass: {{glass}}; --hi: {{hi}};
    --brand: "{{font_brand}}", sans-serif; --ui: "{{font_ui}}", system-ui, sans-serif; --mono: "{{font_mono}}", ui-monospace, monospace;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { min-height: 100%; }
  body { background: var(--bg); color: var(--text); font: 15px/1.6 var(--ui); }
  /* the company network behind everything, fading towards the bottom */
  .backdrop { position: fixed; inset: 0; z-index: -1; pointer-events: none; transform: scale(1.1);
    -webkit-mask: linear-gradient(#000 0%, rgba(0,0,0,.6) 55%, rgba(0,0,0,.15) 100%);
            mask: linear-gradient(#000 0%, rgba(0,0,0,.6) 55%, rgba(0,0,0,.15) 100%); }
  .backdrop svg { position: absolute; inset: 0; width: 100%; height: 100%; }

  /* the masthead: mark, company, division; a status line on the right */
  header { display: flex; align-items: center; gap: 16px; padding: 18px 32px; border-bottom: 1px solid var(--line);
    background: var(--glass); backdrop-filter: blur(10px); }
  .name { font: 400 18px/1 var(--brand); letter-spacing: .18em; }
  .division { margin-top: 6px; font: 600 10px/1 var(--ui); letter-spacing: .22em; color: var(--muted); }
  .status { margin-left: auto; display: flex; gap: 18px; font: 500 11px/1 var(--mono); color: var(--muted); letter-spacing: .08em; }
  .status b { color: var(--text); font-weight: 600; }
  .dot { display: inline-block; width: 7px; height: 7px; margin-right: 6px; border-radius: 1px; background: var(--ok); vertical-align: 1px; }

  main { max-width: 1040px; margin: 0 auto; padding: 48px 32px 32px; display: grid; gap: 20px; grid-template-columns: 2fr 1fr; }
  /* a panel: flat, a hairline, a header plate with the accent stripe and an asset code */
  .panel { background: var(--glass); border: 1px solid var(--line); border-radius: 6px; backdrop-filter: blur(10px); overflow: hidden; }
  .plate { display: flex; align-items: center; gap: 10px; height: 34px; padding: 0 14px 0 12px;
    border-bottom: 1px solid var(--line); box-shadow: inset 3px 0 0 var(--accent), inset 0 1px 0 var(--hi); }
  .plate h2 { font: 600 11px/1 var(--ui); letter-spacing: .2em; text-transform: uppercase; }
  .plate .code { margin-left: auto; font: 500 10px/1 var(--mono); color: var(--faint); letter-spacing: .06em; }
  .body { padding: 18px; }
  .search { grid-column: 1 / -1; }
  form { display: flex; gap: 10px; }
  input { flex: 1; height: 44px; padding: 0 14px; font: 15px var(--ui); color: var(--text);
    background: var(--well); border: 1px solid var(--line-hi); border-radius: 4px; outline: none; }
  input:focus { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  button { height: 44px; padding: 0 22px; font: 600 12px var(--ui); letter-spacing: .16em; text-transform: uppercase;
    color: var(--on-accent); background: var(--accent); border: 0; border-radius: 4px; cursor: pointer; }
  button:hover { background: var(--accent-hi); }
  /* directory tiles */
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .tiles a { display: block; padding: 12px 14px; color: var(--text); text-decoration: none; background: var(--raised);
    border: 1px solid var(--line); border-radius: 4px; transition: border-color .15s, box-shadow .15s; }
  .tiles a:hover { border-color: var(--accent); box-shadow: inset 3px 0 0 var(--accent); }
  .tiles .t { font-weight: 600; }
  .tiles .u { font: 11px var(--mono); color: var(--muted); }
  /* the clock */
  .clock { font: 400 46px/1 var(--brand); letter-spacing: .06em; font-variant-numeric: tabular-nums; }
  .clock small { font-size: 18px; color: var(--muted); }
  .date { margin-top: 10px; font: 600 11px/1 var(--ui); letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  .meta { margin-top: 18px; display: grid; gap: 6px; font: 12px var(--mono); color: var(--muted); }
  .meta span { color: var(--text); }
  footer { max-width: 1040px; margin: 0 auto; padding: 0 32px 40px; display: flex; justify-content: space-between;
    font: 500 10px/1.5 var(--mono); color: var(--faint); letter-spacing: .06em; }
  @media (max-width: 760px) { main { grid-template-columns: 1fr; } .status { display: none; } }
</style>
</head>
<body>
<div class="backdrop" aria-hidden="true">{{lines}}{{beads}}</div>
<header>
  {{mark}}
  <div><div class="name">{{brand_name}}</div><div class="division">{{brand_division}}</div></div>
  <div class="status"><span><span class="dot"></span>SECURE LINK</span><span>OPERATOR <b>__USER__</b></span><span>NODE <b>__HOST__</b></span></div>
</header>
<main>
  <section class="panel search">
    <div class="plate"><h2>Search</h2><span class="code">SRCH-01</span></div>
    <div class="body">
      <form action="https://duckduckgo.com/" method="get">
        <input name="q" autofocus autocomplete="off" placeholder="Search the network" aria-label="Search">
        <button type="submit">Query</button>
      </form>
    </div>
  </section>
  <section class="panel">
    <div class="plate"><h2>Directory</h2><span class="code">DIR-02</span></div>
    <div class="body tiles">
      <a href="https://aljulandani.dev"><div class="t">Portfolio</div><div class="u">aljulandani.dev</div></a>
      <a href="https://github.com"><div class="t">Repositories</div><div class="u">github.com</div></a>
      <a href="https://wiki.archlinux.org"><div class="t">Reference</div><div class="u">wiki.archlinux.org</div></a>
      <a href="https://forum.endeavouros.com"><div class="t">Support</div><div class="u">endeavouros.com</div></a>
      <a href="https://www.youtube.com"><div class="t">Media</div><div class="u">youtube.com</div></a>
      <a href="https://mail.google.com"><div class="t">Mail</div><div class="u">mail.google.com</div></a>
    </div>
  </section>
  <section class="panel">
    <div class="plate"><h2>Local time</h2><span class="code">CLK-03</span></div>
    <div class="body">
      <div class="clock" id="clock">00:00<small>:00</small></div>
      <div class="date" id="date"></div>
      <div class="meta"><div>THEME <span>{{mode}}</span></div><div>SHIFT <span id="shift"></span></div></div>
    </div>
  </section>
</main>
<footer><span>{{brand_notice}}</span><span>{{brand_motto}}</span></footer>
<script>
  (function () {
    var pad = function (n) { return (n < 10 ? "0" : "") + n; };
    function tick() {
      var d = new Date(), h = d.getHours();
      document.getElementById("clock").innerHTML = pad(h) + ":" + pad(d.getMinutes()) + "<small>:" + pad(d.getSeconds()) + "</small>";
      document.getElementById("date").textContent = d.toLocaleDateString(undefined, { weekday: "long", day: "numeric", month: "long", year: "numeric" });
      document.getElementById("shift").textContent = h < 6 ? "night" : h < 14 ? "day" : h < 22 ? "evening" : "night";
    }
    tick(); setInterval(tick, 1000);
  })();
</script>
</body>
</html>
