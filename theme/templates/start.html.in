<!doctype html>
<!--BANNER-->
<!-- fui // the browser start page: the workstation's own page. One file for every edition and
     display tier; fui renders it with the machine's names, data-theme and data-display set
     (fui setup firefox). -->
<html lang="en" data-theme="__EDITION__" data-display="__DISPLAY__">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>__HOST__</title>
<style>
  {{palettes}}
  :root {
    --hair: {{hair}}; --stripe: {{stripe}};
    --brand: "{{font_brand}}", "{{font_ui}}", sans-serif; --ui: "{{font_ui}}", system-ui, sans-serif;
    --mono: "{{font_mono}}", ui-monospace, monospace; --ease: cubic-bezier(.25, .9, .25, 1);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { min-height: 100%; }
  body { background: var(--floor); color: var(--ink); font: 15px/1.45 var(--ui); }
  html[data-display="deep"] body { background: var(--void); }   /* true black outside the panels */
  ::selection { background: var(--signal); color: var(--on-signal); }

  /* the survey field behind everything, fading towards the bottom; no text */
  .backdrop { position: fixed; inset: 0; z-index: -1; pointer-events: none; transform: scale(1.1);
    -webkit-mask: linear-gradient(#000 0%, rgba(0,0,0,.6) 55%, rgba(0,0,0,.15) 100%);
            mask: linear-gradient(#000 0%, rgba(0,0,0,.6) 55%, rgba(0,0,0,.15) 100%); }
  .backdrop svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .backdrop .l { color: var(--arc); } .backdrop .b { color: var(--bead); }
  .map { display: none; } .map[data-for="{{default}}"] { display: block; }
  html[data-theme] .map { display: none; }
  {{maps_css}}

  /* the masthead: the distribution's logo, the host, the OS; true readouts on the right */
  header { display: flex; align-items: center; gap: 16px; padding: 16px 32px;
    border-bottom: var(--hair) solid var(--rule); background: var(--glass); backdrop-filter: blur(10px); }
  .logo { font: 400 34px/1 "{{font_mono}}", monospace; color: var(--signal); }
  .name { font: 400 18px/1 var(--brand); letter-spacing: .18em; }
  .division { margin-top: 6px; font: 600 10px/1 var(--mono); letter-spacing: .16em; color: var(--muted); }
  .status { margin-left: auto; display: flex; gap: 8px; }

  /* bracketed readout: [ LABEL  value ] */
  .ro { font: 500 11px/1 var(--mono); letter-spacing: .08em; color: var(--muted); white-space: nowrap; }
  .ro::before { content: "[ "; color: var(--faint); } .ro::after { content: " ]"; color: var(--faint); }
  .ro b { margin-left: 6px; color: var(--ink); font-weight: 600; letter-spacing: 0; }
  /* icons: one family (Material Design outline, Nerd Font), in the data face's size */
  .ic { font: normal 400 1.15em/1 "{{font_mono}}", monospace; font-style: normal; vertical-align: -0.1em; margin-right: 6px; }
  .plate .ic { color: var(--signal); }
  .ro .ic { color: var(--muted); margin-right: 4px; }
  .rows .ic { width: 1.4em; color: var(--muted); }
  .rows a:hover .ic, .rows a:focus-visible .ic { color: var(--signal); }
  button .ic { margin-right: 8px; }

  main { max-width: 1040px; margin: 0 auto; padding: 40px 32px 32px; display: grid; gap: 16px; grid-template-columns: 2fr 1fr; }

  /* a panel: flat, a hairline, a header plate with the signal stripe and a code */
  .panel { background: var(--glass); border: var(--hair) solid var(--rule); border-radius: 4px; backdrop-filter: blur(10px); overflow: hidden; }
  .plate { display: flex; align-items: center; gap: 10px; height: 34px; padding: 0 14px 0 12px;
    border-bottom: var(--hair) solid var(--rule); box-shadow: inset var(--stripe) 0 0 var(--signal); }
  .plate h2 { font: 700 11px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; }
  .plate .code { margin-left: auto; font: 500 10px/1 var(--mono); color: var(--faint); letter-spacing: .06em; }
  .body { padding: 16px; }
  .search { grid-column: 1 / -1; }
  label.lbl { display: block; margin-bottom: 6px; font: 500 11px/1.25 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  form { display: flex; gap: 8px; }
  input { flex: 1; height: 40px; padding: 0 12px; font: 15px var(--ui); color: var(--ink); caret-color: var(--signal);
    background: var(--well); border: var(--hair) solid var(--edge); border-radius: 2px; outline: none; }
  input:focus { border-color: var(--signal); box-shadow: inset 0 0 0 1px var(--signal); }
  button { height: 40px; padding: 0 22px; font: 700 12px var(--mono); letter-spacing: .14em; text-transform: uppercase;
    color: var(--on-signal); background: var(--signal); border: 0; border-radius: 2px; cursor: pointer;
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px); }
  button:hover { background: var(--signal-hi); }
  button:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }

  /* the directory: flat rows, an index code on the right; focus draws brackets */
  .rows { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 16px; }
  .rows a { --c: transparent; display: flex; align-items: baseline; gap: 12px; padding: 9px 10px; color: var(--ink);
    text-decoration: none; border-left: var(--stripe) solid transparent; border-radius: 2px;
    background:
      linear-gradient(var(--c) 0 0) top left / 10px 2px, linear-gradient(var(--c) 0 0) top left / 2px 10px,
      linear-gradient(var(--c) 0 0) top right / 10px 2px, linear-gradient(var(--c) 0 0) top right / 2px 10px,
      linear-gradient(var(--c) 0 0) bottom left / 10px 2px, linear-gradient(var(--c) 0 0) bottom left / 2px 10px,
      linear-gradient(var(--c) 0 0) bottom right / 10px 2px, linear-gradient(var(--c) 0 0) bottom right / 2px 10px;
    background-repeat: no-repeat; transition: background-color 60ms var(--ease); }
  .rows a:hover { background-color: var(--raised); }
  .rows a:focus-visible { --c: var(--signal); outline: none; background-color: var(--signal-dim); border-left-color: var(--signal); }
  .rows .t { font-weight: 600; }
  .rows .u { font: 11px var(--mono); color: var(--muted); }
  .rows .i { margin-left: auto; font: 500 10px var(--mono); color: var(--faint); letter-spacing: .06em; }

  /* local time: the big numeral, framed by brackets */
  .frame { position: relative; padding: 14px 16px 12px; }
  .frame::before { content: ""; position: absolute; inset: 0; pointer-events: none;
    --a: 14px; --w: var(--hair); --k: var(--rule-hi);
    background:
      linear-gradient(var(--k) 0 0) top left / var(--a) var(--w), linear-gradient(var(--k) 0 0) top left / var(--w) var(--a),
      linear-gradient(var(--k) 0 0) top right / var(--a) var(--w), linear-gradient(var(--k) 0 0) top right / var(--w) var(--a),
      linear-gradient(var(--k) 0 0) bottom left / var(--a) var(--w), linear-gradient(var(--k) 0 0) bottom left / var(--w) var(--a),
      linear-gradient(var(--k) 0 0) bottom right / var(--a) var(--w), linear-gradient(var(--k) 0 0) bottom right / var(--w) var(--a);
    background-repeat: no-repeat; }
  .clock { font: 400 46px/1 var(--brand); letter-spacing: .02em; font-variant-numeric: tabular-nums; }
  .clock small { font-size: 18px; color: var(--muted); }
  .date { margin-top: 10px; font: 500 11px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .meter { margin-top: 16px; display: flex; align-items: center; gap: 10px; font: 500 11px/1 var(--mono); color: var(--muted); letter-spacing: .1em; }
  .seg { display: flex; gap: 3px; }
  .seg i { width: 7px; height: 14px; background: var(--rule); }
  .seg i.on { background: var(--signal); }
  html[data-display="crt"] .seg i:not(.on) { background: none; box-shadow: inset 0 0 0 1px var(--rule-hi); }
  .meter b { color: var(--ink); font-weight: 600; letter-spacing: 0; font-variant-numeric: tabular-nums slashed-zero; }
  .meta { margin-top: 16px; display: grid; gap: 6px; }

  footer { max-width: 1040px; margin: 0 auto; padding: 0 32px 40px; display: flex; justify-content: space-between; gap: 16px;
    font: 500 11px/1.5 var(--mono); color: var(--muted); letter-spacing: .04em; }
  footer span + span { color: var(--faint); }

  /* a tube: no translucency, a 3% safe inset, nothing under 11 px */
  html[data-display="crt"] header, html[data-display="crt"] .panel { backdrop-filter: none; }
  html[data-display="crt"] body { padding: 3vh 3vw; }
  @media (max-width: 760px) { main { grid-template-columns: 1fr; } .status { display: none; } .rows { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>
</head>
<body>
<div class="backdrop" aria-hidden="true">{{maps}}</div>
<header>
  <span class="logo" aria-hidden="true">__LOGO__</span>
  <div><div class="name">__HOST__</div><div class="division">__OS__</div></div>
  <div class="status">
    <span class="ro">{{i_edition}}EDITION<b>__EDITION__</b></span><span class="ro">{{i_lcd}}DISPLAY<b>__DISPLAY__</b></span>
    <span class="ro">{{i_operator}}OPERATOR<b>__USER__</b></span><span class="ro">{{i_node}}NODE<b>__HOST__</b></span>
  </div>
</header>
<main>
  <section class="panel search">
    <div class="plate"><h2>{{i_search}}Search</h2><span class="code">SRCH-01</span></div>
    <div class="body">
      <label class="lbl" for="q">Query the network</label>
      <form action="https://duckduckgo.com/" method="get">
        <input id="q" name="q" autofocus autocomplete="off" placeholder="Search">
        <button type="submit">{{i_search}}Query</button>
      </form>
    </div>
  </section>
  <section class="panel">
    <div class="plate"><h2>{{i_directory}}Directory</h2><span class="code">DIR-02</span></div>
    <div class="body rows">
      <a href="https://aljulandani.dev">{{i_portfolio}}<span class="t">Portfolio</span><span class="u">aljulandani.dev</span><span class="i">01</span></a>
      <a href="https://github.com">{{i_github}}<span class="t">Repositories</span><span class="u">github.com</span><span class="i">02</span></a>
      <a href="https://wiki.archlinux.org">{{i_reference}}<span class="t">Reference</span><span class="u">wiki.archlinux.org</span><span class="i">03</span></a>
      <a href="https://forum.endeavouros.com">{{i_support}}<span class="t">Support</span><span class="u">endeavouros.com</span><span class="i">04</span></a>
      <a href="https://www.youtube.com">{{i_media}}<span class="t">Media</span><span class="u">youtube.com</span><span class="i">05</span></a>
      <a href="https://mail.google.com">{{i_mail}}<span class="t">Mail</span><span class="u">mail.google.com</span><span class="i">06</span></a>
    </div>
  </section>
  <section class="panel">
    <div class="plate"><h2>{{i_clock}}Local time</h2><span class="code">CLK-03</span></div>
    <div class="body">
      <div class="frame">
        <div class="clock" id="clock" aria-live="off">00:00<small>:00</small></div>
        <div class="date" id="date"></div>
      </div>
      <div class="meter" aria-label="share of the day elapsed">{{i_timer}}DAY <span class="seg" id="seg"></span> <b id="pct">0%</b></div>
      <div class="meta"><span class="ro">{{i_calendar}}ISO<b id="iso"></b></span><span class="ro">{{i_shift}}SHIFT<b id="shift"></b></span></div>
    </div>
  </section>
</main>
<footer><span>{{i_info}}{{notice}}</span><span>{{i_kernel}}KERNEL __KERNEL__</span></footer>
<script>
  (function () {
    var N = 12, pad = function (n) { return (n < 10 ? "0" : "") + n; };
    var seg = document.getElementById("seg");
    for (var i = 0; i < N; i++) seg.appendChild(document.createElement("i"));
    var cells = seg.children;
    function tick() {
      var d = new Date(), h = d.getHours();
      document.getElementById("clock").innerHTML = pad(h) + ":" + pad(d.getMinutes()) + "<small>:" + pad(d.getSeconds()) + "</small>";
      document.getElementById("date").textContent =
        d.toLocaleDateString("en-GB", { weekday: "short", day: "2-digit", month: "short" }).replace(",", "");
      document.getElementById("iso").textContent = d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());
      document.getElementById("shift").textContent = h < 6 ? "night" : h < 14 ? "day" : h < 22 ? "evening" : "night";
      var share = (h * 3600 + d.getMinutes() * 60 + d.getSeconds()) / 86400;      // a meter rounds down
      var on = Math.floor(share * N);
      for (var j = 0; j < N; j++) cells[j].className = j < on ? "on" : "";
      document.getElementById("pct").textContent = Math.floor(share * 100) + "%";
    }
    tick(); setInterval(tick, 1000);
  })();
</script>
</body>
</html>
