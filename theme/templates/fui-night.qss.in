/* GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file. */

/* fui: Qt, night theme, applied to every Qt6 app through qt6ct. (No double slashes in this file: qt6ct strips them as comments.) */
QWidget { background-color: #07090c; color: #e6ebf0; selection-background-color: #00c2d1; selection-color: #00171a; }
QMainWindow, QDialog { background-color: #07090c; }
QMenuBar { background: #0e1217; border-bottom: 1px solid #232a33; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: #06353b; border-radius: 4px; }
QMenu { background-color: #0e1217; border: 1px solid #36424f; border-top: 2px solid #00c2d1; border-radius: 6px; padding: 4px; }
QMenu::item { padding: 5px 18px 5px 12px; border-radius: 4px; }
QMenu::item:selected { background-color: #06353b; color: #e6ebf0; border-left: 3px solid #00c2d1; }
QMenu::separator { height: 1px; background: #232a33; margin: 4px 6px; }
QPushButton, QToolButton { background: #151a21; border: 1px solid #36424f; border-radius: 4px; padding: 4px 14px; color: #e6ebf0; min-height: 18px; }
QPushButton:hover, QToolButton:hover { border-color: #00c2d1; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked { background: #06353b; border-color: #00c2d1; }
QPushButton:default { background: #00c2d1; color: #00171a; border-color: #00c2d1; font-weight: 600; }
QPushButton:disabled { color: rgba(230, 235, 240, 45%); }
QToolButton[autoRaise="true"] { background: transparent; border-color: transparent; }
QToolButton[autoRaise="true"]:hover { background: #151a21; border-color: #232a33; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
  background-color: #0a0d11; border: 1px solid #36424f; border-radius: 4px; padding: 3px 8px; color: #e6ebf0; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid #00c2d1; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: #0e1217; border: 1px solid #36424f; selection-background-color: #00c2d1; selection-color: #00171a; }
QProgressBar { background: #232a33; border: none; border-radius: 2px; text-align: center; color: #e6ebf0; max-height: 6px; }
QProgressBar::chunk { background: #00c2d1; border-radius: 2px; }
QSlider::groove:horizontal { height: 4px; background: #232a33; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #00c2d1; border-radius: 2px; }
QSlider::handle:horizontal { background: #0e1217; border: 2px solid #00c2d1; width: 12px; margin: -6px 0; border-radius: 3px; }
QScrollBar:vertical { width: 10px; background: transparent; margin: 0; }
QScrollBar:horizontal { height: 10px; background: transparent; margin: 0; }
QScrollBar::handle { background: #36424f; border-radius: 2px; margin: 2px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #8b96a3; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; border: none; }
QTabWidget::pane { border: 1px solid #232a33; border-radius: 6px; top: -1px; }
QTabBar::tab { background: transparent; border: none; padding: 6px 14px; color: #8b96a3; }
QTabBar::tab:hover { color: #e6ebf0; }
QTabBar::tab:selected { color: #e6ebf0; border-bottom: 2px solid #00c2d1; }
QGroupBox { border: 1px solid #232a33; border-radius: 6px; margin-top: 16px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #8b96a3; font-weight: 600; }
QHeaderView::section { background: #0e1217; color: #8b96a3; border: none; border-bottom: 1px solid #232a33; padding: 5px 8px; font-weight: 600; }
QTableView, QTreeView, QListView { background: #0a0d11; alternate-background-color: #0e1217; gridline-color: #232a33; border: 1px solid #232a33; border-radius: 6px; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected { background: #00c2d1; color: #00171a; }
QToolTip { background: #07090c; color: #d7dee5; border: 1px solid #36424f; border-radius: 4px; padding: 4px 8px; }
QStatusBar { background: #0e1217; color: #8b96a3; border-top: 1px solid #232a33; }
QSplitter::handle { background: #232a33; }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid #36424f; background: #0a0d11; }
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #00c2d1; border-color: #00c2d1; }
