/* GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file. */

/* fui: Qt, dark theme, applied to every Qt6 app through qt6ct. (No double slashes in this file: qt6ct strips them as comments.) */
QWidget { background-color: #0c0a09; color: #f5f2f0; selection-background-color: #1f7a34; selection-color: #ffffff; }
QMainWindow, QDialog { background-color: #0c0a09; }
QMenuBar { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2ab2a9, stop:0.46 #1d7c76, stop:0.54 #186762, stop:1 #1c7872); color: #ffffff; border-bottom: 1px solid #0f3e3b; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: rgba(255, 255, 255, 18%); border-radius: 4px; }
QMenu { background-color: #171412; border: 1px solid rgba(74, 244, 131, 40%); border-radius: 10px; padding: 4px; }
QMenu::item { padding: 4px 18px 4px 12px; border-radius: 6px; }
QMenu::item:selected { background-color: #1f7a34; color: #ffffff; }
QMenu::separator { height: 1px; background: rgba(74, 244, 131, 40%); margin: 4px 6px; }
QPushButton, QToolButton { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #33312f, stop:0.45 #33312f, stop:0.55 #1c1917, stop:1 #1c1917); border: 1px solid rgba(74, 244, 131, 40%); border-radius: 12px; padding: 3px 14px; color: #f5f2f0; min-height: 18px; }
QPushButton:hover, QToolButton:hover { border-color: #1f7a34; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked { background: #080706; }
QPushButton:default { background: #1f7a34; color: #ffffff; border-color: #165524; }
QPushButton:disabled { color: rgba(245, 242, 240, 45%); }
QToolButton[autoRaise="true"] { background: transparent; border-color: transparent; }
QToolButton[autoRaise="true"]:hover { background: #080706; border-color: rgba(74, 244, 131, 40%); }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
  background-color: #080706; border: 1px solid rgba(74, 244, 131, 40%); border-radius: 11px; padding: 2px 8px; color: #f5f2f0; }
QTextEdit, QPlainTextEdit { border-radius: 6px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #1f7a34; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: #171412; border: 1px solid rgba(74, 244, 131, 40%); selection-background-color: #1f7a34; selection-color: #ffffff; }
QProgressBar { background: #b9c4a6; border: 1px solid rgba(74, 244, 131, 40%); border-radius: 3px; text-align: center; color: #17220f; min-height: 10px; }
QProgressBar::chunk { background: #17220f; border-radius: 2px; margin: 1px; }
QSlider::groove:horizontal { height: 6px; background: #080706; border: 1px solid rgba(74, 244, 131, 40%); border-radius: 3px; }
QSlider::sub-page:horizontal { background: #1f7a34; border-radius: 3px; }
QSlider::handle:horizontal { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #33312f, stop:0.45 #33312f, stop:0.55 #1c1917, stop:1 #1c1917); border: 1px solid rgba(74, 244, 131, 40%); width: 16px; margin: -6px 0; border-radius: 8px; }
QScrollBar:vertical { width: 14px; background: #080706; margin: 0; }
QScrollBar:horizontal { height: 14px; background: #080706; margin: 0; }
QScrollBar::handle { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #33312f, stop:0.45 #33312f, stop:0.55 #1c1917, stop:1 #1c1917); border: 1px solid rgba(74, 244, 131, 40%); border-radius: 5px; margin: 2px; min-height: 24px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; border: none; }
QTabWidget::pane { border: 1px solid rgba(74, 244, 131, 40%); border-radius: 6px; top: -1px; }
QTabBar::tab { background: #1d2723; border: 1px solid rgba(74, 244, 131, 40%); border-bottom: none;
  border-top-left-radius: 4px; border-top-right-radius: 12px; padding: 4px 14px; color: #a8959a; }
QTabBar::tab:selected { background: #233e38; color: #f5f2f0; border-bottom: 2px solid #4fd1c0; }
QGroupBox { border: 1px solid rgba(74, 244, 131, 40%); border-radius: 6px; margin-top: 14px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #1f7a34; }
QHeaderView::section { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #33312f, stop:0.45 #33312f, stop:0.55 #1c1917, stop:1 #1c1917); color: #f5f2f0; border: none; border-right: 1px solid rgba(74, 244, 131, 40%); border-bottom: 1px solid rgba(74, 244, 131, 40%); padding: 4px 6px; }
QTableView, QTreeView, QListView { background: #080706; alternate-background-color: #100e0c; gridline-color: rgba(74, 244, 131, 40%); border: 1px solid rgba(74, 244, 131, 40%); border-radius: 6px; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected { background: #1f7a34; color: #ffffff; }
QToolTip { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #565c65, stop:0.46 #353a41, stop:0.54 #22262b, stop:1 #2e3238); color: #eef2f6; border: 1px solid #000000; border-radius: 6px; padding: 3px 6px; }
QStatusBar { background: #171412; color: #a8959a; border-top: 1px solid rgba(74, 244, 131, 40%); }
QSplitter::handle { background: rgba(74, 244, 131, 40%); }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid rgba(74, 244, 131, 40%); background: #080706; }
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #1f7a34; border-color: #165524; }
