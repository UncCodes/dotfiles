/* GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file. */

/* FUI // Qt: applied to every Qt6 app through qt6ct */
* { font-family: "JetBrainsMono Nerd Font"; }
QWidget { background-color: #EEF1F2; color: #141B1E; selection-background-color: rgba(31, 122, 135, 35%); selection-color: #0B1113; }
QMainWindow, QDialog { background-color: #EEF1F2; }

QPushButton, QToolButton { border-image: url(@HOME@/.config/qt6ct/assets-light/bracket.svg) 6 6 6 6 stretch; border-width: 6px; padding: 0 6px; background: rgba(255, 255, 255, 55%); color: #141B1E; min-height: 18px; }
QPushButton:hover, QToolButton:hover { border-image: url(@HOME@/.config/qt6ct/assets-light/bracket-hover.svg) 6 6 6 6 stretch; background: rgba(31, 122, 135, 10%); color: #0F5C68; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked { background: rgba(191, 221, 226, 70%); color: #0B1113; }
QPushButton:default { border-image: url(@HOME@/.config/qt6ct/assets-light/bracket-accent.svg) 6 6 6 6 stretch; background: rgba(191, 221, 226, 85%); }
QPushButton:disabled { color: rgba(91, 104, 109, 50%); border-image: none; border: 6px solid transparent; }
QToolButton[autoRaise="true"] { border-image: none; border: 6px solid transparent; background: transparent; }

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
  border-image: url(@HOME@/.config/qt6ct/assets-light/chamfer.svg) 8 8 8 8 stretch; border-width: 6px; background: rgba(230, 234, 235, 75%); color: #141B1E; padding: 0 2px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border-image: url(@HOME@/.config/qt6ct/assets-light/chamfer-focus.svg) 8 8 8 8 stretch; }
QComboBox::drop-down { border: none; width: 14px; }
QComboBox QAbstractItemView { background: #F7F9F9; border: 1px solid rgba(31, 122, 135, 50%); selection-background-color: rgba(31, 122, 135, 15%); }

QCheckBox::indicator, QGroupBox::indicator { width: 14px; height: 14px; image: url(@HOME@/.config/qt6ct/assets-light/check.svg); }
QCheckBox::indicator:checked { image: url(@HOME@/.config/qt6ct/assets-light/check-on.svg); }
QCheckBox::indicator:indeterminate { image: url(@HOME@/.config/qt6ct/assets-light/check-mixed.svg); }
QRadioButton::indicator { width: 14px; height: 14px; image: url(@HOME@/.config/qt6ct/assets-light/radio.svg); }
QRadioButton::indicator:checked { image: url(@HOME@/.config/qt6ct/assets-light/radio-on.svg); }

QSlider::groove:horizontal { height: 2px; background: #C9D2D5; }
QSlider::groove:vertical { width: 2px; background: #C9D2D5; }
QSlider::sub-page:horizontal { background: #1F7A87; }
QSlider::handle { image: url(@HOME@/.config/qt6ct/assets-light/thumb.svg); width: 14px; height: 14px; margin: -6px; }

QProgressBar { border: 1px solid #C9D2D5; background: #E6EAEB; text-align: center; color: #141B1E; min-height: 8px; }
QProgressBar::chunk { background-color: #1F7A87; width: 4px; margin: 1px 1px; }

QScrollBar:vertical { width: 6px; background: transparent; margin: 0; }
QScrollBar:horizontal { height: 6px; background: transparent; margin: 0; }
QScrollBar::handle { background: rgba(31, 122, 135, 35%); min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: rgba(31, 122, 135, 60%); }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; border: none; }

QTabWidget::pane { border: 1px solid #C9D2D5; top: -1px; }
QTabBar::tab { border-image: url(@HOME@/.config/qt6ct/assets-light/tab.svg) 8 8 0 8 stretch; border-width: 8px 8px 0 8px; padding: 2px 10px; color: #5B686D; background: transparent; }
QTabBar::tab:selected { border-image: url(@HOME@/.config/qt6ct/assets-light/tab-active.svg) 8 8 0 8 stretch; color: #0F5C68; }

QMenuBar { background: #E6EAEB; border-bottom: 1px solid #C9D2D5; }
QMenuBar::item:selected { background: rgba(31, 122, 135, 12%); color: #0F5C68; }
QMenu { border-image: url(@HOME@/.config/qt6ct/assets-light/chamfer-lg.svg) 12 12 12 12 stretch; border-width: 10px; background: rgba(247, 249, 249, 88%); }
QMenu::item { padding: 4px 18px 4px 10px; }
QMenu::item:selected { background: rgba(31, 122, 135, 12%); color: #0F5C68; border-left: 2px solid #1F7A87; }
QMenu::separator { height: 1px; background: #A9B6BB; margin: 4px 6px; }

QGroupBox { border-image: url(@HOME@/.config/qt6ct/assets-light/chamfer.svg) 8 8 8 8 stretch; border-width: 6px; margin-top: 14px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0 4px; color: #1F7A87; }
QHeaderView::section { background: #E6EAEB; color: #5B686D; border: none; border-bottom: 1px solid #C9D2D5; border-right: 1px solid #C9D2D5; padding: 4px 6px; }
QTableView, QTreeView, QListView { background: transparent; alternate-background-color: rgba(225, 232, 234, 50%); gridline-color: #C9D2D5; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected { background: rgba(31, 122, 135, 12%); color: #0F5C68; }
QToolTip { background: #E6EAEB; color: #141B1E; border: 1px solid rgba(31, 122, 135, 50%); padding: 3px 6px; }
QStatusBar { background: #E6EAEB; color: #5B686D; border-top: 1px solid #C9D2D5; }
QSplitter::handle { background: #C9D2D5; }
