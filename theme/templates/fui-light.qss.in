/* GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file. */

/* fui // Qt · light theme: applied to every Qt6 app through qt6ct */
QWidget { background-color: #FDFCFC; color: #251D18; selection-background-color: #0940D7; selection-color: #ffffff; }
QMainWindow, QDialog { background-color: #FDFCFC; }
QMenuBar { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #865EC9, stop:0.46 #6339AC, stop:0.54 #583399, stop:1 #6138A8); color: #FFFFFF; border-bottom: 1px solid #422673; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: rgba(255, 255, 255, 0.18); border-radius: 4px; }
QMenu { background-color: #FFFFFF; border: 1px solid rgba(110, 85, 90, 0.420); border-radius: 10px; padding: 4px; }
QMenu::item { padding: 4px 18px 4px 12px; border-radius: 6px; }
QMenu::item:selected { background-color: #0940D7; color: #ffffff; }
QMenu::separator { height: 1px; background: rgba(110, 85, 90, 0.420); margin: 4px 6px; }
QPushButton, QToolButton { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.45 #FFFFFF, stop:0.55 #FFFFFF, stop:1 #FFFFFF); border: 1px solid rgba(110, 85, 90, 0.420); border-radius: 12px; padding: 3px 14px; color: #251D18; min-height: 18px; }
QPushButton:hover, QToolButton:hover { border-color: #0940D7; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked { background: #FDFDFD; }
QPushButton:default { background: #0940D7; color: #ffffff; border-color: #062D96; }
QPushButton:disabled { color: rgba(37, 29, 24, 0.451); }
QToolButton[autoRaise="true"] { background: transparent; border-color: transparent; }
QToolButton[autoRaise="true"]:hover { background: #FDFDFD; border-color: rgba(110, 85, 90, 0.420); }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
  background-color: #FDFDFD; border: 1px solid rgba(110, 85, 90, 0.420); border-radius: 11px; padding: 2px 8px; color: #251D18; }
QTextEdit, QPlainTextEdit { border-radius: 6px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #0940D7; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: #FFFFFF; border: 1px solid rgba(110, 85, 90, 0.420); selection-background-color: #0940D7; selection-color: #ffffff; }
QProgressBar { background: #B9C4A6; border: 1px solid rgba(110, 85, 90, 0.420); border-radius: 3px; text-align: center; color: #17220F; min-height: 10px; }
QProgressBar::chunk { background: #17220F; border-radius: 2px; margin: 1px; }
QSlider::groove:horizontal { height: 6px; background: #FDFDFD; border: 1px solid rgba(110, 85, 90, 0.420); border-radius: 3px; }
QSlider::sub-page:horizontal { background: #0940D7; border-radius: 3px; }
QSlider::handle:horizontal { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.45 #FFFFFF, stop:0.55 #FFFFFF, stop:1 #FFFFFF); border: 1px solid rgba(110, 85, 90, 0.420); width: 16px; margin: -6px 0; border-radius: 8px; }
QScrollBar:vertical { width: 14px; background: #FDFDFD; margin: 0; }
QScrollBar:horizontal { height: 14px; background: #FDFDFD; margin: 0; }
QScrollBar::handle { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.45 #FFFFFF, stop:0.55 #FFFFFF, stop:1 #FFFFFF); border: 1px solid rgba(110, 85, 90, 0.420); border-radius: 5px; margin: 2px; min-height: 24px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; border: none; }
QTabWidget::pane { border: 1px solid rgba(110, 85, 90, 0.420); border-radius: 6px; top: -1px; }
QTabBar::tab { background: #E9F3F2; border: 1px solid rgba(110, 85, 90, 0.420); border-bottom: none;
  border-top-left-radius: 4px; border-top-right-radius: 12px; padding: 4px 14px; color: #6B575B; }
QTabBar::tab:selected { background: #CEE5E3; color: #251D18; border-bottom: 2px solid #1F8A80; }
QGroupBox { border: 1px solid rgba(110, 85, 90, 0.420); border-radius: 6px; margin-top: 14px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #0940D7; }
QHeaderView::section { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.45 #FFFFFF, stop:0.55 #FFFFFF, stop:1 #FFFFFF); color: #251D18; border: none; border-right: 1px solid rgba(110, 85, 90, 0.420); border-bottom: 1px solid rgba(110, 85, 90, 0.420); padding: 4px 6px; }
QTableView, QTreeView, QListView { background: #FDFDFD; alternate-background-color: #FEFEFE; gridline-color: rgba(110, 85, 90, 0.420); border: 1px solid rgba(110, 85, 90, 0.420); border-radius: 6px; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected { background: #0940D7; color: #ffffff; }
QToolTip { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #565C65, stop:0.46 #353A41, stop:0.54 #22262B, stop:1 #2E3238); color: #EEF2F6; border: 1px solid #000000; border-radius: 6px; padding: 3px 6px; }
QStatusBar { background: #FFFFFF; color: #6B575B; border-top: 1px solid rgba(110, 85, 90, 0.420); }
QSplitter::handle { background: rgba(110, 85, 90, 0.420); }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid rgba(110, 85, 90, 0.420); background: #FDFDFD; }
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #0940D7; border-color: #062D96; }
