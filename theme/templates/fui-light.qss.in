/* GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file. */

/* fui: Qt, light theme, applied to every Qt6 app through qt6ct. (No double slashes in this file: qt6ct strips them as comments.) */
QWidget { background-color: #fdfcfc; color: #251d18; selection-background-color: #0940d7; selection-color: #ffffff; }
QMainWindow, QDialog { background-color: #fdfcfc; }
QMenuBar { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #865ec9, stop:0.46 #6339ac, stop:0.54 #583399, stop:1 #6138a8); color: #ffffff; border-bottom: 1px solid #422673; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: rgba(255, 255, 255, 18%); border-radius: 4px; }
QMenu { background-color: #ffffff; border: 1px solid rgba(110, 85, 90, 42%); border-radius: 10px; padding: 4px; }
QMenu::item { padding: 4px 18px 4px 12px; border-radius: 6px; }
QMenu::item:selected { background-color: #0940d7; color: #ffffff; }
QMenu::separator { height: 1px; background: rgba(110, 85, 90, 42%); margin: 4px 6px; }
QPushButton, QToolButton { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:0.45 #ffffff, stop:0.55 #ffffff, stop:1 #ffffff); border: 1px solid rgba(110, 85, 90, 42%); border-radius: 12px; padding: 3px 14px; color: #251d18; min-height: 18px; }
QPushButton:hover, QToolButton:hover { border-color: #0940d7; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked { background: #fdfdfd; }
QPushButton:default { background: #0940d7; color: #ffffff; border-color: #062d96; }
QPushButton:disabled { color: rgba(37, 29, 24, 45%); }
QToolButton[autoRaise="true"] { background: transparent; border-color: transparent; }
QToolButton[autoRaise="true"]:hover { background: #fdfdfd; border-color: rgba(110, 85, 90, 42%); }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
  background-color: #fdfdfd; border: 1px solid rgba(110, 85, 90, 42%); border-radius: 11px; padding: 2px 8px; color: #251d18; }
QTextEdit, QPlainTextEdit { border-radius: 6px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #0940d7; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: #ffffff; border: 1px solid rgba(110, 85, 90, 42%); selection-background-color: #0940d7; selection-color: #ffffff; }
QProgressBar { background: #b9c4a6; border: 1px solid rgba(110, 85, 90, 42%); border-radius: 3px; text-align: center; color: #17220f; min-height: 10px; }
QProgressBar::chunk { background: #17220f; border-radius: 2px; margin: 1px; }
QSlider::groove:horizontal { height: 6px; background: #fdfdfd; border: 1px solid rgba(110, 85, 90, 42%); border-radius: 3px; }
QSlider::sub-page:horizontal { background: #0940d7; border-radius: 3px; }
QSlider::handle:horizontal { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:0.45 #ffffff, stop:0.55 #ffffff, stop:1 #ffffff); border: 1px solid rgba(110, 85, 90, 42%); width: 16px; margin: -6px 0; border-radius: 8px; }
QScrollBar:vertical { width: 14px; background: #fdfdfd; margin: 0; }
QScrollBar:horizontal { height: 14px; background: #fdfdfd; margin: 0; }
QScrollBar::handle { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:0.45 #ffffff, stop:0.55 #ffffff, stop:1 #ffffff); border: 1px solid rgba(110, 85, 90, 42%); border-radius: 5px; margin: 2px; min-height: 24px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; border: none; }
QTabWidget::pane { border: 1px solid rgba(110, 85, 90, 42%); border-radius: 6px; top: -1px; }
QTabBar::tab { background: #e9f3f2; border: 1px solid rgba(110, 85, 90, 42%); border-bottom: none;
  border-top-left-radius: 4px; border-top-right-radius: 12px; padding: 4px 14px; color: #6b575b; }
QTabBar::tab:selected { background: #cee5e3; color: #251d18; border-bottom: 2px solid #1f8a80; }
QGroupBox { border: 1px solid rgba(110, 85, 90, 42%); border-radius: 6px; margin-top: 14px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #0940d7; }
QHeaderView::section { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:0.45 #ffffff, stop:0.55 #ffffff, stop:1 #ffffff); color: #251d18; border: none; border-right: 1px solid rgba(110, 85, 90, 42%); border-bottom: 1px solid rgba(110, 85, 90, 42%); padding: 4px 6px; }
QTableView, QTreeView, QListView { background: #fdfdfd; alternate-background-color: #fefefe; gridline-color: rgba(110, 85, 90, 42%); border: 1px solid rgba(110, 85, 90, 42%); border-radius: 6px; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected { background: #0940d7; color: #ffffff; }
QToolTip { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #565c65, stop:0.46 #353a41, stop:0.54 #22262b, stop:1 #2e3238); color: #eef2f6; border: 1px solid #000000; border-radius: 6px; padding: 3px 6px; }
QStatusBar { background: #ffffff; color: #6b575b; border-top: 1px solid rgba(110, 85, 90, 42%); }
QSplitter::handle { background: rgba(110, 85, 90, 42%); }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid rgba(110, 85, 90, 42%); background: #fdfdfd; }
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #0940d7; border-color: #062d96; }
