QMenu::item:selected { background-color: #2c2052; color: #ede9f8; border-left: 3px solid #a47cff; }
QMenu::separator { height: 1px; background: #2a2346; margin: 4px 6px; }
QPushButton, QToolButton { background: transparent; border: 1px solid #6e63a3; border-radius: 2px; padding: 4px 14px; color: #ede9f8; min-height: 18px; }
