QMenu::item { padding: 5px 18px 5px 12px; border-radius: 2px; }
QMenu::item:selected { background-color: #062e33; color: #e6ebf0; border-left: 3px solid #00c2d1; }
QMenu::separator { height: 1px; background: #232a33; margin: 4px 6px; }
QPushButton, QToolButton { background: transparent; border: 1px solid #5c6773; border-radius: 2px; padding: 4px 14px; color: #e6ebf0; min-height: 18px; }
QPushButton:hover, QToolButton:hover { background: #181c21; border-color: #00c2d1; }
