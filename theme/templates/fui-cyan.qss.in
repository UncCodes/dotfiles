QScrollBar:horizontal { height: 10px; background: transparent; margin: 0; }
QScrollBar::handle { background: #36424f; border-radius: 0; margin: 2px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #8b96a3; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; border: none; }
QTabWidget::pane { border: 1px solid #232a33; border-radius: 4px; top: -1px; }
QTabBar::tab { background: transparent; border: none; padding: 6px 14px; color: #8b96a3; }
QTabBar::tab:hover { color: #e6ebf0; }
QTabBar::tab:selected { color: #e6ebf0; border-bottom: 2px solid #00c2d1; }
