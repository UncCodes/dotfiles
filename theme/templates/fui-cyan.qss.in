QToolButton[autoRaise="true"] { background: transparent; border-color: transparent; }
QToolButton[autoRaise="true"]:hover { background: #181c21; border-color: #232a33; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
  background-color: #050608; border: 1px solid #5c6773; border-radius: 2px; padding: 3px 8px; color: #e6ebf0; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid #00c2d1; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: #0e1217; border: 1px solid #36424f; selection-background-color: #062e33; selection-color: #e6ebf0; }
