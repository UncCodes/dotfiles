/* fui: Qt, edition cyan, applied to every Qt6 app through qt6ct. (No double slashes in this file: qt6ct strips them as comments.) */
QWidget { background-color: #07090c; color: #e6ebf0; selection-background-color: #00c2d1; selection-color: #000000; }
QMainWindow, QDialog { background-color: #07090c; }
QMenuBar { background: #0e1217; border-bottom: 1px solid #232a33; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
