/* GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file. */

/* fui: Qt, edition phosphor, applied to every Qt6 app through qt6ct. (No double slashes in this file: qt6ct strips them as comments.) */
QWidget { background-color: #050a07; color: #ddf5e4; selection-background-color: #3df58a; selection-color: #000000; }
QMainWindow, QDialog { background-color: #050a07; }
QMenuBar { background: #0b140f; border-bottom: 1px solid #1a2b20; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: #103921; border-radius: 2px; }
QMenu { background-color: #0b140f; border: 1px solid #2a4433; border-top: 2px solid #3df58a; border-radius: 4px; padding: 4px; }
QMenu::item { padding: 5px 18px 5px 12px; border-radius: 2px; }
QMenu::item:selected { background-color: #103921; color: #ddf5e4; border-left: 3px solid #3df58a; }
QMenu::separator { height: 1px; background: #1a2b20; margin: 4px 6px; }
QPushButton, QToolButton { background: transparent; border: 1px solid #56705f; border-radius: 2px; padding: 4px 14px; color: #ddf5e4; min-height: 18px; }
QPushButton:hover, QToolButton:hover { background: #141e19; border-color: #3df58a; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked { background: #103921; border-color: #3df58a; }
QPushButton:default { background: #3df58a; color: #000000; border-color: #3df58a; font-weight: 600; }
QPushButton:disabled, QToolButton:disabled { color: #56705f; border-color: #1a2b20; }
QPushButton:focus, QToolButton:focus { outline: none; border: 2px solid #3df58a; }
QToolButton[autoRaise="true"] { background: transparent; border-color: transparent; }
QToolButton[autoRaise="true"]:hover { background: #141e19; border-color: #1a2b20; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
  background-color: #030605; border: 1px solid #56705f; border-radius: 2px; padding: 3px 8px; color: #ddf5e4; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid #3df58a; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: #0b140f; border: 1px solid #2a4433; selection-background-color: #103921; selection-color: #ddf5e4; }
QProgressBar { background: #1a2b20; border: none; border-radius: 0; text-align: center; color: #ddf5e4; max-height: 6px; }
QProgressBar::chunk { background: #3df58a; border-radius: 0; }
QSlider::groove:horizontal { height: 4px; background: #1a2b20; border-radius: 0; }
QSlider::sub-page:horizontal { background: #3df58a; border-radius: 0; }
QSlider::handle:horizontal { background: #0b140f; border: 2px solid #3df58a; width: 12px; margin: -6px 0; border-radius: 0; }
QScrollBar:vertical { width: 10px; background: transparent; margin: 0; }
QScrollBar:horizontal { height: 10px; background: transparent; margin: 0; }
QScrollBar::handle { background: #2a4433; border-radius: 0; margin: 2px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #86a893; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; border: none; }
QTabWidget::pane { border: 1px solid #1a2b20; border-radius: 4px; top: -1px; }
QTabBar::tab { background: transparent; border: none; padding: 6px 14px; color: #86a893; }
QTabBar::tab:hover { color: #ddf5e4; }
QTabBar::tab:selected { color: #ddf5e4; border-bottom: 2px solid #3df58a; }
QGroupBox { border: 1px solid #1a2b20; border-radius: 4px; margin-top: 16px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #86a893; font-weight: 600; }
QHeaderView::section { background: #0b140f; color: #86a893; border: none; border-bottom: 1px solid #1a2b20; padding: 5px 8px; font-weight: 600; }
QTableView, QTreeView, QListView { background: #030605; alternate-background-color: #0b140f; gridline-color: #1a2b20; border: 1px solid #1a2b20; border-radius: 4px; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected { background: #103921; color: #ddf5e4; border-left: 3px solid #3df58a; }
QToolTip { background: #141e19; color: #ddf5e4; border: 1px solid #2a4433; border-radius: 2px; padding: 4px 8px; }
QStatusBar { background: #0b140f; color: #86a893; border-top: 1px solid #1a2b20; }
QSplitter::handle { background: #1a2b20; }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid #56705f; background: #030605; border-radius: 0; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #3df58a; border-color: #3df58a; }
