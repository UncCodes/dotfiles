/* fui: Qt, edition phosphor, applied to every Qt6 app through qt6ct. (No double slashes in this file: qt6ct strips them as comments.) */
QWidget { background-color: #050a07; color: #ddf5e4; selection-background-color: #3df58a; selection-color: #000000; }
QMainWindow, QDialog { background-color: #050a07; }
QMenuBar { background: #0b140f; border-bottom: 1px solid #1a2b20; }
