/* GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file. */

/* fui: Qt, edition hazard, applied to every Qt6 app through qt6ct. (No double slashes in this file: qt6ct strips them as comments.) */
QWidget { background-color: #0a0a0a; color: #ededed; selection-background-color: #f2c230; selection-color: #000000; }
QMainWindow, QDialog { background-color: #0a0a0a; }
QMenuBar { background: #141414; border-bottom: 1px solid #2a2a2a; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: #382f12; border-radius: 2px; }
QMenu { background-color: #141414; border: 1px solid #404040; border-top: 2px solid #f2c230; border-radius: 4px; padding: 4px; }
QMenu::item { padding: 5px 18px 5px 12px; border-radius: 2px; }
QMenu::item:selected { background-color: #382f12; color: #ededed; border-left: 3px solid #f2c230; }
QMenu::separator { height: 1px; background: #2a2a2a; margin: 4px 6px; }
QPushButton, QToolButton { background: transparent; border: 1px solid #6b6b6b; border-radius: 2px; padding: 4px 14px; color: #ededed; min-height: 18px; }
QPushButton:hover, QToolButton:hover { background: #1e1e1e; border-color: #f2c230; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked { background: #382f12; border-color: #f2c230; }
QPushButton:default { background: #f2c230; color: #000000; border-color: #f2c230; font-weight: 600; }
QPushButton:disabled, QToolButton:disabled { color: #6b6b6b; border-color: #2a2a2a; }
QPushButton:focus, QToolButton:focus { outline: none; border: 2px solid #f2c230; }
QToolButton[autoRaise="true"] { background: transparent; border-color: transparent; }
QToolButton[autoRaise="true"]:hover { background: #1e1e1e; border-color: #2a2a2a; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
  background-color: #060606; border: 1px solid #6b6b6b; border-radius: 2px; padding: 3px 8px; color: #ededed; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid #f2c230; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: #141414; border: 1px solid #404040; selection-background-color: #382f12; selection-color: #ededed; }
QProgressBar { background: #2a2a2a; border: none; border-radius: 0; text-align: center; color: #ededed; max-height: 6px; }
QProgressBar::chunk { background: #f2c230; border-radius: 0; }
QSlider::groove:horizontal { height: 4px; background: #2a2a2a; border-radius: 0; }
QSlider::sub-page:horizontal { background: #f2c230; border-radius: 0; }
QSlider::handle:horizontal { background: #141414; border: 2px solid #f2c230; width: 12px; margin: -6px 0; border-radius: 0; }
QScrollBar:vertical { width: 10px; background: transparent; margin: 0; }
QScrollBar:horizontal { height: 10px; background: transparent; margin: 0; }
QScrollBar::handle { background: #404040; border-radius: 0; margin: 2px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #9e9e9e; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; border: none; }
QTabWidget::pane { border: 1px solid #2a2a2a; border-radius: 4px; top: -1px; }
QTabBar::tab { background: transparent; border: none; padding: 6px 14px; color: #9e9e9e; }
QTabBar::tab:hover { color: #ededed; }
QTabBar::tab:selected { color: #ededed; border-bottom: 2px solid #f2c230; }
QGroupBox { border: 1px solid #2a2a2a; border-radius: 4px; margin-top: 16px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #9e9e9e; font-weight: 600; }
QHeaderView::section { background: #141414; color: #9e9e9e; border: none; border-bottom: 1px solid #2a2a2a; padding: 5px 8px; font-weight: 600; }
QTableView, QTreeView, QListView { background: #060606; alternate-background-color: #141414; gridline-color: #2a2a2a; border: 1px solid #2a2a2a; border-radius: 4px; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected { background: #382f12; color: #ededed; border-left: 3px solid #f2c230; }
QToolTip { background: #1e1e1e; color: #ededed; border: 1px solid #404040; border-radius: 2px; padding: 4px 8px; }
QStatusBar { background: #141414; color: #9e9e9e; border-top: 1px solid #2a2a2a; }
QSplitter::handle { background: #2a2a2a; }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid #6b6b6b; background: #060606; border-radius: 0; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #f2c230; border-color: #f2c230; }
