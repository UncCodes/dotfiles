/* GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file. */

/* fui: Qt, concrete theme, applied to every Qt6 app through qt6ct. (No double slashes in this file: qt6ct strips them as comments.) */
QWidget { background-color: #d5d9de; color: #10151b; selection-background-color: #c23c0a; selection-color: #ffffff; }
QMainWindow, QDialog { background-color: #d5d9de; }
QMenuBar { background: #e4e7eb; border-bottom: 1px solid #b3bac3; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: #f3d2c2; border-radius: 4px; }
QMenu { background-color: #e4e7eb; border: 1px solid #8e97a2; border-top: 2px solid #c23c0a; border-radius: 6px; padding: 4px; }
QMenu::item { padding: 5px 18px 5px 12px; border-radius: 4px; }
QMenu::item:selected { background-color: #f3d2c2; color: #10151b; border-left: 3px solid #c23c0a; }
QMenu::separator { height: 1px; background: #b3bac3; margin: 4px 6px; }
QPushButton, QToolButton { background: #edeff2; border: 1px solid #8e97a2; border-radius: 4px; padding: 4px 14px; color: #10151b; min-height: 18px; }
QPushButton:hover, QToolButton:hover { border-color: #c23c0a; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked { background: #f3d2c2; border-color: #c23c0a; }
QPushButton:default { background: #c23c0a; color: #ffffff; border-color: #c23c0a; font-weight: 600; }
QPushButton:disabled { color: rgba(16, 21, 27, 45%); }
QToolButton[autoRaise="true"] { background: transparent; border-color: transparent; }
QToolButton[autoRaise="true"]:hover { background: #edeff2; border-color: #b3bac3; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
  background-color: #f4f5f7; border: 1px solid #8e97a2; border-radius: 4px; padding: 3px 8px; color: #10151b; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid #c23c0a; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: #e4e7eb; border: 1px solid #8e97a2; selection-background-color: #c23c0a; selection-color: #ffffff; }
QProgressBar { background: #b3bac3; border: none; border-radius: 2px; text-align: center; color: #10151b; max-height: 6px; }
QProgressBar::chunk { background: #c23c0a; border-radius: 2px; }
QSlider::groove:horizontal { height: 4px; background: #b3bac3; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #c23c0a; border-radius: 2px; }
QSlider::handle:horizontal { background: #e4e7eb; border: 2px solid #c23c0a; width: 12px; margin: -6px 0; border-radius: 3px; }
QScrollBar:vertical { width: 10px; background: transparent; margin: 0; }
QScrollBar:horizontal { height: 10px; background: transparent; margin: 0; }
QScrollBar::handle { background: #8e97a2; border-radius: 2px; margin: 2px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #46515d; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; border: none; }
QTabWidget::pane { border: 1px solid #b3bac3; border-radius: 6px; top: -1px; }
QTabBar::tab { background: transparent; border: none; padding: 6px 14px; color: #46515d; }
QTabBar::tab:hover { color: #10151b; }
QTabBar::tab:selected { color: #10151b; border-bottom: 2px solid #c23c0a; }
QGroupBox { border: 1px solid #b3bac3; border-radius: 6px; margin-top: 16px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #46515d; font-weight: 600; }
QHeaderView::section { background: #e4e7eb; color: #46515d; border: none; border-bottom: 1px solid #b3bac3; padding: 5px 8px; font-weight: 600; }
QTableView, QTreeView, QListView { background: #f4f5f7; alternate-background-color: #e4e7eb; gridline-color: #b3bac3; border: 1px solid #b3bac3; border-radius: 6px; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected { background: #c23c0a; color: #ffffff; }
QToolTip { background: #07090c; color: #d7dee5; border: 1px solid #8e97a2; border-radius: 4px; padding: 4px 8px; }
QStatusBar { background: #e4e7eb; color: #46515d; border-top: 1px solid #b3bac3; }
QSplitter::handle { background: #b3bac3; }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid #8e97a2; background: #f4f5f7; }
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #c23c0a; border-color: #c23c0a; }
