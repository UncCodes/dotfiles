/* fui: Qt, edition amber, applied to every Qt6 app through qt6ct. (No double slashes in this file: qt6ct strips them as comments.) */
QWidget { background-color: #0b0906; color: #f2e8d8; selection-background-color: #ffb000; selection-color: #000000; }
QMainWindow, QDialog { background-color: #0b0906; }
QMenuBar { background: #14110c; border-bottom: 1px solid #2c2418; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: #3c2a05; border-radius: 2px; }
QMenu { background-color: #14110c; border: 1px solid #463a27; border-top: 2px solid #ffb000; border-radius: 4px; padding: 4px; }
QMenu::item { padding: 5px 18px 5px 12px; border-radius: 2px; }
QMenu::item:selected { background-color: #3c2a05; color: #f2e8d8; border-left: 3px solid #ffb000; }
QMenu::separator { height: 1px; background: #2c2418; margin: 4px 6px; }
QPushButton, QToolButton { background: transparent; border: 1px solid #6e6250; border-radius: 2px; padding: 4px 14px; color: #f2e8d8; min-height: 18px; }
QPushButton:hover, QToolButton:hover { background: #1e1b15; border-color: #ffb000; }
