/* GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file. */

/* fui: Qt, edition amber, applied to every Qt6 app through qt6ct. (No double slashes in this file: qt6ct strips them as comments.) */
QWidget { background-color: #0b0906; color: #f2e8d8; selection-background-color: #ffb000; selection-color: #000000; }
QMainWindow, QDialog { background-color: #0b0906; }
QMenuBar { background: #14110c; border-bottom: 1px solid #2c2418; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: #3c2a05; border-radius: 2px; }
QMenu { background-color: #14110c; border: 1px solid #463a27; border-top: 2px solid #ffb000; border-radius: 4px; padding: 4px; }
QMenu::item { padding: 5px 18px 5px 12px; border-radius: 2px; }
QMenu::item:selected { background-color: #3c2a05; color: #f2e8d8; border-left: 3px solid #ffb000; }
QMenu::separator { height: 1px; background: #2c2418; margin: 4px 6px; }
QPushButton, QToolButton { background: transparent; border: 1px solid #6e6250; border-radius: 2px; padding: 4px 14px; color: #f2e8d8; min-height: 18px; }
QPushButton:hover, QToolButton:hover { background: #1e1b15; border-color: #ffb000; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked { background: #3c2a05; border-color: #ffb000; }
QPushButton:default { background: #ffb000; color: #000000; border-color: #ffb000; font-weight: 600; }
QPushButton:disabled, QToolButton:disabled { color: #6e6250; border-color: #2c2418; }
QPushButton:focus, QToolButton:focus { outline: none; border: 2px solid #ffb000; }
QToolButton[autoRaise="true"] { background: transparent; border-color: transparent; }
QToolButton[autoRaise="true"]:hover { background: #1e1b15; border-color: #2c2418; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
  background-color: #070604; border: 1px solid #6e6250; border-radius: 2px; padding: 3px 8px; color: #f2e8d8; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid #ffb000; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: #14110c; border: 1px solid #463a27; selection-background-color: #3c2a05; selection-color: #f2e8d8; }
QProgressBar { background: #2c2418; border: none; border-radius: 0; text-align: center; color: #f2e8d8; max-height: 6px; }
QProgressBar::chunk { background: #ffb000; border-radius: 0; }
QSlider::groove:horizontal { height: 4px; background: #2c2418; border-radius: 0; }
QSlider::sub-page:horizontal { background: #ffb000; border-radius: 0; }
QSlider::handle:horizontal { background: #14110c; border: 2px solid #ffb000; width: 12px; margin: -6px 0; border-radius: 0; }
QScrollBar:vertical { width: 10px; background: transparent; margin: 0; }
QScrollBar:horizontal { height: 10px; background: transparent; margin: 0; }
QScrollBar::handle { background: #463a27; border-radius: 0; margin: 2px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #a8977c; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; border: none; }
QTabWidget::pane { border: 1px solid #2c2418; border-radius: 4px; top: -1px; }
QTabBar::tab { background: transparent; border: none; padding: 6px 14px; color: #a8977c; }
QTabBar::tab:hover { color: #f2e8d8; }
QTabBar::tab:selected { color: #f2e8d8; border-bottom: 2px solid #ffb000; }
QGroupBox { border: 1px solid #2c2418; border-radius: 4px; margin-top: 16px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #a8977c; font-weight: 600; }
QHeaderView::section { background: #14110c; color: #a8977c; border: none; border-bottom: 1px solid #2c2418; padding: 5px 8px; font-weight: 600; }
QTableView, QTreeView, QListView { background: #070604; alternate-background-color: #14110c; gridline-color: #2c2418; border: 1px solid #2c2418; border-radius: 4px; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected { background: #3c2a05; color: #f2e8d8; border-left: 3px solid #ffb000; }
QToolTip { background: #1e1b15; color: #f2e8d8; border: 1px solid #463a27; border-radius: 2px; padding: 4px 8px; }
QStatusBar { background: #14110c; color: #a8977c; border-top: 1px solid #2c2418; }
QSplitter::handle { background: #2c2418; }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid #6e6250; background: #070604; border-radius: 0; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #ffb000; border-color: #ffb000; }
