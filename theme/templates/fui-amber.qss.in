QPushButton:default { background: #ffb000; color: #000000; border-color: #ffb000; font-weight: 600; }
QPushButton:disabled, QToolButton:disabled { color: #6e6250; border-color: #2c2418; }
QPushButton:focus, QToolButton:focus { outline: none; border: 2px solid #ffb000; }
QToolButton[autoRaise="true"] { background: transparent; border-color: transparent; }
QToolButton[autoRaise="true"]:hover { background: #1e1b15; border-color: #2c2418; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
  background-color: #070604; border: 1px solid #6e6250; border-radius: 2px; padding: 3px 8px; color: #f2e8d8; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid #ffb000; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: #14110c; border: 1px solid #463a27; selection-background-color: #3c2a05; selection-color: #f2e8d8; }
QProgressBar { background: #2c2418; border: none; border-radius: 0; text-align: center; color: #f2e8d8; max-height: 6px; }
QProgressBar::chunk { background: #ffb000; border-radius: 0; }
QSlider::groove:horizontal { height: 4px; background: #2c2418; border-radius: 0; }
