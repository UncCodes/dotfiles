QScrollBar:horizontal { height: 10px; background: transparent; margin: 0; }
QScrollBar::handle { background: #463a27; border-radius: 0; margin: 2px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #a8977c; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; border: none; }
QTabWidget::pane { border: 1px solid #2c2418; border-radius: 4px; top: -1px; }
QTabBar::tab { background: transparent; border: none; padding: 6px 14px; color: #a8977c; }
QTabBar::tab:hover { color: #f2e8d8; }
QTabBar::tab:selected { color: #f2e8d8; border-bottom: 2px solid #ffb000; }
QGroupBox { border: 1px solid #2c2418; border-radius: 4px; margin-top: 16px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #a8977c; font-weight: 600; }
QHeaderView::section { background: #14110c; color: #a8977c; border: none; border-bottom: 1px solid #2c2418; padding: 5px 8px; font-weight: 600; }
QTableView, QTreeView, QListView { background: #070604; alternate-background-color: #14110c; gridline-color: #2c2418; border: 1px solid #2c2418; border-radius: 4px; }
