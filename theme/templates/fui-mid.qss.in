/* GENERATED by theme/build.py from theme/tokens.toml. Edit the tokens, not this file. */

/* fui: Qt, mid theme, applied to every Qt6 app through qt6ct. (No double slashes in this file: qt6ct strips them as comments.) */
QWidget { background-color: #fbdbc5; color: #251d18; selection-background-color: #c00c2a; selection-color: #ffffff; }
QMainWindow, QDialog { background-color: #fbdbc5; }
QMenuBar { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #bd4298, stop:0.46 #8c3170, stop:0.54 #792a61, stop:1 #88306d); color: #ffffff; border-bottom: 1px solid #531d43; }
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: rgba(255, 255, 255, 18%); border-radius: 4px; }
QMenu { background-color: #fde7d9; border: 1px solid rgba(110, 60, 60, 45%); border-radius: 10px; padding: 4px; }
QMenu::item { padding: 4px 18px 4px 12px; border-radius: 6px; }
QMenu::item:selected { background-color: #c00c2a; color: #ffffff; }
QMenu::separator { height: 1px; background: rgba(110, 60, 60, 45%); margin: 4px 6px; }
QPushButton, QToolButton { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #fef1e9, stop:0.45 #fef1e9, stop:0.55 #fde8db, stop:1 #fde8db); border: 1px solid rgba(110, 60, 60, 45%); border-radius: 12px; padding: 3px 14px; color: #251d18; min-height: 18px; }
QPushButton:hover, QToolButton:hover { border-color: #c00c2a; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked { background: #fce0ce; }
QPushButton:default { background: #c00c2a; color: #ffffff; border-color: #86081d; }
QPushButton:disabled { color: rgba(37, 29, 24, 45%); }
QToolButton[autoRaise="true"] { background: transparent; border-color: transparent; }
QToolButton[autoRaise="true"]:hover { background: #fce0ce; border-color: rgba(110, 60, 60, 45%); }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
  background-color: #fce0ce; border: 1px solid rgba(110, 60, 60, 45%); border-radius: 11px; padding: 2px 8px; color: #251d18; }
QTextEdit, QPlainTextEdit { border-radius: 6px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #c00c2a; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: #fde7d9; border: 1px solid rgba(110, 60, 60, 45%); selection-background-color: #c00c2a; selection-color: #ffffff; }
QProgressBar { background: #b9c4a6; border: 1px solid rgba(110, 60, 60, 45%); border-radius: 3px; text-align: center; color: #17220f; min-height: 10px; }
QProgressBar::chunk { background: #17220f; border-radius: 2px; margin: 1px; }
QSlider::groove:horizontal { height: 6px; background: #fce0ce; border: 1px solid rgba(110, 60, 60, 45%); border-radius: 3px; }
QSlider::sub-page:horizontal { background: #c00c2a; border-radius: 3px; }
QSlider::handle:horizontal { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #fef1e9, stop:0.45 #fef1e9, stop:0.55 #fde8db, stop:1 #fde8db); border: 1px solid rgba(110, 60, 60, 45%); width: 16px; margin: -6px 0; border-radius: 8px; }
QScrollBar:vertical { width: 14px; background: #fce0ce; margin: 0; }
QScrollBar:horizontal { height: 14px; background: #fce0ce; margin: 0; }
QScrollBar::handle { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #fef1e9, stop:0.45 #fef1e9, stop:0.55 #fde8db, stop:1 #fde8db); border: 1px solid rgba(110, 60, 60, 45%); border-radius: 5px; margin: 2px; min-height: 24px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; border: none; }
QTabWidget::pane { border: 1px solid rgba(110, 60, 60, 45%); border-radius: 6px; top: -1px; }
QTabBar::tab { background: #e7ded0; border: 1px solid rgba(110, 60, 60, 45%); border-bottom: none;
  border-top-left-radius: 4px; border-top-right-radius: 12px; padding: 4px 14px; color: #5c4347; }
QTabBar::tab:selected { background: #ccd3c5; color: #251d18; border-bottom: 2px solid #1f8a80; }
QGroupBox { border: 1px solid rgba(110, 60, 60, 45%); border-radius: 6px; margin-top: 14px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #c00c2a; }
QHeaderView::section { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #fef1e9, stop:0.45 #fef1e9, stop:0.55 #fde8db, stop:1 #fde8db); color: #251d18; border: none; border-right: 1px solid rgba(110, 60, 60, 45%); border-bottom: 1px solid rgba(110, 60, 60, 45%); padding: 4px 6px; }
QTableView, QTreeView, QListView { background: #fce0ce; alternate-background-color: #fce4d4; gridline-color: rgba(110, 60, 60, 45%); border: 1px solid rgba(110, 60, 60, 45%); border-radius: 6px; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected { background: #c00c2a; color: #ffffff; }
QToolTip { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #565c65, stop:0.46 #353a41, stop:0.54 #22262b, stop:1 #2e3238); color: #eef2f6; border: 1px solid #000000; border-radius: 6px; padding: 3px 6px; }
QStatusBar { background: #fde7d9; color: #5c4347; border-top: 1px solid rgba(110, 60, 60, 45%); }
QSplitter::handle { background: rgba(110, 60, 60, 45%); }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid rgba(110, 60, 60, 45%); background: #fce0ce; }
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #c00c2a; border-color: #86081d; }
